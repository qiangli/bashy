#!/usr/bin/env -S bashy --bashsharp
# shapeware/index.bsh: the entry point to this repository's lifted shapeware.
# One body, two faces: read it as a skill, run it as a script. The same file is
# copied verbatim into every repository; it discovers the surfaces itself.

~~~skill as guide
---
name: shapeware-index
description: Find, list and check the lifted shapeware surfaces of this repository. Each folder under shapeware/ is one surface with its own SKILL.md, CONTRACT.md, features.yaml and dag.md. Use when you need to know which parts of this repository have a shapeware spec, open one, or lint them all.
compatibility: Runs with bashy (pure-Go Bash 5.3 + Bash#); without bashy, read shapeware/*/SKILL.md directly.
metadata:
  type: shapeware-index
  shapeware: "0.1"
---
# shapeware index

`shapeware/` holds this repository's lifted surfaces, one folder each
(`shapeware/<surface>/`), made with the kb runbook `shapeware-lift-app`. A
surface's `SKILL.md` is where to start; its `CONTRACT.md` is the behaviour.

    bashy --bashsharp shapeware/index.bsh             # list surfaces
    bashy --bashsharp shapeware/index.bsh --json      # the same as JSON
    bashy --bashsharp shapeware/index.bsh path NAME   # the folder of one surface
    bashy --bashsharp shapeware/index.bsh check       # conform spec check on each
    bashy --bashsharp shapeware/index.bsh coverage    # which apps have a surface
    bashy --bashsharp shapeware/index.bsh run TARGET  # one dag.md target in each surface

A folder without a `SKILL.md` is not a surface and is skipped. `check` exits 1
when any surface fails the lint.

`coverage` reads the optional `shapeware/apps`, the list of what this repository
expects to be lifted, one app per line: `<app> <surfaces> <note...>`, where
`<surfaces>` is a comma-separated list of surface folders, or `-` for an app
that is not lifted by design (say why in the note). `#` starts a comment. It
prints one line per app, `COVERED`, `PARTIAL` (some surfaces missing, or the
note starts with `partial`), `UNCOVERED` or `EXCLUDED`, then the surfaces no
app names as `UNLISTED`. Exit 0 when every app is covered or excluded, 3 when
any is partial or uncovered, 2 with no `shapeware/apps`.

`run TARGET` runs `bashy dag -f dag.md TARGET` in every surface whose `dag.md`
defines that target (for example `test`, `cert`), printing `PASS`, `FAIL` or
`SKIP` per surface; it exits 1 when any surface fails.
~~~

set -euo pipefail

here=$(cd "$(dirname "$0")" && pwd)

usage() {
	echo "usage: index.bsh [list] [--json] | path NAME | check | coverage | run TARGET" >&2
	exit 2
}

# frontmatter_value FILE KEY prints KEY's value from FILE's leading YAML
# frontmatter (single-line values; quotes stripped). Builtins only.
frontmatter_value() {
	local file=$1 key=$2 line n=0 v
	while IFS= read -r line; do
		if [ "$line" = "---" ]; then
			n=$((n + 1))
			[ "$n" -ge 2 ] && return 0
			continue
		fi
		[ "$n" -eq 1 ] || continue
		case "$line" in
		"$key:"*)
			v=${line#"$key:"}
			v=${v# }
			v=${v#\'}; v=${v%\'}
			v=${v#\"}; v=${v%\"}
			printf '%s\n' "$v"
			return 0
			;;
		esac
	done < "$file"
}

surfaces() {
	local d
	for d in "$here"/*/; do
		[ -f "$d/SKILL.md" ] || continue
		d=${d%/}
		printf '%s\n' "${d##*/}"
	done
}

json_str() {
	local s=$1
	s=${s//\\/\\\\}
	s=${s//\"/\\\"}
	printf '"%s"' "$s"
}

cmd_list() {
	local json=$1 name desc first=1
	if [ "$json" = 1 ]; then
		printf '{"schema_version":"shapeware-index-v1","surfaces":['
	fi
	while IFS= read -r name; do
		desc=$(frontmatter_value "$here/$name/SKILL.md" description)
		if [ "$json" = 1 ]; then
			[ "$first" = 1 ] || printf ','
			first=0
			printf '{"name":%s,"path":%s,"description":%s}' \
				"$(json_str "$name")" "$(json_str "shapeware/$name")" "$(json_str "$desc")"
		else
			printf '%s\tshapeware/%s\t%s\n' "$name" "$name" "$desc"
		fi
	done < <(surfaces)
	if [ "$json" = 1 ]; then
		printf ']}\n'
	fi
}

cmd_path() {
	local want=${1:-}
	[ -n "$want" ] || usage
	if [ -f "$here/$want/SKILL.md" ]; then
		printf '%s\n' "$here/$want"
		return 0
	fi
	echo "index.bsh: no surface named '$want' (see: index.bsh list)" >&2
	return 1
}

cmd_check() {
	local name failed=0 count=0
	while IFS= read -r name; do
		count=$((count + 1))
		if bashy conform spec check "$here/$name"; then
			echo "PASS shapeware/$name"
		else
			echo "FAIL shapeware/$name"
			failed=1
		fi
	done < <(surfaces)
	[ "$count" -gt 0 ] || echo "index.bsh: no surfaces under shapeware/ yet"
	return "$failed"
}

cmd_coverage() {
	local file="$here/apps" app surf note s status rc=0 listed=" " missing have
	if [ ! -f "$file" ]; then
		echo "index.bsh: no shapeware/apps (the list of apps this repository expects to lift)" >&2
		return 2
	fi
	while IFS= read -r line || [ -n "$line" ]; do
		line=${line%%#*}
		read -r app surf note <<<"$line" || true
		[ -n "${app:-}" ] || continue
		if [ "$surf" = "-" ] || [ -z "${surf:-}" ]; then
			[ "$surf" = "-" ] && status=EXCLUDED || status=UNCOVERED
		else
			missing=0 have=0
			IFS=, read -r -a parts <<<"$surf"
			for s in "${parts[@]}"; do
				listed="$listed$s "
				if [ -f "$here/$s/SKILL.md" ]; then have=$((have + 1)); else missing=$((missing + 1)); fi
			done
			if [ "$have" -eq 0 ]; then status=UNCOVERED
			elif [ "$missing" -gt 0 ]; then status=PARTIAL
			else
				case "${note:-}" in partial*) status=PARTIAL ;; *) status=COVERED ;; esac
			fi
		fi
		case $status in PARTIAL | UNCOVERED) rc=3 ;; esac
		printf '%s\t%s\t%s\t%s\n' "$status" "$app" "$surf" "${note:-}"
	done < "$file"
	while IFS= read -r s; do
		case "$listed" in *" $s "*) ;; *) printf 'UNLISTED\t-\t%s\t\n' "$s" ;; esac
	done < <(surfaces)
	return "$rc"
}

cmd_run() {
	local target=${1:-} name failed=0
	[ -n "$target" ] || usage
	while IFS= read -r name; do
		if [ ! -f "$here/$name/dag.md" ] || ! grep -q "^### $target\$" "$here/$name/dag.md"; then
			echo "SKIP shapeware/$name (no $target target)"
			continue
		fi
		if (cd "$here/$name" && bashy dag -f dag.md "$target"); then
			echo "PASS shapeware/$name $target"
		else
			echo "FAIL shapeware/$name $target"
			failed=1
		fi
	done < <(surfaces)
	return "$failed"
}

case "${1:-list}" in
list) cmd_list "$([ "${2:-}" = --json ] && echo 1 || echo 0)" ;;
--json) cmd_list 1 ;;
path) cmd_path "${2:-}" ;;
check) cmd_check ;;
coverage) cmd_coverage ;;
run) cmd_run "${2:-}" ;;
-h | --help) usage ;;
*) usage ;;
esac
