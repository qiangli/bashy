#!/usr/bin/env -S bashy --bashsharp
set -euo pipefail
_bashy_self=${BASHY_SELF:-}
unset BASHY_ADAPTER_EXEC BASHY_ADAPTER_INPROC BASHY_ADAPTER_SELF BASHY_SELF
here=${BASH_SOURCE[0]%/*}; [[ $here == "${BASH_SOURCE[0]}" ]] && here=.
gomod="$here/go.mod"; [[ -f "$gomod" ]] || gomod="$here/../go.mod"
ext=; [[ ${OS:-} == Windows_NT || ${OSTYPE:-} == msys* || ${OSTYPE:-} == cygwin* ]] && ext=.exe
bin="${BASHY_ADAPTER_CACHE:-${XDG_CACHE_HOME:-$HOME/.cache}/bashy/adapters}/yoke/dag$ext"
# Multi-file package: any changed source file (not only main.go) rebuilds.
stale=
if [[ ! -x "$bin" || "$gomod" -nt "$bin" ]]; then stale=1; fi
for src in "$here"/*.go; do
  if [[ "$src" -nt "$bin" ]]; then stale=1; fi
done
if [[ -n "$stale" ]]; then
  mkdir -p "${bin%/*}"
  run_go() { if command -v go >/dev/null 2>&1; then go "$@"; else BASHY_HINTS=off BASHY_ADAPTER_INPROC=1 "${_bashy_self:-bashy}" go "$@"; fi; }
  # DAG error envelopes use stderr. Successful bootstrap diagnostics must
  # never precede that JSON; retain them in the adapter cache instead.
  build_log="$bin.build.$$.log"
  if (cd "$here" && GOWORK=off CGO_ENABLED=0 run_go build -buildvcs=false -trimpath -o "$bin.tmp.$$" . && { mv -f "$bin.tmp.$$" "$bin" || { rm -f "$bin.tmp.$$"; [[ -x "$bin" ]]; }; }) 2>"$build_log"; then
    mv -f "$build_log" "$bin.build.log"
  else
    cat "$build_log" >&2
    exit 1
  fi
fi
BASHY_ADAPTER_SELF="$_bashy_self" exec "$bin" "$@"
