#!/usr/bin/env -S bashy --bashpp
# Sprint 203 fixture — the agentic boundary under a contract.
#
# One agentic function carries all three clauses. The expected transcript
# (agentic-boundary.expected) pins: require → body → ensure fire in that
# order; a failed require never runs the body; @guard still denies a write
# inside the body; a failed ensure exits 3 naming the clause; and a yield
# (exit 6, input required) inside the block propagates with NO ensure run.
# Every check is a shell command run in the call's own frame ($1..$n = the
# call's arguments, the script's variables visible, STATUS/RESULT for
# @ensure) — nothing generative.

# A check sees the script's variables (here $work) as the function does; a
# check's own assignments never leak back.
work=$(mktemp -d)
trap 'rm -rf "$work"' EXIT

@guard(effects: "read")
@require('test -n "$1"')
@ensure('test "$1" != lie')
agentic function summarize() {
    echo "body: $1"
    case "$1" in
    write) touch "$work/leak" ;;    # exceeds the read cap → denied, status 1
    yield) return 6 ;;              # input required — a yield, not a result
    fail)  return 1 ;;
    esac                            # "lie": exits 0, the postcondition disagrees
}

@require('test -d "$work" && test -n "$1"')
@ensure('probe=leaked; test -f "$work/$1"')
function produce() {
    : > "$work/$1"
}

@ensure('test "$RESULT" -gt 0')
func twice(n int) int { return n * 2 }

agentic {
    summarize ok;      echo "ok      -> $?"
    summarize "";      echo "empty   -> $?"
    summarize lie;     echo "lie     -> $?"
    summarize write;   echo "write   -> $?"
    summarize fail;    echo "fail    -> $?"
    summarize yield;   echo "yield   -> $?"
}
[ -e "$work/leak" ] && echo "LEAK: guard did not deny the write"

produce made;      echo "produce -> $? $(test -f "$work/made" && echo made) probe=${probe-unset}"
produce "";        echo "produce -> $?"
x := twice(2);     echo "twice 2 -> $? x=$x"
y := twice(0);     echo "twice 0 -> $? y=$y"
echo done
