#!/bin/sh
# Implements only the embedded Codex tool's login probe and the one test wish.
set -eu
case " $* " in
  *" login status "*) echo "Logged in using ChatGPT" >&2 ;;
  *" exec "*"Publish the support greeting"*)
    test -f site.json
    sed -i 's/Original support greeting/Approved support greeting/' site.json
    grep -q 'Approved support greeting' site.json
    echo "edit" >> "$HOME/stub-events"
    echo "Updated the support greeting." ;;
  *) echo "unexpected stub invocation: $*" >&2; exit 2 ;;
esac
