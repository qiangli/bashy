*.sh text eol=lf
# Bash++ sources and pinned transcripts are compared byte-for-byte by
# internal/agentos/contracts_test.go; a CRLF checkout (Windows autocrlf)
# makes every line differ while printing identically.
*.bpp text eol=lf
*.expected text eol=lf
# The hosted transcription gate compares these checkout bytes to the commit.
# Windows autocrlf must not rewrite the authored report or executable sources.
examples/transcribe/*.py text eol=lf
examples/transcribe/*.bsh text eol=lf
examples/transcribe/dependencies/*.json text eol=lf
examples/transcribe/fixtures/*.json text eol=lf
examples/transcribe/fixtures/*.wav binary
examples/transcribe/fixtures/*.webm binary
examples/transcribe/dependencies/notices/sources/*.txt -text
examples/transcribe/dependencies/notices/source-pins.json text eol=lf
skills/bashy/commands/transcribe.md text eol=lf
skills/bashy/commands/transcribe.dhnt text eol=lf
# Unified patches contain context lines prefixed by one space before tabs.
docs/patches/*.diff -whitespace
