#!/usr/bin/env -S bashy --bashsharp
# One body, two orientations: executable Bash# and its embedded agent skill.

~~~skill as guide
---
name: form
description: Define an ad-hoc form in JSON/YAML for a human to fill on a loopback page, then read answers back as JSON keyed by field id. Use when there is more than one question for a human, or answers must survive reload and be polled.
metadata:
  requires: "has=bashy"
  step-porota: 'bashy form add --def form.json'
  check-tests: 'bashy form list'
---
# Ad-hoc forms

This is the prose face of `form.bsh`, the same executable body used by the
registered `form` command. `bashy commands show form` exposes the
executable argv and source path; `bashy skill show form` reads this face.

- `bashy form add --def form.json --title "Intake"` defines a form from a
  JSON or YAML file (see `examples/` for the schema: text, textarea,
  choice, multi, yes-no, file; required; one recommended option per
  choice/multi shown with a mark). Prints the id, loopback URL and status
  plus a one-time owner key — never content.
- `bashy form reply --extract extract.json --values values.json --refusals refusals.json`
  creates web-field rows keyed by stable_id (selector fallback), safe copy
  buttons and fill badges. Refused/failed values are discarded; the human
  marks rows done. Input maps and the frozen extract schema are in README.md.
- `bashy form ask --def questions.json --title "Intake"` creates a
  questionnaire with stable `q1..qn` ids and visible `Q1..Qn` labels.
  `bashy form ask ID --key OWNER --def followup.json` appends only the add
  round as the next question numbers; `show`/`wait` return each question's
  answer and `pending`/`answered` status.
- `bashy form open ID` re-surfaces a form: id, URL, status only.
- The human fills the form on the loopback page (Save keeps a partial
  save, Submit completes it); partial saves survive reload.
- `bashy form show ID --json` reads the definition and the answers back as
  JSON keyed by field id. `bashy form wait ID [--timeout 5m]` blocks until
  the form is answered (or closed, or `--timeout` expires; default `5m`, pass
  e.g. `--timeout 4h` for long reviews). For a form created by this local
  client or store, `wait` resolves the owner's key automatically; use `--key`
  or `FORM_KEY` when waiting from another host.
- `bashy form set ID --answer name=Ada` prefills answers as the owner;
  `list`, `share`, `close` work like every desk tool.
- `bashy form serve` starts the native foreground service (loopback only)
  and prints the participant origin. Ctrl-C stops it; saved forms remain.
  A custom `-data DIR` gets its own loopback port and records `DIR/server.json`,
  and the client refuses when the server at `--addr` serves a different store.
- Fields typed secret — or secret-named like `db_password` — are refused
  before storage; credentials stay with `bashy ask`/vault.
- `FORM_DATA` selects the data directory; default is
  `$BASHY_HOME/desk/form`. `FORM_ADDR` selects the listener; default
  `127.0.0.1:18107` for the default store. `FORM_PREFIX` selects a URL
  sub-path when served behind one; default empty. Never publish an owner key.
- `bashy form publish-outpost [--public] [--icon URL] [--json] [--dry-run]`
  lists the console's `/form/` on the paired outpost, login required unless
  `--public`; `unpublish-outpost` removes it.

No containers, accounts, external database, web assets, or AI service. The
native Go server is a supporting implementation; the orchestration and this
guidance have one source in this file. `--skill` projects the guidance and
`--contract` projects the executable skill contract for ordinary registration.
~~~

set -euo pipefail
export BASHY_HINTS=off
here=$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)
# Shared desk modules resolve from the local Go module proxy (desk/register-modules.sh publishes them).
export GOPROXY="file://${BASHY_GOMOD_PROXY:-${BASHY_HOME:-$HOME/.bashy}/gomod-proxy},${GOPROXY:-https://proxy.golang.org,direct}"
export GONOSUMDB="${GONOSUMDB:+$GONOSUMDB,}github.com/qiangli/bashy/examples"
cache=${XDG_CACHE_HOME:-$HOME/.cache}/bashy/form
exe=$(go env GOEXE)
bin=$cache/form$exe
# The shared publish-outpost / unpublish-outpost verbs.
source "$here/../kit/outpost.bsh"
build() {
  stale=false
  [[ -f "$bin" ]] || stale=true
  for src in "$here"/server/*.go "$here"/go.mod "$here"/go.sum "$here"/server/templates/*; do
    [[ "$src" -nt "$bin" ]] && stale=true
  done
  if [[ $stale == true ]]; then
    if [[ -f "$here/../register-modules.sh" ]]; then
      (BASHY_BIN="${BASHY_BIN:-${BASHY:-bashy}}" . "$here/../register-modules.sh" >&2)
    fi
    mkdir -p "$here/.desk-build" "$cache"
    (cd "$here" && GOWORK=off CGO_ENABLED=0 go build -trimpath -buildvcs=false -o ".desk-build/form$exe" ./server && { mv -f ".desk-build/form$exe" "$bin" || [[ -f "$bin" ]]; })
  fi
}
usage() {
  cat <<'EOF'
Ad-hoc loopback forms: define in JSON/YAML, human fills on the page, agent reads answers as JSON.

Usage:
  form VERB [ID] [flags]

Commands:
  serve               Start loopback form server (default 127.0.0.1:18107; custom -data uses its own port)
  add [FILE|-]        Create a form from --def FILE|- (or positional FILE), --definition, or --poll
  ask [ID|FILE]       Create a Q1..Qn questionnaire, or append a follow-up round to ID (with --key)
  reply               Create a web-form reply checklist from --extract FILE|- [--values FILE] [--refusals FILE]
  open ID             Print id, loopback URL, and status only (never content)
  show ID             Read definition and answers (owner --key/FORM_KEY or joined participant)
  wait ID             Poll until answered, closed, or --timeout expires (default 5m; resolves local owner key)
  set ID              Update title/body/definition or prefill answers (--answer k=v, repeatable)
  answer ID           Submit respondent answers (--answer k=v or --answers FILE|- [--complete])
  list                List forms in the store (id, status, URL)
  share ID            Mint a single-use invite link (or reusable URL when --respondents many)
  join ID [INVITE]    Redeem a single-use --invite CODE
  close ID            Close a form against further responses
  publish-outpost     Publish /form/ on the paired outpost (--public, --icon, --json, --dry-run)
  unpublish-outpost   Remove /form/ from the paired outpost

Flags:
  --def FILE|-            Form definition file in JSON or YAML (- for stdin)
  --definition TEXT       Inline JSON or YAML form definition
  --title TEXT            Form title
  --body TEXT             Agent note (returned by show, hidden by open/list)
  --id ID                 Explicit form id on add/ask/reply
  --key KEY               Owner capability key (or FORM_KEY; wait resolves local owner key automatically)
  --timeout DURATION      wait: give up after this long (default 5m, e.g. 30m, 4h)
  --interval DURATION     wait: poll interval (default 2s)
  --answer KEY=VALUE      Field answer pair (repeatable on set and answer)
  --answers FILE|-        Respondent answers as JSON object (- for stdin)
  --complete              answer: submit complete respondent answer (checks required fields)
  --poll QUESTION         add: one-question multi-respondent poll (requires --options)
  --options A,B,C         add: comma-separated choices for --poll
  --respondents MODE      one (default) or many
  --anonymous             Do not ask participants for a name
  --results-visible       Show live aggregate results to respondents
  --close-at RFC3339      Automatic close timestamp
  --extract FILE|-        reply: browser extract JSON
  --values FILE           reply: proposed values JSON
  --refusals FILE         reply: guard refusals/failures JSON
  --invite CODE           join: single-use invite token
  --participant TOKEN     Respondent session token
  --addr HOST:PORT        Loopback server address (or FORM_ADDR; default 127.0.0.1:18107)
  --data DIR              Form store directory (or FORM_DATA; default $BASHY_HOME/desk/form)
  --prefix /PATH          URL path prefix (or FORM_PREFIX)
  --json                  Print raw versioned JSON response
  --fields F1,F2          Project top-level JSON fields (requires --json)
  --dry-run               Preview action without mutating state
  --explain               Describe the action as versioned JSON
  --no-input              Never prompt for input
  --help=mcp              Print MCP tool metadata JSON
  -h, --help              Show this help
EOF
}
case ${1:-serve} in
--skill)
  copying=false
  while IFS= read -r line; do
    if [[ $line == '~~~skill as guide' ]]; then copying=true; continue; fi
    if [[ $copying == true && $line == '~~~' ]]; then break; fi
    if [[ $copying == true ]]; then printf '%s\n' "$line"; fi
  done < "${BASH_SOURCE[0]}"
  ;;
--contract) echo 'sokilili foromu efefecato reada wurite neto fini sotepo porota porota fini enisure gereeni fini fini' ;;
-h|--help) usage ;;
publish-outpost|unpublish-outpost) kit_outpost "$1" form form "${CONSOLE_PORT:-22749}" false "${@:2}" ;;
stop)
  if pkill -f "$bin serve" 2>/dev/null; then echo "stopped form"; else echo "no form server matched $bin serve"; fi
  ;;
test) cd "$here"; GOWORK=off go test ./... ;;
*)
  build
  if [[ $# -eq 0 ]]; then
    exec "$bin" serve
  fi
  exec "$bin" "$@"
  ;;
esac
