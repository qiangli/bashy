#!/usr/bin/env -S bashy --bashsharp
# One body, two orientations: executable Bash# and its embedded agent skill.

~~~skill as guide
---
name: calendar
description: Self-hosted shared calendar (Desk tool). Explicit IANA timezones, day/week agenda page, Desk owner/invite/member audience (404 for non-members), Git-dir save/load, ICS and Google Calendar import/export.
metadata:
  requires: "has=bashy"
  step-porota: 'bashy calendar --help=mcp'
  check-tests: 'bashy calendar --help=mcp'
---
# Calendar

This is the prose face of `calendar.bsh`, the same executable body used by the
registered `calendar` command. `bashy commands show calendar` exposes the
executable argv and source path; `bashy skill show calendar` reads this face.

Creating, updating, or importing an event **never** executes commands or
launches agents. Wire reminders explicitly via `bashy schedule` when desired.

- `bashy calendar add [ID] --title TITLE --start RFC3339 --end RFC3339 --tz IANA_TZ [--location LOC] [--body MD | -f FILE|-] [--ref REF]... [--audience PERSON]... [--json]` creates an event.
- `bashy calendar list [--from TIME] [--to TIME] [--tz IANA_TZ] [--audience PERSON] [--status pending|closed|cancelled] [--json]` lists the agenda in the viewer's timezone.
- `bashy calendar show ID [--tz IANA_TZ] [--json]` reads full event details including Markdown `body` and `refs`.
- `bashy calendar set ID [--title ...] [--start ...] [--end ...] [--tz ...] [--revoke MEMBER] [--json]` updates an event or revokes a member.
- `bashy calendar cancel ID [--json]` marks an event `cancelled` while keeping the record.
- `bashy calendar close ID [--json]` marks an event `closed` (subsequent edits return 409).
- `bashy calendar open ID` re-surfaces `id`, `URL`, and `status` only — never `body`.
- `bashy calendar share ID` mints a single-use invite; `bashy calendar join ID INVITE` prints the browser join URL. Non-members and revoked members receive HTTP 404.
- `bashy calendar export [ID|--all] --to ics|json|google [-o FILE|-] [--calendar CAL_ID] [--dry-run] [--json]` exports events.
- `bashy calendar import [-f FILE|-] [--from ics|google] [--calendar CAL_ID] [--dry-run] [--json]` imports events idempotently via `source.{provider,uid}`.
- `bashy calendar save [--dir DIR] [--dry-run] [--json]` writes `events.json` + `<id>.ics` per event (default `docs/calendar`); `bashy calendar load [DIR] [--dry-run] [--json]` loads them back without running `git`.
- `bashy calendar serve` starts the standalone loopback server (default `127.0.0.1:18099`). Under the console (`bashy app add calendar --type shaped`), client verbs resolve the console instance via `bashy app show calendar --runtime --json` unless `CALENDAR_ADDR` / `CALENDAR_DATA` are explicitly set.
~~~

set -euo pipefail
export BASHY_HINTS=off
here=$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)
cache=${XDG_CACHE_HOME:-$HOME/.cache}/bashy/desk-calendar
exe=$(go env GOEXE)
bin="$cache/calendar$exe"

build() {
  stale=false
  [[ -f "$bin" ]] || stale=true
  for src in "$here"/*.go "$here"/go.mod "$here"/go.sum "$here"/templates/* "$here"/formats/*; do
    [[ -e "$src" && "$src" -nt "$bin" ]] && stale=true
  done
  if [[ $stale == true ]]; then
    mkdir -p "$here/.desk-build" "$cache"
    (cd "$here" && GOWORK=off CGO_ENABLED=0 go build -trimpath -o ".desk-build/calendar$exe" . && { mv -f ".desk-build/calendar$exe" "$bin" || [[ -f "$bin" ]]; })
  fi
}

case ${1:-serve} in
--skill)
  copying=false
  while IFS= read -r line; do
    if [[ $line == '~~~skill as guide' ]]; then copying=true; continue; fi
    if [[ $copying == true && $line == '~~~' ]]; then break; fi
    if [[ $copying == true ]]; then printf '%s\n' "$line"; fi
  done < "${BASH_SOURCE[0]}"
  ;;
--contract) echo 'sokilili karenidaro efefecato reada wurite neto fini sotepo porota porota fini enisure gereeni fini fini' ;;
-h|--help) echo 'calendar [serve|add|show|set|list|cancel|open|share|join|close|export|import|save|load|test] — loopback shared calendar; --skill prints its embedded skill' ;;
test)
  cd "$here" && GOWORK=off CGO_ENABLED=0 go test -v ./...
  ;;
*)
  build
  export CALENDAR_SOURCE_DIR="${CALENDAR_SOURCE_DIR:-$here}"
  exec "$bin" "$@"
  ;;
esac
