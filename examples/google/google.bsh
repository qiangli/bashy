  "${GWS_ACCOUNT:-}" \
  "${GWS_CREDENTIALS_FILE:-}" \
  "${GWS_SERVICE_ACCOUNT_KEY_FILE:-}" \
  "${GWS_CONFIG_ROOT:-}" \
  "${GWS_BIN:-}" \
  "${PATH:-}" \
  "${GOOGLE_APPLICATION_CREDENTIALS:-}" \
  "${GOOGLE_WORKSPACE_CLI_TOKEN:-}" \
  "${FAKE_GWS_LOG:-}" \
  "${FAKE_GWS_FAIL_LOGIN:-}" \
  "${FAKE_GWS_FAIL_SETUP:-}" \
  "${FAKE_GWS_FAIL_GMAIL_SEND:-}" \
  "$@"




