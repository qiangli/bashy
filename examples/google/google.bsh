import stat
import subprocess
import sys

MAX_UPLOAD_BYTES = 26214400

ADMITTED_SERVICES = (
    "drive",
    "gmail",
    "calendar",
    "tasks",
    "sheets",
    "docs",
    "chat",
    "slides",
    "contacts",
)

ADMITTED_UPLOAD_MIMES = (
    "text/plain",
    "text/markdown",
    "text/csv",
    "application/json",
    "application/pdf",
    "image/png",
    "image/jpeg",
    "application/zip",
    "application/vnd.openxmlformats-officedocument.wordprocessingml.document",
    "application/vnd.openxmlformats-officedocument.spreadsheetml.sheet",
    "application/vnd.openxmlformats-officedocument.presentationml.presentation",
)

EXTENSION_MIME_FALLBACK = {
    ".txt": "text/plain",
    ".md": "text/markdown",
    ".csv": "text/csv",
    ".json": "application/json",
    ".pdf": "application/pdf",
    ".png": "image/png",
    ".jpg": "image/jpeg",
    ".jpeg": "image/jpeg",
    ".zip": "application/zip",
    ".docx": "application/vnd.openxmlformats-officedocument.wordprocessingml.document",
    ".xlsx": "application/vnd.openxmlformats-officedocument.spreadsheetml.sheet",
    ".pptx": "application/vnd.openxmlformats-officedocument.presentationml.presentation",
}

SAFE_TOKEN_KEYS = (
    "pagetoken",
    "nextpagetoken",
    "synctoken",
    "nextsynctoken",
)

SECRET_EXACT_KEYS = (
    "token",
    "access_token",
    "accesstoken",
    "refresh_token",
    "refreshtoken",
    "id_token",
    "idtoken",
    "auth_token",
    "authtoken",
    "client_secret",
    "clientsecret",
    "private_key",
    "privatekey",
    "private_key_id",
    "password",
    "passwd",
    "pwd",
    "secret",
    "api_key",
    "apikey",
    "authorization",
    "bearer",
    "credentials",
    "credential",
    "service_account_key",
)

SECRET_KEY_SUBSTRINGS = (
    "password",
    "passwd",
    "secret",
    "apikey",
    "api_key",
    "private_key",
    "privatekey",
    "credential",
    "bearer",
    "access_token",
    "refresh_token",
    "auth_token",
    "id_token",
)


def fail(code, message, exit_code=2, extra=None):
    payload = {"error": {"code": code, "message": message}}
    if extra:
        payload["error"].update(extra)
    sys.stderr.write(json.dumps(payload) + "\n")
    sys.exit(exit_code)


def emit_json(data):
    sys.stdout.write(json.dumps(data, indent=2) + "\n")


def is_secret_key_name(key):
    low = str(key).strip().lower().replace("-", "_")
    if low in SAFE_TOKEN_KEYS:
        return False
    if low in SECRET_EXACT_KEYS:
        return True
    return any(sub in low for sub in SECRET_KEY_SUBSTRINGS)


def contains_secret_key(value):
    if isinstance(value, dict):
        for k, v in value.items():
            if is_secret_key_name(k) or contains_secret_key(v):
                return True
    elif isinstance(value, list):
        return any(contains_secret_key(item) for item in value)
    return False


def arg_looks_secret(arg):
    if arg.startswith("--"):
        flag_part = arg[2:].split("=", 1)[0].strip()
        if is_secret_key_name(flag_part):
            return True
    for sep in (":=", "="):
        if sep in arg and not arg.startswith("--"):
            key, raw_val = arg.split(sep, 1)
            if is_secret_key_name(key):
                return True
            if sep == ":=":
                try:
                    parsed = json.loads(raw_val)
                except Exception:
                    parsed = None
                if contains_secret_key(parsed):
                    return True
            break
    return False


def parse_shaped_args(raw_args):
    """Parse positional args, key=value / key:=JSON shaped args, and common flags."""
    positionals = []
    shaped = {}
    dry_run = False
    no_login = False
    input_source = None
    raw_params_json = None
    raw_body_json = None

    i = 0
    while i < len(raw_args):
        arg = raw_args[i]
        if arg_looks_secret(arg):
            fail(
                "SECRET_VIA_ARGV",
                "Refusing secret or credential field in command arguments; use GWS_CREDENTIALS_FILE or per-account auth-import.",
                exit_code=2,
            )
        if arg == "--dry-run":
            dry_run = True
            i += 1
            continue
        if arg == "--no-login":
            no_login = True
            i += 1
            continue
        if arg == "--input":
            if i + 1 >= len(raw_args):
                fail("USAGE", "--input requires a file path or '-'")
            input_source = raw_args[i + 1]
            i += 2
            continue
        if arg.startswith("--input="):
            input_source = arg.split("=", 1)[1]
            i += 1
            continue
        if arg == "--params":
            if i + 1 >= len(raw_args):
                fail("USAGE", "--params requires a JSON string")
            raw_params_json = raw_args[i + 1]
            i += 2
            continue
        if arg.startswith("--params="):
            raw_params_json = arg.split("=", 1)[1]
            i += 1
            continue
        if arg == "--json":
            if i + 1 >= len(raw_args):
                fail("USAGE", "--json requires a JSON string")
            raw_body_json = raw_args[i + 1]
            i += 2
            continue
        if arg.startswith("--json="):
            raw_body_json = arg.split("=", 1)[1]
            i += 1
            continue
        if ":=" in arg and not arg.startswith("-"):
            k, v = arg.split(":=", 1)
            try:
                parsed = json.loads(v)
            except Exception as exc:
                fail("INVALID_JSON_ARG", f"Invalid JSON for {k}: {exc}")
            if contains_secret_key(parsed):
                fail(
                    "SECRET_VIA_ARGV",
                    "Refusing nested secret field in JSON argument.",
                    exit_code=2,
                )
            shaped[k] = parsed
            i += 1
            continue
        if "=" in arg and not arg.startswith("-"):
            k, v = arg.split("=", 1)
            shaped[k] = v
            i += 1
            continue
        positionals.append(arg)
        i += 1

    input_payload = None
    if input_source is not None:
        try:
            if input_source == "-":
                raw_text = sys.stdin.read()
            else:
                with open(input_source, "r", encoding="utf-8") as fh:
                    raw_text = fh.read()
            input_payload = json.loads(raw_text) if raw_text.strip() else {}
        except Exception as exc:
            fail("INVALID_INPUT_JSON", f"Failed to read JSON from {input_source}: {exc}")
        if contains_secret_key(input_payload):
            fail("SECRET_IN_INPUT", "Refusing secret key in input payload.")

    return {
        "positionals": positionals,
        "shaped": shaped,
        "dry_run": dry_run,
        "no_login": no_login,
        "input_payload": input_payload,
        "raw_params_json": raw_params_json,
        "raw_body_json": raw_body_json,
    }


def config_root():
    root = os.environ.get("GWS_CONFIG_ROOT", "").strip()
    if root:
        return os.path.expanduser(root)
    return os.path.expanduser("~/.config/bashy/google")


# Default OAuth scopes: least privilege for general users. Drive is
# drive.file (only files and folders bashy itself creates, never the rest of
# the user's Drive); Gmail is read, compose and send (no modify or delete);
# Calendar events and Tasks keep those verbs working. Pass scopes=... to
# change: full scope URLs, short names (drive.file, gmail.readonly), or bare
# service names (gmail,drive,...) for gws's broader service picker.
DEFAULT_SCOPES = (
    "https://www.googleapis.com/auth/drive.file,"
    "https://www.googleapis.com/auth/gmail.readonly,"
    "https://www.googleapis.com/auth/gmail.compose,"
    "https://www.googleapis.com/auth/gmail.send,"
    "https://www.googleapis.com/auth/calendar.events,"
    "https://www.googleapis.com/auth/tasks"
)
LEGACY_SERVICES = "gmail calendar tasks drive sheets docs slides people chat"
FOLDER_MIME = "application/vnd.google-apps.folder"


def scope_login_args(scopes):
    toks = [t.strip() for t in str(scopes).split(",") if t.strip()]
    if toks and all(t in LEGACY_SERVICES.split() for t in toks):
        return ["-s", ",".join(toks)]
    full = [t if "://" in t else "https://www.googleapis.com/auth/" + t for t in toks]
    return ["--scopes", ",".join(full)]


def sanitize_account_dir(account):
    safe = "".join(c if (c.isalnum() or c in ("@", ".", "_", "-", "+")) else "_" for c in account.strip())
    return os.path.join(config_root(), safe)


def missing_granted_scopes(credentials_file, wanted):
    """Scopes in wanted that the stored credential was not granted. Best
    effort: an unreachable token endpoint reports nothing missing."""
    try:
        import urllib.parse
        import urllib.request
        token = oauth_access_token(credentials_file)
        with urllib.request.urlopen("https://oauth2.googleapis.com/tokeninfo?access_token=" + urllib.parse.quote(token), timeout=30) as resp:
            granted = set(json.loads(resp.read()).get("scope", "").split())
    except Exception:
        return []
    return [w for w in wanted if w.startswith("https://") and w not in granted]


def credential_slot_dir(acct_dir, slot):
    if not slot:
        return acct_dir
    safe = "".join(c if (c.isalnum() or c in ("_", "-")) else "_" for c in slot.strip())
    return os.path.join(acct_dir, "slots", safe)


def resolve_account(shaped, required=True):
    acct = shaped.pop("account", None) or os.environ.get("GWS_ACCOUNT", "").strip()
    if required and not acct:
        fail(
            "MISSING_ACCOUNT",
            "GWS_ACCOUNT (or account=<email>) is required; no ambient account fallback is permitted.",
            exit_code=2,
        )
    return acct


def inspect_credentials(account):
    """Inspect credential configuration without mutating state."""
    cred_env = os.environ.get("GWS_CREDENTIALS_FILE", "").strip()
    sa_env = os.environ.get("GWS_SERVICE_ACCOUNT_KEY_FILE", "").strip()

    if cred_env and sa_env:
        return {
            "ready": False,
            "error_code": "AMBIGUOUS_CREDENTIALS",
            "message": "Set either GWS_CREDENTIALS_FILE or GWS_SERVICE_ACCOUNT_KEY_FILE, not both.",
            "account": account,
        }

    chosen_path = None
    source = "none"
    cred_type = "none"

    if cred_env:
        chosen_path = os.path.expanduser(cred_env)
        source = "env:GWS_CREDENTIALS_FILE"
        cred_type = "authorized_user"
    elif sa_env:
        chosen_path = os.path.expanduser(sa_env)
        source = "env:GWS_SERVICE_ACCOUNT_KEY_FILE"
        cred_type = "service_account"
    elif account:
        candidate = os.path.join(sanitize_account_dir(account), "credentials.json")
        if os.path.exists(candidate):
            chosen_path = candidate
            source = "per_account_store"
            cred_type = "authorized_user"

    if not chosen_path:
        acct_hint = account or "you@example.com"
        message = "No credentials file configured for account. Set GWS_CREDENTIALS_FILE, GWS_SERVICE_ACCOUNT_KEY_FILE, or run auth-import / auth-setup."
        if account and os.environ.get("BASHY_HOSTED") == "1":
            message = f"Set vault secret {google_vault_path(account)}."
        return {
            "ready": False,
            "error_code": "MISSING_CREDENTIALS",
            "message": message,
            "account": account,
            "source": "none",
            "remediation": f"bashy google auth-guide account={acct_hint}",
        }

    if not os.path.exists(chosen_path) or not os.path.isfile(chosen_path):
        return {
            "ready": False,
            "error_code": "INVALID_CREDENTIALS_FILE",
            "message": f"Credentials file does not exist or is not a regular file: {chosen_path}",
            "account": account,
            "source": source,
            "credentials_file": chosen_path,
        }

    st = os.stat(chosen_path)
    mode_bits = stat.S_IMODE(st.st_mode)
    mode_ok = (mode_bits & 0o077) == 0

    try:
        with open(chosen_path, "r", encoding="utf-8") as fh:
            data = json.load(fh)
        if isinstance(data, dict) and data.get("type") in ("authorized_user", "service_account"):
            cred_type = data["type"]
    except Exception:
        pass

    return {
        "ready": True,
        "account": account,
        "source": source,
        "credential_type": cred_type,
        "credentials_file": chosen_path,
        "permissions": oct(mode_bits),
        "mode_ok": mode_ok,
    }


def require_credentials(shaped):
    account = resolve_account(shaped, required=True)
    info = inspect_credentials(account)
    if not info.get("ready"):
        fail(info.get("error_code", "MISSING_CREDENTIALS"), info.get("message", "Credentials unavailable"), exit_code=2)
    return info


def find_gws_bin():
    override = os.environ.get("GWS_BIN", "").strip()
    if override:
        if os.path.isfile(override) and os.access(override, os.X_OK):
            return [override]
        fail("GWS_NOT_FOUND", f"GWS_BIN is not an executable file: {override}", exit_code=127)
    found = shutil.which("gws")
    if found:
        return [found]
    # bashy downloads gws into its cache on first `bashy gws`; use that copy.
    home = os.path.expanduser("~")
    roots = [os.environ.get("XDG_CACHE_HOME", ""), os.path.join(home, "Library", "Caches"), os.path.join(home, ".cache")]
    cached = []
    for root in roots:
        if root:
            cached.extend(glob.glob(os.path.join(root, "bashy", "bin", "gws", "v*", "gws")))
    cached = [c for c in cached if os.access(c, os.X_OK)]
    if cached:
        def version_key(path):
            ver = os.path.basename(os.path.dirname(path)).lstrip("v")
            return [int(x) if x.isdigit() else 0 for x in ver.split(".")]
        return [max(cached, key=version_key)]
    fail(
        "GWS_NOT_FOUND",
        "gws (Google Workspace CLI) was not found on PATH or in the bashy cache. Run `bashy gws --version` once, install gws, or set GWS_BIN.",
        exit_code=127,
    )


def build_gws_env(cred_info):
    env = dict(os.environ)
    # Scrub ambient credential variables so gws never silently uses an unintended account
    for ambient in ("GOOGLE_APPLICATION_CREDENTIALS", "GOOGLE_WORKSPACE_CLI_TOKEN"):
        env.pop(ambient, None)
    env["GWS_ACCOUNT"] = cred_info["account"]
    env["GOOGLE_WORKSPACE_CLI_CREDENTIALS_FILE"] = cred_info["credentials_file"]
    acct_dir = sanitize_account_dir(cred_info["account"])
    env["GOOGLE_WORKSPACE_CLI_CONFIG_DIR"] = acct_dir
    return env


def run_gws(cred_info, argv, capture=False, cwd=None):
    gws_bin = find_gws_bin()
    cmd = gws_bin + argv
    if "--format=json" not in cmd and not any(a.startswith("--format") for a in cmd):
        cmd.append("--format=json")
    env = build_gws_env(cred_info)
    proc = subprocess.run(cmd, env=env, capture_output=True, text=True, cwd=cwd)
    if capture:
        return proc
    if proc.stdout:
        sys.stdout.write(proc.stdout)
        if not proc.stdout.endswith("\n"):
            sys.stdout.write("\n")
    if proc.stderr:
        sys.stderr.write(proc.stderr)
        if not proc.stderr.endswith("\n"):
            sys.stderr.write("\n")
    if proc.returncode != 0 and "has not been used in project" in (proc.stdout or "") + (proc.stderr or ""):
        sys.stderr.write(json.dumps({"hint": "This Google API is not enabled in your Cloud project. Enable the APIs bashy uses once: "
                                             f"bashy google auth-enable-apis account={cred_info['account']}"}) + "\n")
    sys.exit(proc.returncode)


def handle_contract():
    contract = {
        "schema": "bashy-command-contract-v1",
        "name": "google",
        "summary": "Google Workspace CLI wrapper (Gmail, Calendar, Tasks, Drive, and BYOP onboarding)",
        "underlying_cli": "gws",
        "auth": {
            "required_env": ["GWS_ACCOUNT"],
            "credential_sources": [
                "GWS_CREDENTIALS_FILE",
                "GWS_SERVICE_ACCOUNT_KEY_FILE",
                "${GWS_CONFIG_ROOT:-~/.config/bashy/google}/<account>/credentials.json",
            ],
            "ambient_fallback": False,
            "secret_via_argv": "refused",
        },
        "verbs": {
            "onboarding": ["auth-guide", "auth-setup", "auth-import", "auth-login", "auth-enable-apis", "auth-status", "auth-export"],
            "gmail": ["gmail-list", "gmail-get", "gmail-send", "gmail-draft"],
            "calendar": [
                "calendar-list",
                "calendar-get",
                "calendar-create",
                "calendar-update",
                "calendar-delete",
                "calendar-freebusy",
            ],
            "tasks": [
                "tasklists-list",
                "tasks-list",
                "tasks-get",
                "tasks-create",
                "tasks-complete",
                "tasks-update",
                "tasks-delete",
            ],
            "drive": ["drive-list", "drive-search", "drive-get", "drive-upload", "drive-mkdir", "drive-home"],
            "youtube": ["youtube-upload"],
            "workflows": ["mail-to-task", "drive-share-mail", "agenda"],
            "escape_hatch": ["raw"],
        },
        "limits": {
            "max_upload_bytes": MAX_UPLOAD_BYTES,
            "admitted_upload_mimes": sorted(ADMITTED_UPLOAD_MIMES),
        },
    }
    emit_json(contract)
    sys.exit(0)


def handle_auth_guide(parsed):
    shaped = parsed["shaped"]
    account = resolve_account(shaped, required=False) or "you@example.com"
    project = shaped.get("project", "bashy-gws-personal")
    scopes = shaped.get("scopes", DEFAULT_SCOPES)
    acct_dir = sanitize_account_dir(account)

    guide_data = {
        "ok": True,
        "mode": "byop-onboarding-guide",
        "account": account,
        "project": project,
        "cost": "$0 (Google Workspace APIs are free; no billing account required)",
        "why_byop": (
            "Gmail and Drive use Google Restricted Scopes, which cap unverified shared OAuth projects "
            "at 100 users and share project-level quotas. Using your own Google Cloud project gives "
            "dedicated quotas, zero CASA audit fees, and full tenant isolation."
        ),
        "required_apis": [
            "gmail.googleapis.com",
            "calendar-json.googleapis.com",
            "tasks.googleapis.com",
            "drive.googleapis.com",
        ],
        "console_links": {
            "1_create_project": "https://console.cloud.google.com/projectcreate",
            "2_enable_apis": (
                f"https://console.cloud.google.com/flows/enableapi?"
                f"apiid=gmail.googleapis.com,calendar-json.googleapis.com,tasks.googleapis.com,drive.googleapis.com"
                f"&project={project}"
            ),
            "3_oauth_consent_screen": f"https://console.cloud.google.com/apis/credentials/consent?project={project}",
            "4_create_desktop_oauth_client": f"https://console.cloud.google.com/apis/credentials/oauthclient?project={project}",
        },
        "token_longevity_tip": (
            "For personal @gmail.com accounts (External consent screen): add your email under Test Users, "
            "or click 'Publish App' (no paid verification needed for personal use) so refresh tokens do not expire after 7 days. "
            "For Google Workspace orgs: select 'Internal' user type."
        ),
        "workflows": {
            "automated_with_gcloud": f"bashy google auth-setup account={account} project={project} scopes={scopes}",
            "browser_only_import": f"bashy google auth-import ~/Downloads/client_secret.json account={account} scopes={scopes}",
            "verify_status": f"bashy google auth-status account={account}",
        },
        "target_account_dir": acct_dir,
    }
    emit_json(guide_data)
    sys.exit(0)


def handle_auth_status(parsed):
    shaped = parsed["shaped"]
    account = resolve_account(shaped, required=False)
    info = inspect_credentials(account)
    emit_json(info)
    sys.exit(0 if info.get("ready") else 1)


def google_vault_path(account):
    if not isinstance(account, str) or account in (".", "..") or not re.fullmatch(r"[A-Za-z0-9_.@+-]+", account):
        fail("INVALID_ACCOUNT", "Use a Google account with letters, digits, or one of ._@+-")
    return f"google/{account}/credentials"


def handle_vault_status(parsed, list_names):
    if parsed["positionals"] != ["--vault"]:
        fail("USAGE", "Use auth-status --vault [account=<email>].")
    account = resolve_account(parsed["shaped"], required=False)
    path = google_vault_path(account) if account else None
    try:
        names = list_names().splitlines()
    except BashCallbackError:
        fail("VAULT_UNAVAILABLE", "Could not list vault credentials. Check the vault connection and token scope.")
    accounts = sorted({
        match.group(1) for name in names
        if (match := re.fullmatch(r"google/([A-Za-z0-9_.@+-]+)/credentials", name))
        and match.group(1) not in (".", "..")
    })
    ready = account in accounts if account else bool(accounts)
    info = {"ready": ready, "account": account, "accounts": accounts, "source": "vault"}
    if path and not ready:
        info.update(error_code="MISSING_CREDENTIALS", message=f"Set vault secret {path}.")
    emit_json(info)
    sys.exit(0 if ready else 1)


def handle_auth_export(parsed, set_file):
    shaped = parsed["shaped"]
    if parsed["positionals"] != ["--to-vault"] or shaped.keys() - {"account"}:
        fail("USAGE", "Use auth-export --to-vault [account=<email>].")
    account = resolve_account(shaped)
    path = google_vault_path(account)
    info = inspect_credentials(account)
    if not info.get("ready"):
        fail(info["error_code"], info["message"])
    if not parsed["dry_run"] and set_file(path, info["credentials_file"]) != 0:
        fail("VAULT_UNAVAILABLE", f"Could not set vault secret {path}. Check the vault connection, token scope, and local file permissions.")
    emit_json({"ok": True, "verb": "auth-export", "account": account, "vault_path": path, "dry_run": parsed["dry_run"]})
    sys.exit(0)


def vault_main(list_names: Callable[[], str], set_file: Callable[[str, str], int],
               account: str, cred: str, sa: str, root: str, home: str, raw_args: str) -> int:
    apply_caller_env({
        "GWS_ACCOUNT": account, "GWS_CREDENTIALS_FILE": cred,
        "GWS_SERVICE_ACCOUNT_KEY_FILE": sa, "GWS_CONFIG_ROOT": root, "HOME": home,
    })
    try:
        verb, *args = json.loads(raw_args)
        parsed = parse_shaped_args(args)
        if verb == "auth-export":
            handle_auth_export(parsed, set_file)
        handle_vault_status(parsed, list_names)
    except SystemExit as exc:
        return exc.code


def handle_auth_import(parsed):
    positionals = parsed["positionals"]
    shaped = parsed["shaped"]
    if not positionals:
        fail("USAGE", "auth-import requires <path-to-client_secret-or-credentials.json>")
    src_path = os.path.expanduser(positionals[0])
    account = resolve_account(shaped, required=True)
    scopes = shaped.get("scopes", DEFAULT_SCOPES)

    if not os.path.exists(src_path) or not os.path.isfile(src_path):
        fail("FILE_NOT_FOUND", f"Credential file not found: {src_path}")

    try:
        with open(src_path, "r", encoding="utf-8") as fh:
            raw_json = json.load(fh)
    except Exception as exc:
        fail("INVALID_CREDENTIAL_JSON", f"Failed to parse JSON file: {exc}")

    if not isinstance(raw_json, dict):
        fail("INVALID_CREDENTIAL_JSON", "Credential JSON must be an object.")

    is_direct_cred = raw_json.get("type") in ("authorized_user", "service_account")
    is_oauth_client = any(
        isinstance(raw_json.get(k), dict)
        and raw_json[k].get("client_id")
        and raw_json[k].get("client_secret")
        for k in ("installed", "web")
    )

    if not is_direct_cred and not is_oauth_client:
        fail(
            "INVALID_CREDENTIAL_JSON",
            "JSON must be a Google OAuth Desktop client_secret.json ('installed'/'web') or an exported 'authorized_user'/'service_account' credential.",
        )

    acct_dir = sanitize_account_dir(account)
    target_client_secret = os.path.join(acct_dir, "client_secret.json")
    target_creds = os.path.join(acct_dir, "credentials.json")

    if parsed["dry_run"]:
        emit_json({
            "ok": True,
            "dry_run": True,
            "verb": "auth-import",
            "account": account,
            "detected_format": raw_json.get("type") if is_direct_cred else "oauth_client_secret",
            "target_account_dir": acct_dir,
            "target_credentials_file": target_creds,
            "will_run_login": (not is_direct_cred) and (not parsed["no_login"]),
        })
        sys.exit(0)

    os.makedirs(acct_dir, mode=0o700, exist_ok=True)
    os.chmod(acct_dir, 0o700)

    if is_direct_cred:
        shutil.copyfile(src_path, target_creds)
        os.chmod(target_creds, 0o600)
        emit_json({
            "ok": True,
            "verb": "auth-import",
            "account": account,
            "credential_type": raw_json.get("type"),
            "credentials_file": target_creds,
            "permissions": "0600",
            "env_exports": {
                "GWS_ACCOUNT": account,
                "GWS_CREDENTIALS_FILE": target_creds,
            },
        })
        sys.exit(0)

    shutil.copyfile(src_path, target_client_secret)
    os.chmod(target_client_secret, 0o600)

    if parsed["no_login"]:
        emit_json({
            "ok": True,
            "verb": "auth-import",
            "account": account,
            "status": "client_secret_staged",
            "client_secret_file": target_client_secret,
            "permissions": "0600",
            "next_step": f"GOOGLE_WORKSPACE_CLI_CONFIG_DIR={acct_dir} bashy gws auth login {' '.join(scope_login_args(scopes))}",
        })
        sys.exit(0)

    gws_bin = find_gws_bin()
    env = dict(os.environ)
    env["GOOGLE_WORKSPACE_CLI_CONFIG_DIR"] = acct_dir
    apis = enable_apis(client_project(acct_dir, shaped.get("project"))) if not slot else {"status": "skipped", "reason": "slot login; enable its API separately"}
    login_rc = run_gws_login(gws_bin + ["auth", "login"] + scope_login_args(scopes), env)
    if login_rc != 0:
        fail(
            "AUTH_LOGIN_FAILED",
            f"gws auth login failed (exit {login_rc})",
            exit_code=login_rc,
        )

    export_proc = subprocess.run(
        gws_bin + ["auth", "export", "--unmasked"],
        env=env,
        capture_output=True,
        text=True,
    )
    if export_proc.returncode != 0 or not export_proc.stdout.strip():
        fail(
            "AUTH_EXPORT_FAILED",
            "gws auth export failed to produce credentials JSON.",
            exit_code=export_proc.returncode or 1,
        )

    with open(target_creds, "w", encoding="utf-8") as fh:
        fh.write(export_proc.stdout)
    os.chmod(target_creds, 0o600)

    emit_json({
        "ok": True,
        "verb": "auth-import",
        "account": account,
        "credential_type": "authorized_user",
        "client_secret_file": target_client_secret,
        "credentials_file": target_creds,
        "permissions": "0600",
        "apis": apis,
        "env_exports": {
            "GWS_ACCOUNT": account,
            "GWS_CREDENTIALS_FILE": target_creds,
        },
    })
    sys.exit(0)


def handle_auth_setup(parsed):
    shaped = parsed["shaped"]
    account = resolve_account(shaped, required=True)
    project = shaped.get("project", "")
    scopes = shaped.get("scopes", DEFAULT_SCOPES)
    acct_dir = sanitize_account_dir(account)
    target_creds = os.path.join(acct_dir, "credentials.json")

    setup_cmd = ["auth", "setup"]
    if project:
        setup_cmd.extend(["--project", str(project)])
    login_cmd = ["auth", "login"] + scope_login_args(scopes)

    if parsed["dry_run"]:
        emit_json({
            "ok": True,
            "dry_run": True,
            "verb": "auth-setup",
            "account": account,
            "project": project or "(interactive/default)",
            "scopes": scopes,
            "planned_commands": [
                ["gws"] + setup_cmd,
                enable_apis_command(project),
                ["gws"] + login_cmd,
                ["gws", "auth", "export", "--unmasked"],
            ],
            "target_credentials_file": target_creds,
        })
        sys.exit(0)

    os.makedirs(acct_dir, mode=0o700, exist_ok=True)
    os.chmod(acct_dir, 0o700)
    gws_bin = find_gws_bin()
    env = dict(os.environ)
    env["GOOGLE_WORKSPACE_CLI_CONFIG_DIR"] = acct_dir

    proc = subprocess.run(gws_bin + setup_cmd, env=env, capture_output=True, text=True)
    if proc.returncode != 0:
        fail(
            "AUTH_SETUP_FAILED",
            f"gws auth setup failed (exit {proc.returncode})",
            exit_code=proc.returncode,
            extra={"stderr": proc.stderr.strip()},
        )
    apis = enable_apis(client_project(acct_dir, project))
    login_rc = run_gws_login(gws_bin + login_cmd, env)
    if login_rc != 0:
        fail(
            "AUTH_LOGIN_FAILED",
            f"gws auth login failed (exit {login_rc})",
            exit_code=login_rc,
        )

    export_proc = subprocess.run(
        gws_bin + ["auth", "export", "--unmasked"],
        env=env,
        capture_output=True,
        text=True,
    )
    if export_proc.returncode != 0 or not export_proc.stdout.strip():
        fail(
            "AUTH_EXPORT_FAILED",
            "gws auth export failed after setup.",
            exit_code=export_proc.returncode or 1,
        )

    with open(target_creds, "w", encoding="utf-8") as fh:
        fh.write(export_proc.stdout)
    os.chmod(target_creds, 0o600)

    emit_json({
        "ok": True,
        "verb": "auth-setup",
        "account": account,
        "project": project,
        "credentials_file": target_creds,
        "permissions": "0600",
        "apis": apis,
        "env_exports": {
            "GWS_ACCOUNT": account,
            "GWS_CREDENTIALS_FILE": target_creds,
        },
    })
    sys.exit(0)


def build_rfc2822_raw(to_addr, subject, body, cc=None, bcc=None, in_reply_to=None, references=None):
    msg = EmailMessage()
    msg["To"] = to_addr
    msg["Subject"] = subject
    if cc:
        msg["Cc"] = cc
    if bcc:
        msg["Bcc"] = bcc
    if in_reply_to:
        msg["In-Reply-To"] = in_reply_to
    if references:
        msg["References"] = references
    msg.set_content(body or "")
    raw_bytes = msg.as_bytes()
    return base64.urlsafe_b64encode(raw_bytes).decode("ascii").rstrip("=")


def normalize_event_time(val):
    if isinstance(val, dict):
        return val
    s = str(val).strip()
    if "T" in s:
        return {"dateTime": s}
    return {"date": s}


def normalize_attendees(val):
    if isinstance(val, list):
        out = []
        for item in val:
            if isinstance(item, dict):
                out.append(item)
            else:
                out.append({"email": str(item)})
        return out
    if isinstance(val, str):
        return [{"email": e.strip()} for e in val.split(",") if e.strip()]
    return []


DESTRUCTIVE_METHODS = "delete clear trash emptyTrash"
# The APIs the default verbs call; each must be enabled once in the user's
# own Google Cloud project or calls fail with 403 "API has not been used".
REQUIRED_APIS = "drive.googleapis.com gmail.googleapis.com calendar-json.googleapis.com tasks.googleapis.com"


def find_gcloud():
    override = os.environ.get("GWS_GCLOUD_BIN")
    if override is not None:
        override = override.strip()
        if not override or override == "none":
            return None
        return override if os.access(override, os.X_OK) else None
    return shutil.which("gcloud")


def client_project(acct_dir, explicit=None):
    """The Cloud project: project=..., else the one in client_secret.json."""
    if explicit:
        return str(explicit)
    try:
        with open(os.path.join(acct_dir, "client_secret.json"), "r", encoding="utf-8") as fh:
            data = json.load(fh)
        for section in ("installed", "web"):
            if isinstance(data.get(section), dict) and data[section].get("project_id"):
                return data[section]["project_id"]
    except Exception:
        pass
    return ""


def enable_apis_command(project):
    return ["gcloud", "services", "enable"] + REQUIRED_APIS.split() + ["--project", project or "PROJECT_ID"]


def enable_apis(project):
    """Enable REQUIRED_APIS with gcloud. Never fatal: the result says what to
    run by hand when gcloud or the project is missing."""
    cmd = enable_apis_command(project)
    if not project:
        return {"status": "skipped", "reason": "project unknown; pass project=ID", "command": " ".join(cmd)}
    gcloud = find_gcloud()
    if not gcloud:
        return {"status": "skipped", "reason": "gcloud not found; run the command or enable the APIs in the Cloud Console",
                "command": " ".join(cmd)}
    env = dict(os.environ)
    env.setdefault("HOME", os.path.expanduser("~"))
    proc = subprocess.run([gcloud] + cmd[1:], env=env, capture_output=True, text=True)
    if proc.returncode != 0:
        return {"status": "failed", "command": " ".join(cmd), "stderr": (proc.stderr or "").strip()[-500:]}
    return {"status": "enabled", "project": project, "apis": REQUIRED_APIS.split()}


def handle_auth_enable_apis(parsed):
    shaped = parsed["shaped"]
    account = resolve_account(shaped, required=True)
    project = client_project(sanitize_account_dir(account), shaped.get("project"))
    if parsed["dry_run"]:
        emit_json({"ok": True, "dry_run": True, "verb": "auth-enable-apis", "account": account,
                   "planned_commands": [enable_apis_command(project)]})
        sys.exit(0)
    result = enable_apis(project)
    emit_json({"ok": result["status"] == "enabled", "verb": "auth-enable-apis", "account": account, "apis": result})
    sys.exit(0 if result["status"] == "enabled" else 1)


def require_confirm(verb, shaped, dry_run, what):
    """Deletes cannot be undone and the Calendar and Tasks scopes cannot be
    narrowed to exclude them, so the wrapper requires an explicit confirm=yes
    (not needed for --dry-run)."""
    confirm = str(shaped.pop("confirm", "")).lower()
    if dry_run or confirm == "yes":
        return
    fail("CONFIRM_REQUIRED", f"{verb} would delete {what}; this cannot be undone. Add confirm=yes to proceed.",
         extra={"verb": verb})


def run_gws_login(cmd, env):
    """Run `gws auth login`, which waits for the user's consent in a browser.
    Bash# captures this program's stderr until it exits, so the consent link
    would never be seen: open it in the browser (unless GWS_NO_BROWSER is set)
    and print it on the terminal."""
    proc = subprocess.Popen(cmd, env=env, stdout=subprocess.PIPE, stderr=subprocess.STDOUT, text=True)
    announced = False
    for line in proc.stdout:
        sys.stderr.write(line)
        if announced or "https://accounts.google.com/" not in line:
            continue
        url = line[line.index("https://accounts.google.com/"):].split()[0]
        announced = True
        try:
            with open("/dev/tty", "w") as tty:
                tty.write(f"Approve access in your browser:\n{url}\n")
        except OSError:
            pass
        if not os.environ.get("GWS_NO_BROWSER"):
            opener = shutil.which("open") or shutil.which("xdg-open")
            if opener:
                subprocess.run([opener, url], stdout=subprocess.DEVNULL, stderr=subprocess.DEVNULL)
    return proc.wait()


def handle_auth_login(parsed):
    """Re-consent an existing account (its client_secret.json is already in
    place) with the given scopes, then refresh credentials.json, which every
    other verb reads. Use it to narrow or widen permissions."""
    shaped = parsed["shaped"]
    account = resolve_account(shaped, required=True)
    scopes = shaped.get("scopes", DEFAULT_SCOPES)
    main_dir = sanitize_account_dir(account)
    # slot=NAME keeps a separate credential for scopes Google will not grant
    # together with the main set (YouTube with Drive), same OAuth client.
    slot = shaped.get("slot", "")
    acct_dir = credential_slot_dir(main_dir, slot)
    if slot:
        os.makedirs(acct_dir, mode=0o700, exist_ok=True)
        src = os.path.join(main_dir, "client_secret.json")
        dst = os.path.join(acct_dir, "client_secret.json")
        if os.path.isfile(src) and not os.path.isfile(dst):
            shutil.copyfile(src, dst)
            os.chmod(dst, 0o600)
    target_creds = os.path.join(acct_dir, "credentials.json")
    login_cmd = ["auth", "login"] + scope_login_args(scopes)
    if parsed["dry_run"]:
        emit_json({
            "ok": True,
            "dry_run": True,
            "verb": "auth-login",
            "account": account,
            "scopes": scopes,
            "planned_commands": [["gws"] + login_cmd, ["gws", "auth", "export", "--unmasked"]],
            "target_credentials_file": target_creds,
            "slot": slot,
        })
        sys.exit(0)
    if not os.path.isfile(os.path.join(acct_dir, "client_secret.json")):
        fail("MISSING_CLIENT_SECRET", "No client_secret.json for this account; run auth-setup or auth-import first.")
    gws_bin = find_gws_bin()
    env = dict(os.environ)
    env["GOOGLE_WORKSPACE_CLI_CONFIG_DIR"] = acct_dir
    apis = enable_apis(client_project(acct_dir, shaped.get("project")))
    login_rc = run_gws_login(gws_bin + login_cmd, env)
    if login_rc != 0:
        fail(
            "AUTH_LOGIN_FAILED",
            f"gws auth login failed (exit {login_rc})",
            exit_code=login_rc,
        )
    export_proc = subprocess.run(gws_bin + ["auth", "export", "--unmasked"], env=env, capture_output=True, text=True)
    if export_proc.returncode != 0 or not export_proc.stdout.strip():
        fail("AUTH_EXPORT_FAILED", "gws auth export failed after login.", exit_code=export_proc.returncode or 1)
    with open(target_creds, "w", encoding="utf-8") as fh:
        fh.write(export_proc.stdout)
    os.chmod(target_creds, 0o600)
    stale = os.path.join(acct_dir, "token_cache.json")
    if os.path.exists(stale):
        os.replace(stale, stale + ".stale")
    # Google's granular consent lets the user continue without ticking a
    # sensitive scope; the login then "succeeds" without it. Say so loudly.
    missing = missing_granted_scopes(target_creds, scope_login_args(scopes)[1].split(","))
    if missing:
        fail("SCOPE_NOT_GRANTED",
             "Google did not grant: " + ", ".join(missing) + ". On the consent page tick the checkbox for each permission (granular consent), then run auth-login again.",
             extra={"missing": missing, "retry": f"bashy google auth-login account={account}" + (f" slot={slot}" if slot else "") + f" scopes={scopes}"})
    emit_json({
        "ok": True,
        "verb": "auth-login",
        "account": account,
        "scopes": scopes,
        "credentials_file": target_creds,
        "permissions": "0600",
        "apis": apis,
    })
    sys.exit(0)


def drive_home_name():
    name = os.environ.get("GWS_DRIVE_HOME", "bashy").strip()
    return "" if name.lower() == "none" else name


def drive_home_file(account):
    return os.path.join(sanitize_account_dir(account), "drive_home.json")


def read_drive_home(account):
    try:
        with open(drive_home_file(account), "r", encoding="utf-8") as fh:
            data = json.load(fh)
        return data if data.get("id") else None
    except Exception:
        return None


def write_drive_home(account, name, folder_id):
    path = drive_home_file(account)
    os.makedirs(os.path.dirname(path), mode=0o700, exist_ok=True)
    with open(path, "w", encoding="utf-8") as fh:
        json.dump({"name": name, "id": folder_id}, fh)
    os.chmod(path, 0o600)


def ensure_drive_home(cred_info):
    """The default Drive folder for uploads and new folders (GWS_DRIVE_HOME,
    default "bashy"; "none" means My Drive root). With the drive.file scope bashy
    can only write to folders it created, so it creates this folder once and
    remembers its id; the user may move or rename it afterwards. parent=ID
    always overrides it."""
    account = cred_info["account"]
    home = read_drive_home(account)
    if home:
        return home["id"]
    name = drive_home_name()
    proc = run_gws(cred_info, ["drive", "files", "create", "--json", json.dumps({"name": name, "mimeType": FOLDER_MIME})], capture=True)
    folder_id = None
    if proc.returncode == 0:
        try:
            out = proc.stdout or ""
            folder_id = json.loads(out[out.find("{"):]).get("id")
        except Exception:
            folder_id = None
    if not folder_id:
        fail("DRIVE_HOME_FAILED", f"Could not create the Drive home folder '{name}'.", exit_code=proc.returncode or 1,
             extra={"stderr": (proc.stderr or "").strip()})
    write_drive_home(account, name, folder_id)
    return folder_id


def default_parent_note(account):
    if not drive_home_name():
        return None
    home = read_drive_home(account)
    return home["id"] if home else f"(Drive folder '{drive_home_name()}', created on first use)"


def validate_drive_upload(local_path, explicit_mime=None):
    expanded = os.path.expanduser(local_path)
    if not os.path.exists(expanded):
        fail("UPLOAD_FILE_NOT_FOUND", f"Upload file does not exist: {local_path}")
    if os.path.isdir(expanded):
        fail("UPLOAD_IS_DIRECTORY", f"Upload path is a directory, regular file required: {local_path}")
    size = os.path.getsize(expanded)
    if size <= 0:
        fail("UPLOAD_EMPTY_FILE", f"Upload file is empty (0 bytes): {local_path}")
    if size > MAX_UPLOAD_BYTES:
        fail(
            "UPLOAD_TOO_LARGE",
            f"Upload file size ({size} bytes) exceeds 25 MiB cap ({MAX_UPLOAD_BYTES} bytes).",
        )

    mime = explicit_mime
    if not mime:
        ext = os.path.splitext(expanded)[1].lower()
        mime = EXTENSION_MIME_FALLBACK.get(ext)
        if not mime:
            guessed, _ = mimetypes.guess_type(expanded)
            mime = guessed
    mime_clean = (mime or "").split(";", 1)[0].strip().lower()
    if mime_clean not in ADMITTED_UPLOAD_MIMES:
        fail(
            "UNSUPPORTED_MEDIA_TYPE",
            f"Unsupported upload media type '{mime_clean or 'unknown'}'. Admitted types: {', '.join(sorted(ADMITTED_UPLOAD_MIMES))}",
        )
    return expanded, size, mime_clean


def extract_email_headers(msg_obj):
    headers = {}
    payload = msg_obj.get("payload") if isinstance(msg_obj, dict) else None
    if isinstance(payload, dict):
        for h in payload.get("headers") or []:
            if isinstance(h, dict) and h.get("name"):
                headers[h["name"].lower()] = h.get("value", "")
    return headers


def apply_caller_env(env_map):
    for k, v in env_map.items():
        if v:
            os.environ[k] = v
        else:
            os.environ.pop(k, None)


YOUTUBE_UPLOAD_SCOPE = "https://www.googleapis.com/auth/youtube.upload"
YOUTUBE_UPLOAD_URL = "https://www.googleapis.com/upload/youtube/v3/videos?uploadType=resumable&part=snippet,status"
YOUTUBE_PRIVACY = ("private", "unlisted", "public")


def youtube_fix(account):
    """The two one-time owner steps a YouTube upload needs, as commands."""
    return {
        "grant_scope": f"bashy google auth-login account={account} slot=youtube scopes={YOUTUBE_UPLOAD_SCOPE}",
        "enable_api": "gcloud services enable youtube.googleapis.com --project PROJECT_ID (or enable \"YouTube Data API v3\" in the Cloud Console for your OAuth client's project)",
    }


def oauth_access_token(credentials_file):
    """Exchange an authorized_user refresh token for an access token. The
    token is held in memory only; nothing is printed or written."""
    import urllib.parse
    import urllib.request
    with open(credentials_file, "r", encoding="utf-8") as fh:
        c = json.load(fh)
    if c.get("type") != "authorized_user":
        fail("UNSUPPORTED_CREDENTIAL", "youtube-upload needs an authorized_user (OAuth) credential for the channel owner")
    data = urllib.parse.urlencode({"client_id": c["client_id"], "client_secret": c["client_secret"],
                                   "refresh_token": c["refresh_token"], "grant_type": "refresh_token"}).encode()
    with urllib.request.urlopen("https://oauth2.googleapis.com/token", data=data, timeout=30) as resp:
        return json.loads(resp.read())["access_token"]


def handle_youtube_upload(cred_info, positionals, shaped, dry_run):
    import urllib.error
    import urllib.request
    path = positionals[0] if positionals else shaped.pop("file", None)
    if not path:
        fail("USAGE", "youtube-upload requires <video-file> title=... [description=...] [privacy=unlisted|private|public] [tags=a,b]")
    path = os.path.expanduser(path)
    if not os.path.isfile(path):
        fail("NOT_FOUND", f"no such file: {path}")
    title = shaped.pop("title", "") or os.path.splitext(os.path.basename(path))[0]
    privacy = shaped.pop("privacy", "unlisted").lower()
    if privacy not in YOUTUBE_PRIVACY:
        fail("USAGE", f"privacy must be one of {', '.join(YOUTUBE_PRIVACY)}")
    tags = [t.strip() for t in str(shaped.pop("tags", "")).split(",") if t.strip()]
    meta = {"snippet": {"title": title[:100], "description": shaped.pop("description", ""), "tags": tags},
            "status": {"privacyStatus": privacy, "selfDeclaredMadeForKids": False}}
    size = os.path.getsize(path)
    account = cred_info["account"]
    if dry_run:
        emit_json({"ok": True, "dry_run": True, "verb": "youtube-upload", "account": account, "file": path,
                   "bytes": size, "metadata": meta, "needs": youtube_fix(account)})
        sys.exit(0)
    # Google will not grant youtube.upload together with drive.file, so the
    # upload uses the account's separate "youtube" credential slot.
    slot_creds = os.path.join(credential_slot_dir(sanitize_account_dir(account), "youtube"), "credentials.json")
    if not os.path.isfile(slot_creds):
        fail("YOUTUBE_NOT_GRANTED", "no YouTube credential for this account yet", extra={"fix": youtube_fix(account)})
    token = oauth_access_token(slot_creds)
    mime = mimetypes.guess_type(path)[0] or "video/*"
    start = urllib.request.Request(YOUTUBE_UPLOAD_URL, data=json.dumps(meta).encode(), method="POST", headers={
        "Authorization": "Bearer " + token, "Content-Type": "application/json; charset=UTF-8",
        "X-Upload-Content-Type": mime, "X-Upload-Content-Length": str(size)})
    try:
        with urllib.request.urlopen(start, timeout=60) as resp:
            session = resp.headers.get("Location")
    except urllib.error.HTTPError as e:
        body = e.read().decode("utf-8", "replace")
        reason = "insufficient_scope" if ("insufficient" in body.lower() or e.code == 403 and "scope" in body.lower()) else \
            ("api_disabled" if ("has not been used" in body or "is disabled" in body or "accessNotConfigured" in body) else "http_%d" % e.code)
        fail("YOUTUBE_REFUSED", f"YouTube refused the upload ({reason})", extra={"reason": reason, "fix": youtube_fix(account), "detail": body[-400:]})
    if not session:
        fail("YOUTUBE_REFUSED", "YouTube returned no upload session")
    with open(path, "rb") as fh:
        put = urllib.request.Request(session, data=fh.read(), method="PUT", headers={
            "Authorization": "Bearer " + token, "Content-Type": mime})
        try:
            with urllib.request.urlopen(put, timeout=600) as resp:
                video = json.loads(resp.read())
        except urllib.error.HTTPError as e:
            fail("YOUTUBE_UPLOAD_FAILED", f"upload failed (HTTP {e.code})", extra={"detail": e.read().decode("utf-8", "replace")[-400:]})
    vid = video.get("id", "")
    emit_json({"ok": True, "verb": "youtube-upload", "account": account, "id": vid, "privacy": privacy,
               "url": f"https://youtu.be/{vid}", "embed": f"https://www.youtube-nocookie.com/embed/{vid}",
               "title": meta["snippet"]["title"]})
    sys.exit(0)


def main(
    env_account="",
    env_cred="",
    env_sa="",
    env_root="",
    env_bin="",
    env_path="",
    env_gac="",
    env_gwt="",
    env_flog="",
    env_flogin="",
    env_fsetup="",
    env_fsend="",
    env_home="",
    env_xdg="",
    env_drive_home="",
    env_no_browser="",
    env_gcloud="",
    env_hosted="",
    *args,
):
    apply_caller_env(
        {
            "GWS_ACCOUNT": str(env_account),
            "GWS_CREDENTIALS_FILE": str(env_cred),
            "GWS_SERVICE_ACCOUNT_KEY_FILE": str(env_sa),
            "GWS_CONFIG_ROOT": str(env_root),
            "GWS_BIN": str(env_bin),
            "PATH": str(env_path),
            "GOOGLE_APPLICATION_CREDENTIALS": str(env_gac),
            "GOOGLE_WORKSPACE_CLI_TOKEN": str(env_gwt),
            "FAKE_GWS_LOG": str(env_flog),
            "FAKE_GWS_FAIL_LOGIN": str(env_flogin),
            "FAKE_GWS_FAIL_SETUP": str(env_fsetup),
            "FAKE_GWS_FAIL_GMAIL_SEND": str(env_fsend),
            "HOME": str(env_home),
            "XDG_CACHE_HOME": str(env_xdg),
            "GWS_DRIVE_HOME": str(env_drive_home),
            "GWS_NO_BROWSER": str(env_no_browser),
            "GWS_GCLOUD_BIN": str(env_gcloud),
            "BASHY_HOSTED": str(env_hosted),
        }
    )
    raw_args = [str(a) for a in args]
    if not raw_args:
        fail("USAGE", "Missing subcommand. Run with --help for usage.")

    if raw_args[0] == "--contract":
        handle_contract()

    verb = raw_args[0]
    parsed = parse_shaped_args(raw_args[1:])
    positionals = parsed["positionals"]
    shaped = parsed["shaped"]
    dry_run = parsed["dry_run"]
    input_payload = parsed["input_payload"]

    # Onboarding verbs
    if verb == "auth-guide":
        handle_auth_guide(parsed)
    if verb == "auth-status":
        handle_auth_status(parsed)
    if verb == "auth-import":
        handle_auth_import(parsed)
    if verb == "auth-setup":
        handle_auth_setup(parsed)
    if verb == "auth-login":
        handle_auth_login(parsed)
    if verb == "auth-enable-apis":
        handle_auth_enable_apis(parsed)

    # All service and workflow verbs require explicit account + credentials preflight
    cred_info = require_credentials(shaped)

    # --- YouTube verbs ---
    if verb == "youtube-upload":
        handle_youtube_upload(cred_info, positionals, shaped, dry_run)

    # --- Gmail verbs ---
    if verb == "gmail-list":
        params = {"userId": shaped.pop("userId", "me"), "maxResults": int(shaped.pop("maxResults", 20))}
        params.update(shaped)
        run_gws(cred_info, ["gmail", "users", "messages", "list", "--params", json.dumps(params)])

    if verb == "gmail-get":
        msg_id = positionals[0] if positionals else shaped.pop("id", None)
        if not msg_id:
            fail("USAGE", "gmail-get requires <message-id>")
        params = {
            "userId": shaped.pop("userId", "me"),
            "id": str(msg_id),
            "format": shaped.pop("format", "full"),
        }
        params.update(shaped)
        run_gws(cred_info, ["gmail", "users", "messages", "get", "--params", json.dumps(params)])

    if verb in ("gmail-send", "gmail-draft"):
        data = dict(input_payload or {})
        data.update(shaped)
        user_id = data.pop("userId", "me")
        thread_id = data.pop("threadId", None)

        if "raw" in data:
            raw_b64 = data["raw"]
            to_addr = data.get("to", "")
            subject = data.get("subject", "")
        else:
            to_addr = data.pop("to", "")
            subject = data.pop("subject", "")
            body = data.pop("body", "")
            if not to_addr or not subject:
                fail("USAGE", f"{verb} requires to=<address> and subject=<text> (or --input with 'raw')")
            raw_b64 = build_rfc2822_raw(
                to_addr=to_addr,
                subject=subject,
                body=body,
                cc=data.pop("cc", None),
                bcc=data.pop("bcc", None),
                in_reply_to=data.pop("inReplyTo", None),
                references=data.pop("references", None),
            )

        msg_obj = {"raw": raw_b64}
        if thread_id:
            msg_obj["threadId"] = str(thread_id)

        if verb == "gmail-send":
            resource = ["gmail", "users", "messages", "send"]
            body_obj = msg_obj
        else:
            resource = ["gmail", "users", "drafts", "create"]
            body_obj = {"message": msg_obj}

        if dry_run:
            emit_json({
                "ok": True,
                "dry_run": True,
                "verb": verb,
                "account": cred_info["account"],
                "to": to_addr,
                "subject": subject,
                "gws_command": resource,
                "params": {"userId": user_id},
            })
            sys.exit(0)

        run_gws(
            cred_info,
            resource + ["--params", json.dumps({"userId": user_id}), "--json", json.dumps(body_obj)],
        )

    # --- Calendar verbs ---
    if verb == "calendar-list":
        cal_id = shaped.pop("calendarId", "primary")
        single_events = shaped.pop("singleEvents", True)
        params = {
            "calendarId": cal_id,
            "maxResults": int(shaped.pop("maxResults", 20)),
            "singleEvents": bool(single_events),
        }
        if params["singleEvents"] and "orderBy" not in shaped:
            params["orderBy"] = "startTime"
        params.update(shaped)
        run_gws(cred_info, ["calendar", "events", "list", "--params", json.dumps(params)])

    if verb == "calendar-get":
        event_id = positionals[0] if positionals else shaped.pop("eventId", None)
        if not event_id:
            fail("USAGE", "calendar-get requires <event-id>")
        params = {"calendarId": shaped.pop("calendarId", "primary"), "eventId": str(event_id)}
        params.update(shaped)
        run_gws(cred_info, ["calendar", "events", "get", "--params", json.dumps(params)])

    if verb == "calendar-create":
        body_obj = dict(input_payload or {})
        body_obj.update(shaped)
        cal_id = body_obj.pop("calendarId", "primary")
        if "summary" not in body_obj or "start" not in body_obj or "end" not in body_obj:
            fail("USAGE", "calendar-create requires summary=..., start=..., and end=...")
        body_obj["start"] = normalize_event_time(body_obj["start"])
        body_obj["end"] = normalize_event_time(body_obj["end"])
        if "attendees" in body_obj:
            body_obj["attendees"] = normalize_attendees(body_obj["attendees"])

        if dry_run:
            emit_json({
                "ok": True,
                "dry_run": True,
                "verb": verb,
                "account": cred_info["account"],
                "params": {"calendarId": cal_id},
                "body": body_obj,
            })
            sys.exit(0)

        run_gws(
            cred_info,
            [
                "calendar",
                "events",
                "insert",
                "--params",
                json.dumps({"calendarId": cal_id}),
                "--json",
                json.dumps(body_obj),
            ],
        )

    if verb == "calendar-update":
        event_id = positionals[0] if positionals else shaped.pop("eventId", None)
        if not event_id:
            fail("USAGE", "calendar-update requires <event-id>")
        body_obj = dict(input_payload or {})
        body_obj.update(shaped)
        cal_id = body_obj.pop("calendarId", "primary")
        if "start" in body_obj:
            body_obj["start"] = normalize_event_time(body_obj["start"])
        if "end" in body_obj:
            body_obj["end"] = normalize_event_time(body_obj["end"])
        if "attendees" in body_obj:
            body_obj["attendees"] = normalize_attendees(body_obj["attendees"])

        params = {"calendarId": cal_id, "eventId": str(event_id)}
        if dry_run:
            emit_json({
                "ok": True,
                "dry_run": True,
                "verb": verb,
                "account": cred_info["account"],
                "params": params,
                "body": body_obj,
            })
            sys.exit(0)

        run_gws(
            cred_info,
            ["calendar", "events", "patch", "--params", json.dumps(params), "--json", json.dumps(body_obj)],
        )

    if verb == "calendar-delete":
        event_id = positionals[0] if positionals else shaped.pop("eventId", None)
        if not event_id:
            fail("USAGE", "calendar-delete requires <event-id>")
        require_confirm(verb, shaped, dry_run, f"calendar event {event_id}")
        params = {"calendarId": shaped.pop("calendarId", "primary"), "eventId": str(event_id)}
        if dry_run:
            emit_json({
                "ok": True,
                "dry_run": True,
                "verb": verb,
                "account": cred_info["account"],
                "params": params,
            })
            sys.exit(0)
        run_gws(cred_info, ["calendar", "events", "delete", "--params", json.dumps(params)])

    if verb == "calendar-freebusy":
        body_obj = dict(input_payload or {})
        body_obj.update(shaped)
        if "timeMin" not in body_obj or "timeMax" not in body_obj:
            fail("USAGE", "calendar-freebusy requires timeMin=... and timeMax=...")
        if "items" not in body_obj:
            body_obj["items"] = [{"id": "primary"}]
        run_gws(cred_info, ["calendar", "freebusy", "query", "--json", json.dumps(body_obj)])

    # --- Tasks verbs ---
    if verb == "tasklists-list":
        params = {"maxResults": int(shaped.pop("maxResults", 20))}
        params.update(shaped)
        run_gws(cred_info, ["tasks", "tasklists", "list", "--params", json.dumps(params)])

    if verb == "tasks-list":
        params = {
            "tasklist": shaped.pop("tasklist", "@default"),
            "maxResults": int(shaped.pop("maxResults", 20)),
            "showCompleted": bool(shaped.pop("showCompleted", False)),
        }
        params.update(shaped)
        run_gws(cred_info, ["tasks", "tasks", "list", "--params", json.dumps(params)])

    if verb == "tasks-get":
        task_id = positionals[0] if positionals else shaped.pop("task", None)
        if not task_id:
            fail("USAGE", "tasks-get requires <task-id>")
        params = {"tasklist": shaped.pop("tasklist", "@default"), "task": str(task_id)}
        params.update(shaped)
        run_gws(cred_info, ["tasks", "tasks", "get", "--params", json.dumps(params)])

    if verb == "tasks-create":
        body_obj = dict(input_payload or {})
        body_obj.update(shaped)
        tasklist = body_obj.pop("tasklist", "@default")
        if "title" not in body_obj:
            fail("USAGE", "tasks-create requires title=...")
        params = {"tasklist": tasklist}
        if dry_run:
            emit_json({
                "ok": True,
                "dry_run": True,
                "verb": verb,
                "account": cred_info["account"],
                "params": params,
                "body": body_obj,
            })
            sys.exit(0)
        run_gws(
            cred_info,
            ["tasks", "tasks", "insert", "--params", json.dumps(params), "--json", json.dumps(body_obj)],
        )

    if verb == "tasks-complete":
        task_id = positionals[0] if positionals else shaped.pop("task", None)
        if not task_id:
            fail("USAGE", "tasks-complete requires <task-id>")
        params = {"tasklist": shaped.pop("tasklist", "@default"), "task": str(task_id)}
        body_obj = {"status": "completed"}
        if dry_run:
            emit_json({
                "ok": True,
                "dry_run": True,
                "verb": verb,
                "account": cred_info["account"],
                "params": params,
                "body": body_obj,
            })
            sys.exit(0)
        run_gws(
            cred_info,
            ["tasks", "tasks", "patch", "--params", json.dumps(params), "--json", json.dumps(body_obj)],
        )

    if verb == "tasks-update":
        task_id = positionals[0] if positionals else shaped.pop("task", None)
        if not task_id:
            fail("USAGE", "tasks-update requires <task-id>")
        body_obj = dict(input_payload or {})
        body_obj.update(shaped)
        tasklist = body_obj.pop("tasklist", "@default")
        params = {"tasklist": tasklist, "task": str(task_id)}
        if dry_run:
            emit_json({
                "ok": True,
                "dry_run": True,
                "verb": verb,
                "account": cred_info["account"],
                "params": params,
                "body": body_obj,
            })
            sys.exit(0)
        run_gws(
            cred_info,
            ["tasks", "tasks", "patch", "--params", json.dumps(params), "--json", json.dumps(body_obj)],
        )

    if verb == "tasks-delete":
        task_id = positionals[0] if positionals else shaped.pop("task", None)
        if not task_id:
            fail("USAGE", "tasks-delete requires <task-id>")
        require_confirm(verb, shaped, dry_run, f"task {task_id}")
        params = {"tasklist": shaped.pop("tasklist", "@default"), "task": str(task_id)}
        if dry_run:
            emit_json({
                "ok": True,
                "dry_run": True,
                "verb": verb,
                "account": cred_info["account"],
                "params": params,
            })
            sys.exit(0)
        run_gws(cred_info, ["tasks", "tasks", "delete", "--params", json.dumps(params)])

    # --- Drive verbs ---
    if verb == "drive-list":
        params = {
            "pageSize": int(shaped.pop("pageSize", 20)),
            "fields": shaped.pop(
                "fields", "files(id,name,mimeType,modifiedTime,size,webViewLink),nextPageToken"
            ),
        }
        params.update(shaped)
        run_gws(cred_info, ["drive", "files", "list", "--params", json.dumps(params)])

    if verb == "drive-search":
        query_term = positionals[0] if positionals else shaped.pop("q", None)
        if not query_term:
            fail("USAGE", "drive-search requires <query-string>")
        escaped = str(query_term).replace("'", "\\'")
        q_expr = f"name contains '{escaped}' and trashed = false"
        params = {
            "q": q_expr,
            "pageSize": int(shaped.pop("pageSize", 20)),
            "fields": shaped.pop(
                "fields", "files(id,name,mimeType,modifiedTime,size,webViewLink),nextPageToken"
            ),
        }
        params.update(shaped)
        run_gws(cred_info, ["drive", "files", "list", "--params", json.dumps(params)])

    if verb == "drive-get":
        file_id = positionals[0] if positionals else shaped.pop("fileId", None)
        if not file_id:
            fail("USAGE", "drive-get requires <file-id>")
        output = shaped.pop("output", None)
        params = {"fileId": str(file_id)}
        if output is None:
            params["fields"] = shaped.pop("fields", "id,name,mimeType,modifiedTime,size,webViewLink,parents")
        params.update(shaped)
        if output is not None:
            path = os.path.abspath(os.path.expanduser(str(output)))
            params["alt"] = "media"
            run_gws(cred_info, ["drive", "files", "get", "--params", json.dumps(params),
                                "--output", os.path.basename(path)], cwd=os.path.dirname(path))
        run_gws(cred_info, ["drive", "files", "get", "--params", json.dumps(params)])

    if verb == "drive-upload":
        local_path = positionals[0] if positionals else shaped.pop("file", None)
        if not local_path:
            fail("USAGE", "drive-upload requires <local-path>")
        explicit_mime = shaped.pop("mimeType", None)
        expanded, size, mime_clean = validate_drive_upload(local_path, explicit_mime)
        name = shaped.pop("name", os.path.basename(expanded))
        parent = shaped.pop("parent", None)
        meta = {"name": name, "mimeType": mime_clean}
        if parent:
            meta["parents"] = [str(parent)]
        meta.update(shaped)

        if dry_run:
            emit_json({
                "ok": True,
                "dry_run": True,
                "verb": verb,
                "account": cred_info["account"],
                "upload_path": expanded,
                "size_bytes": size,
                "mime_type": mime_clean,
                "metadata": meta,
                "default_parent": None if parent else default_parent_note(cred_info["account"]),
            })
            sys.exit(0)

        if not parent and drive_home_name():
            meta["parents"] = [ensure_drive_home(cred_info)]
        # gws only uploads files under its working directory.
        run_gws(
            cred_info,
            ["drive", "files", "create", "--upload", os.path.basename(expanded), "--json", json.dumps(meta)],
            cwd=os.path.dirname(expanded),
        )

    if verb == "drive-home":
        if positionals and positionals[0] == "set":
            folder_id = shaped.pop("id", None)
            if not folder_id:
                fail("USAGE", "drive-home set id=FOLDER_ID (a folder bashy created)")
            write_drive_home(cred_info["account"], shaped.pop("name", drive_home_name() or "bashy"), str(folder_id))
        elif dry_run:
            emit_json({"ok": True, "dry_run": True, "verb": verb, "account": cred_info["account"],
                       "home": default_parent_note(cred_info["account"])})
            sys.exit(0)
        folder_id = ensure_drive_home(cred_info)
        home = read_drive_home(cred_info["account"]) or {"id": folder_id}
        emit_json({"ok": True, "verb": verb, "account": cred_info["account"], "name": home.get("name"),
                   "id": folder_id, "url": f"https://drive.google.com/drive/folders/{folder_id}"})
        sys.exit(0)

    if verb == "drive-mkdir":
        folder_name = positionals[0] if positionals else shaped.pop("name", None)
        if not folder_name:
            fail("USAGE", "drive-mkdir requires <folder-name>")
        parent = shaped.pop("parent", None)
        meta = {
            "name": str(folder_name),
            "mimeType": "application/vnd.google-apps.folder",
        }
        if parent:
            meta["parents"] = [str(parent)]
        meta.update(shaped)

        if dry_run:
            emit_json({
                "ok": True,
                "dry_run": True,
                "verb": verb,
                "account": cred_info["account"],
                "metadata": meta,
                "default_parent": None if parent else default_parent_note(cred_info["account"]),
            })
            sys.exit(0)

        if not parent and drive_home_name():
            meta["parents"] = [ensure_drive_home(cred_info)]
        run_gws(cred_info, ["drive", "files", "create", "--json", json.dumps(meta)])

    # --- Escape hatch ---
    if verb == "raw":
        if len(positionals) < 2:
            fail("USAGE", "raw requires <service> <resource...>")
        service = positionals[0]
        if service not in ADMITTED_SERVICES:
            fail(
                "UNADMITTED_SERVICE",
                f"Service '{service}' is not in the admitted Google Workspace registry: {', '.join(sorted(ADMITTED_SERVICES))}",
            )
        cmd = list(positionals)
        destructive = [w for w in positionals[1:] if w in DESTRUCTIVE_METHODS.split()]
        if destructive:
            require_confirm(verb, shaped, dry_run, f"via {' '.join(positionals)}")
        else:
            shaped.pop("confirm", None)
        if parsed["raw_params_json"]:
            cmd.extend(["--params", parsed["raw_params_json"]])
        elif shaped:
            cmd.extend(["--params", json.dumps(shaped)])
        if parsed["raw_body_json"]:
            cmd.extend(["--json", parsed["raw_body_json"]])
        elif input_payload is not None:
            cmd.extend(["--json", json.dumps(input_payload)])
        if dry_run:
            emit_json({
                "ok": True,
                "dry_run": True,
                "verb": "raw",
                "account": cred_info["account"],
                "gws_argv": cmd,
            })
            sys.exit(0)
        run_gws(cred_info, cmd)

    # --- Composed Multi-Service Workflows ---
    if verb == "mail-to-task":
        msg_id = positionals[0] if positionals else shaped.pop("id", None)
        if not msg_id:
            fail("USAGE", "mail-to-task requires <message-id>")
        tasklist = shaped.pop("tasklist", "@default")
        due = shaped.pop("due", None)
        extra_notes = shaped.pop("notes", "")
        custom_title = shaped.pop("title", None)

        get_params = {"userId": "me", "id": str(msg_id), "format": "full"}
        msg_proc = run_gws(
            cred_info,
            ["gmail", "users", "messages", "get", "--params", json.dumps(get_params)],
            capture=True,
        )
        if msg_proc.returncode != 0:
            fail(
                "GMAIL_FETCH_FAILED",
                f"Failed to fetch Gmail message {msg_id}",
                exit_code=msg_proc.returncode,
                extra={"stderr": msg_proc.stderr.strip()},
            )

        try:
            msg_data = json.loads(msg_proc.stdout)
        except Exception as exc:
            fail("INVALID_GWS_RESPONSE", f"Failed to parse Gmail message JSON: {exc}", exit_code=1)

        headers = extract_email_headers(msg_data)
        subject = headers.get("subject") or f"Message {msg_id}"
        sender = headers.get("from") or ""
        snippet = msg_data.get("snippet", "")
        thread_id = msg_data.get("threadId", "")

        task_title = custom_title or f"[Email] {subject}"
        note_lines = []
        if extra_notes:
            note_lines.append(str(extra_notes))
        if sender:
            note_lines.append(f"From: {sender}")
        if snippet:
            note_lines.append(f"Snippet: {snippet}")
        note_lines.append(f"gmail_message_id: {msg_id}")
        if thread_id:
            note_lines.append(f"gmail_thread_id: {thread_id}")

        task_body = {"title": task_title, "notes": "\n".join(note_lines)}
        if due:
            task_body["due"] = str(due)

        if dry_run:
            emit_json({
                "ok": True,
                "dry_run": True,
                "workflow": "mail-to-task",
                "account": cred_info["account"],
                "source_message": {
                    "id": str(msg_id),
                    "threadId": thread_id,
                    "subject": subject,
                    "from": sender,
                },
                "planned_task": {
                    "tasklist": tasklist,
                    "body": task_body,
                },
            })
            sys.exit(0)

        task_proc = run_gws(
            cred_info,
            [
                "tasks",
                "tasks",
                "insert",
                "--params",
                json.dumps({"tasklist": tasklist}),
                "--json",
                json.dumps(task_body),
            ],
            capture=True,
        )
        if task_proc.returncode != 0:
            fail(
                "TASK_CREATE_FAILED",
                f"Fetched Gmail message {msg_id} but failed to create Google Task",
                exit_code=task_proc.returncode,
                extra={"stderr": task_proc.stderr.strip()},
            )

        try:
            task_data = json.loads(task_proc.stdout)
        except Exception:
            task_data = {"raw": task_proc.stdout.strip()}

        emit_json({
            "ok": True,
            "workflow": "mail-to-task",
            "account": cred_info["account"],
            "source_message": {
                "id": str(msg_id),
                "threadId": thread_id,
                "subject": subject,
                "from": sender,
            },
            "task": task_data,
        })
        sys.exit(0)

    if verb == "drive-share-mail":
        local_path = positionals[0] if positionals else shaped.pop("file", None)
        if not local_path:
            fail("USAGE", "drive-share-mail requires <local-path> and to=<address>")
        to_addr = shaped.pop("to", "")
        if not to_addr:
            fail("USAGE", "drive-share-mail requires to=<address>")

        explicit_mime = shaped.pop("mimeType", None)
        expanded, size, mime_clean = validate_drive_upload(local_path, explicit_mime)
        name = shaped.pop("name", os.path.basename(expanded))
        parent = shaped.pop("parent", None)
        subject = shaped.pop("subject", f"Shared file: {name}")
        body_prefix = shaped.pop("body", f"Sharing uploaded Drive file '{name}'.")

        meta = {"name": name, "mimeType": mime_clean}
        if parent:
            meta["parents"] = [str(parent)]

        if dry_run:
            emit_json({
                "ok": True,
                "dry_run": True,
                "workflow": "drive-share-mail",
                "account": cred_info["account"],
                "planned_upload": {
                    "upload_path": expanded,
                    "size_bytes": size,
                    "mime_type": mime_clean,
                    "metadata": meta,
                    "default_parent": None if parent else default_parent_note(cred_info["account"]),
                },
                "planned_email": {
                    "to": to_addr,
                    "subject": subject,
                },
            })
            sys.exit(0)

        if not parent and drive_home_name():
            meta["parents"] = [ensure_drive_home(cred_info)]
        upload_proc = run_gws(
            cred_info,
            ["drive", "files", "create", "--upload", os.path.basename(expanded), "--json", json.dumps(meta)],
            capture=True,
            cwd=os.path.dirname(expanded),
        )
        if upload_proc.returncode != 0:
            fail(
                "DRIVE_UPLOAD_FAILED",
                "Drive upload failed before sending email.",
                exit_code=upload_proc.returncode,
                extra={"stderr": upload_proc.stderr.strip()},
            )

        try:
            drive_file = json.loads(upload_proc.stdout)
        except Exception:
            drive_file = {"raw": upload_proc.stdout.strip()}

        file_id = drive_file.get("id", "unknown") if isinstance(drive_file, dict) else "unknown"
        web_link = (
            drive_file.get("webViewLink", f"https://drive.google.com/file/d/{file_id}/view")
            if isinstance(drive_file, dict)
            else ""
        )
        full_body = f"{body_prefix}\n\nDrive File: {name}\nFile ID: {file_id}\nLink: {web_link}\n"
        raw_b64 = build_rfc2822_raw(to_addr=to_addr, subject=subject, body=full_body)

        send_proc = run_gws(
            cred_info,
            [
                "gmail",
                "users",
                "messages",
                "send",
                "--params",
                json.dumps({"userId": "me"}),
                "--json",
                json.dumps({"raw": raw_b64}),
            ],
            capture=True,
        )
        if send_proc.returncode != 0:
            fail(
                "PARTIAL_WORKFLOW_FAILURE",
                "Drive file upload succeeded, but sending the Gmail notification failed. Do not blindly retry the upload.",
                exit_code=send_proc.returncode,
                extra={
                    "completed_step": "drive-upload",
                    "failed_step": "gmail-send",
                    "retry_safe": False,
                    "partial_result": {"drive_file": drive_file},
                    "cause": send_proc.stderr.strip(),
                },
            )

        try:
            sent_msg = json.loads(send_proc.stdout)
        except Exception:
            sent_msg = {"raw": send_proc.stdout.strip()}

        emit_json({
            "ok": True,
            "workflow": "drive-share-mail",
            "account": cred_info["account"],
            "drive_file": drive_file,
            "message": sent_msg,
        })
        sys.exit(0)

    if verb == "agenda":
        cal_id = shaped.pop("calendarId", "primary")
        tasklist = shaped.pop("tasklist", "@default")
        query = shaped.pop("q", "is:unread")
        limit = int(shaped.pop("maxResults", 10))

        cal_params = {"calendarId": cal_id, "maxResults": limit, "singleEvents": True, "orderBy": "startTime"}
        if "timeMin" in shaped:
            cal_params["timeMin"] = shaped.pop("timeMin")
        if "timeMax" in shaped:
            cal_params["timeMax"] = shaped.pop("timeMax")

        task_params = {"tasklist": tasklist, "maxResults": limit, "showCompleted": False}
        mail_params = {"userId": "me", "q": query, "maxResults": limit}

        cal_proc = run_gws(cred_info, ["calendar", "events", "list", "--params", json.dumps(cal_params)], capture=True)
        if cal_proc.returncode != 0:
            fail("AGENDA_CALENDAR_FAILED", "Failed to list calendar events", exit_code=cal_proc.returncode)
        task_proc = run_gws(cred_info, ["tasks", "tasks", "list", "--params", json.dumps(task_params)], capture=True)
        if task_proc.returncode != 0:
            fail("AGENDA_TASKS_FAILED", "Failed to list tasks", exit_code=task_proc.returncode)
        mail_proc = run_gws(cred_info, ["gmail", "users", "messages", "list", "--params", json.dumps(mail_params)], capture=True)
        if mail_proc.returncode != 0:
            fail("AGENDA_GMAIL_FAILED", "Failed to list Gmail messages", exit_code=mail_proc.returncode)

        def parse_or_raw(text):
            try:
                return json.loads(text)
            except Exception:
                return {"raw": text.strip()}

        cal_json = parse_or_raw(cal_proc.stdout)
        task_json = parse_or_raw(task_proc.stdout)
        mail_json = parse_or_raw(mail_proc.stdout)

        emit_json({
            "ok": True,
            "workflow": "agenda",
            "account": cred_info["account"],
            "calendar_events": cal_json.get("items", []) if isinstance(cal_json, dict) else cal_json,
            "tasks": task_json.get("items", []) if isinstance(task_json, dict) else task_json,
            "messages": mail_json.get("messages", []) if isinstance(mail_json, dict) else mail_json,
        })
        sys.exit(0)

    fail("UNKNOWN_VERB", f"Unknown google verb: {verb}. Run with --help for usage.", exit_code=2)
~~~
# The Python worker has a sanitized environment. Keep the vault connection
# settings and credential file contents in the calling shell and its child.
func vaultList() string {
  local names
  if [[ "${BASHY_HOSTED:-}" == "1" ]]; then
    names=${BASHY_HOSTED_GOOGLE_NAMES:-}
    return names
  fi
  if names=$("${BASHY_SELF:-bashy}" secret list google/ 2>/dev/null); then
    return names
  fi
  exit 1
}

func vaultSet(path string, source string) int {
  if [[ "${BASHY_HOSTED:-}" == "1" ]]; then
    return 1
  fi
  if "${BASHY_SELF:-bashy}" secret set "$path" 2>/dev/null < "$source" >/dev/null; then
    return 0
  fi
  return 1
}

google_root=${GWS_CONFIG_ROOT:-}
vault_mode=
if [[ "${1:-}" == "auth-export" ]]; then
  vault_mode=1
elif [[ "${1:-}" == "auth-status" ]]; then
  for arg in "${@:2}"; do
    if [[ "$arg" == "--vault" ]]; then
      vault_mode=1
      break
    fi
  done
fi
if [[ -n "$vault_mode" ]]; then
  vaultArgs := []string{}
  for arg in "$@"; do
    vaultArgs = append(vaultArgs, "$arg")
  done
  vaultStatus := py.vault_main(vaultList, vaultSet, "${GWS_ACCOUNT:-}", "${GWS_CREDENTIALS_FILE:-}", "${GWS_SERVICE_ACCOUNT_KEY_FILE:-}", "$google_root", "${HOME:-}", vaultArgs)
  exit "$vaultStatus"
fi

py.main \
  "${GWS_ACCOUNT:-}" \
  "${GWS_CREDENTIALS_FILE:-}" \
  "${GWS_SERVICE_ACCOUNT_KEY_FILE:-}" \
  "${GWS_CONFIG_ROOT:-}" \
  "${GWS_BIN:-}" \
  "${PATH:-}" \
  "${GOOGLE_APPLICATION_CREDENTIALS:-}" \
  "${GOOGLE_WORKSPACE_CLI_TOKEN:-}" \
  "${FAKE_GWS_LOG:-}" \
  "${FAKE_GWS_FAIL_LOGIN:-}" \
  "${FAKE_GWS_FAIL_SETUP:-}" \
  "${FAKE_GWS_FAIL_GMAIL_SEND:-}" \
  "${HOME:-}" \
  "${XDG_CACHE_HOME:-}" \
  "${GWS_DRIVE_HOME:-}" \
  "${GWS_NO_BROWSER:-}" \
  "${GWS_GCLOUD_BIN:-}" \
  "${BASHY_HOSTED:-}" \
  "$@"




