#!/usr/bin/env -S bashy --bashsharp
# A config for a tool bashy has no row for. The runner is an inline shell
# function; the body is a KEY=value file. `show` reads it, `apply` writes the
# rendered file next to the fence (never into the caller's tree) and declares
# `write`, so a read-only @guard denies it before it runs.

env-runner() {
  case "$1" in
    methods) printf '%s\n' '{"name":"show"}' '{"name":"apply","effects":["write"]}' ;;
    show)    grep -v '^#' "$2" | sort ;;
    apply)   out="${2%/*}/rendered.env"; grep -v '^#' "$2" | sort > "$out"; echo "$out" ;;
  esac
}

~~~env as cfg !env-runner
# the deployment knobs
REGION=eu-west
REPLICAS=3
~~~

knobs := cfg.show()
echo "$knobs"
@guard("read")
func rehearse() {
  x := cfg.apply()
  echo "rehearsal: status=$? (write is not in the guard)"
}
rehearse()
rendered := cfg.apply()
echo "applied -> ${rendered##*/}"
