#!/usr/bin/env -S bashy --bashsharp
# Native Bash# command face; protocol and JSON handling live in provision.py.
~~~skill as guide
---
name: klatch
description: Bootstrap and provision a running Klatch chat server, idempotently, with admin, accounts, mutual contacts and groups; post to a group or set its header topic as a bot.
metadata:
  requires: "has=bashy"
---
# Klatch

Run `bashy klatch setup CONFIG.json` against a running Klatch server reachable
at the `base_url` of the config. It bootstraps the admin password if needed, sets
the federation domain and closed access, then provisions accounts, mutual
contacts between group owner and members and groups. `provision` skips the admin
steps; `status` reports reachability, account count and groups. Output is JSON
handles to guids and group keys to ids. Reruns create no duplicates.
`post CONFIG.json GROUP TEXT|-` posts a message to the group as the config's
`bot` account (default the group owner, which must host the group);
`topic CONFIG.json GROUP TEXT|-` sets the conversation header to `NAME — TEXT`
(empty TEXT restores NAME). `-` reads TEXT from stdin, so anything composes:
`some-status --line | bashy klatch topic CONFIG.json session -`. Both print
`{"group", "ok"}`.
`invite CONFIG.json --count N [--ref REF]` mints N one-time sign-up links
(`<base_url>/?add=TOKEN`, one account each) into the vault (default
`klatch/signup-links`); it prints only the count and the reference.
Passwords are vault references via `bashy secret show REF`; never put one in
the config or on a command line. See `examples/klatch/README.md`.
~~~

set -euo pipefail
export BASHY_HINTS=off
here=$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)
if [[ ${1:-} == --skill ]]; then
  inside=false
  while IFS= read -r line; do
    if [[ $line == '~~~skill as guide' ]]; then inside=true; continue; fi
    if [[ $inside == true && $line == '~~~' ]]; then break; fi
    if [[ $inside == true ]]; then printf '%s\n' "$line"; fi
  done < "${BASH_SOURCE[0]}"
  exit
fi
if [[ ${1:-} == --contract ]]; then
  echo 'sokilili meitorikusu efefecato reada wurite neto fini sotepo porota porota fini enisure gereeni fini fini'
  exit
fi
# Registered commands put declared flags before positional arguments.
bound_flags=()
while [[ ${1:-} == --count=* || ${1:-} == --ref=* ]]; do
  bound_flags+=("$1")
  shift
done
if (( ${#bound_flags[@]} )); then set -- "$@" "${bound_flags[@]}"; fi
case ${1:-} in
  post|topic) (( $# == 4 )) || { echo "Usage: klatch $1 CONFIG.json GROUP TEXT|-" >&2; exit 2; } ;;
  invite) ;; # provision.py validates required flags before contacting the server
  *) (( $# == 2 )) || { echo 'Usage: klatch setup|provision|status CONFIG.json | post|topic CONFIG.json GROUP TEXT|-' >&2; exit 2; } ;;
esac
exec python3 "$here/provision.py" "$@"
