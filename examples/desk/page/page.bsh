#!/usr/bin/env -S bashy --bashsharp
# One body, two orientations: executable Bash# and its embedded agent skill.

~~~skill as guide
---
name: page
description: One fixed, live page for a group. Markdown plus ```block fences that show live items other desk apps own; one URL, one audience, one record. Agent drives via command/API; the group opens the page.
metadata:
  requires: "has=bashy"
  step-porota: 'bashy page list'
  check-tests: 'bashy page list'
---
# Page

This is the prose face of `page.bsh`, the same executable body used by the
registered `page` command. `bashy commands show page` exposes the
executable argv and source path; `bashy skill show page` reads this face.

A page is Markdown written by the organizer plus blocks, one line each in a
` ```block ` fence: `kind:ref [id=NAME] [key=value ...]`, for example
` ```block poll:form-9f3a ` or ` ```block embed:/whiteboard/?room=r1 `.
Kinds: poll, form, book, note, board, chart (an item another desk app owns),
timer, here, hands (page-local) and embed (a same-origin path or URL).

- `bashy page add [-f FILE|-] [--title T] [--audience host|lan|satellite] [--id ID] [--code CODE]` creates a page; prints id, URL, status and the owner key once.
- `bashy page open ID` prints the available join links, a QR for each, and the bare code.
- `bashy page show ID` reads title, Markdown, blocks, audience, participants (handle and auth only) and revision.
- `bashy page set ID [-f FILE|-] [--title T] [--audience A]` changes the page; every save bumps the revision and pushes a live frame.
- `bashy page list` lists pages; `bashy page share ID` mints a single-use invite link; `bashy page close ID` ends the page.
- `bashy page export ID --to md|html [-o FILE]` writes the record (handles, never addresses).
- `bashy page serve --lan --port PORT` listens on a fixed LAN port. Without `--lan`, the default is loopback port 18113.
- `bashy page participant ID --open|list|kick HANDLE|rename HANDLE NAME|merge HANDLE INTO` is the organizer's participant command.
- `bashy page publish-outpost [--public] [--dry-run] [--json]` registers the fixed page listener with outpost identity enabled. Publish before starting the shared listener.
~~~

set -euo pipefail
export BASHY_HINTS=off
here=$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)
cache=${XDG_CACHE_HOME:-$HOME/.cache}/bashy/desk-page
exe=$(go env GOEXE)
bin="$cache/page$exe"
build() {
  stale=false
  [[ -f "$bin" ]] || stale=true
  for src in "$here"/*.go "$here"/go.mod "$here"/go.sum "$here"/shaped.json "$here"/../kit/*.go "$here"/../kit/render/*.go; do
    [[ "$src" -nt "$bin" ]] && stale=true
  done
  if [[ $stale == true ]]; then
    mkdir -p "$here/.desk-build" "$cache"
    (cd "$here" && GOWORK=off CGO_ENABLED=0 go build -buildvcs=false -trimpath -o ".desk-build/page$exe" . && { mv -f ".desk-build/page$exe" "$bin" || [[ -f "$bin" ]]; })
  fi
}

case ${1:-serve} in
--skill)
  copying=false
  while IFS= read -r line; do
    if [[ $line == '~~~skill as guide' ]]; then copying=true; continue; fi
    if [[ $copying == true && $line == '~~~' ]]; then break; fi
    if [[ $copying == true ]]; then printf '%s\n' "$line"; fi
  done < "${BASH_SOURCE[0]}"
  ;;
--contract) echo 'sokilili page efefecato reada wurite neto fini sotepo porota porota fini enisure gereeni fini fini' ;;
-h|--help) echo 'page [serve|add|open|show|set|list|share|close|export|participant|publish-outpost|unpublish-outpost|test] — one fixed, live page for a group; --skill prints its embedded skill' ;;
test)
  cd "$here" && GOWORK=off go test ./...
  ;;
*)
  build
  exec "$bin" "$@"
  ;;
esac
