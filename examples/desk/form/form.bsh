#!/usr/bin/env -S bashy --bashsharp
# One body, two orientations: executable Bash# and its embedded agent skill.

~~~skill as guide
---
name: form
description: Define an ad-hoc form in JSON/YAML for a human to fill on a loopback page, then read answers back as JSON keyed by field id. Use when there is more than one question for a human, or answers must survive reload and be polled.
metadata:
  requires: "has=bashy"
  step-porota: 'bashy form new --def form.json'
  check-tests: 'bashy form list'
---
# Ad-hoc forms

This is the prose face of `form.bsh`, the same executable body used by the
registered `form` command. `bashy commands show form` exposes the
executable argv and source path; `bashy skill show form` reads this face.

- `bashy form new --def form.json --title "Intake"` defines a form from a
  JSON or YAML file (see `examples/` for the schema: text, textarea,
  choice, multi, yes-no, file; required; one recommended option per
  choice/multi shown with a mark). Prints the id, loopback URL and status
  plus a one-time owner key — never content.
- `bashy form open ID` re-surfaces a form: id, URL, status only.
- The human fills the form on the loopback page (Save keeps a partial
  save, Submit completes it); partial saves survive reload.
- `bashy form get ID --json` reads the definition and the answers back as
  JSON keyed by field id. `bashy form wait ID` blocks until the form is
  answered (or closed, or the timeout hits).
- `bashy form put ID --answer name=Ada` prefills answers as the owner;
  `list`, `share`, `close` work like every desk tool.
- `bashy form serve` starts the native foreground service (loopback only)
  and prints the participant origin. Ctrl-C stops it; saved forms remain.
- Fields typed secret — or secret-named like `db_password` — are refused
  before storage; credentials stay with `bashy ask`/vault.
- `FORM_DATA` selects the data directory; default is
  `$BASHY_HOME/desk/form`. `FORM_ADDR` selects the listener; default
  `127.0.0.1:18107`. `FORM_PREFIX` selects a URL sub-path when served
  behind one; default empty. Never publish an owner key.

No containers, accounts, external database, web assets, or AI service. The
native Go server is a supporting implementation; the orchestration and this
guidance have one source in this file. `--skill` projects the guidance and
`--contract` projects the executable skill contract for ordinary registration.
~~~

set -euo pipefail
export BASHY_HINTS=off
here=$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)
cache=${XDG_CACHE_HOME:-$HOME/.cache}/bashy/form
bin=$cache/form
build() {
  mkdir -p "$cache"
  (cd "$here" && GOWORK=off CGO_ENABLED=0 go build -trimpath -o "$bin" ./server)
}
case ${1:-serve} in
--skill)
  copying=false
  while IFS= read -r line; do
    if [[ $line == '~~~skill as guide' ]]; then copying=true; continue; fi
    if [[ $copying == true && $line == '~~~' ]]; then break; fi
    if [[ $copying == true ]]; then printf '%s\n' "$line"; fi
  done < "${BASH_SOURCE[0]}"
  ;;
--contract) echo 'sokilili foromu efefecato reada wurite neto fini sotepo porota porota fini enisure gereeni fini fini' ;;
-h|--help) echo 'form [serve|new|open|get|put|list|share|close|wait] [--json] — ad-hoc loopback forms; --skill prints its embedded skill' ;;
serve)
  shift || true
  data=${FORM_DATA:-}
  addr=${FORM_ADDR:-127.0.0.1:18107}
  prefix=${FORM_PREFIX:-}
  build
  if [[ -n ${data:-} && -n ${prefix:-} ]]; then exec "$bin" serve -data "$data" -addr "$addr" -prefix "$prefix" "$@"
  elif [[ -n ${data:-} ]]; then exec "$bin" serve -data "$data" -addr "$addr" "$@"
  elif [[ -n ${prefix:-} ]]; then exec "$bin" serve -addr "$addr" -prefix "$prefix" "$@"
  else exec "$bin" serve -addr "$addr" "$@"; fi
  ;;
stop)
  if pkill -f "$bin serve" 2>/dev/null; then echo "stopped form"; else echo "no form server matched $bin serve"; fi
  ;;
test) cd "$here"; GOWORK=off go test ./... ;;
new|open|get|put|list|share|close|wait|join)
  build
  data=${FORM_DATA:-}
  addr=${FORM_ADDR:-127.0.0.1:18107}
  prefix=${FORM_PREFIX:-}
  args=()
  if [[ -n ${data:-} ]]; then args+=(-data "$data"); fi
  args+=(-addr "$addr")
  if [[ -n ${prefix:-} ]]; then args+=(-prefix "$prefix"); fi
  exec "$bin" "${args[@]}" "$@"
  ;;
*) echo 'Usage: form [serve|new|open|get|put|list|share|close|wait] [--json]' >&2; exit 2 ;;
esac
