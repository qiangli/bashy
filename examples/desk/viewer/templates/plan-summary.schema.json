{
  "type": "object",
  "description": "A plan at a glance: goal, ordered steps with status, risks and decisions.",
  "required": ["goal", "steps"],
  "properties": {
    "sprint": {
      "type": "object",
      "x-source": "sprint",
      "description": "Live sprint card; filled from `bashy sprint show N --json` when omitted",
      "required": ["id", "title", "goals"],
      "additionalProperties": true,
      "properties": {
        "id": {"type": "integer"},
        "title": {"type": "string"},
        "column": {"type": "string"},
        "primary_goal": {"type": "string"},
        "stories": {"type": "integer"},
        "goals": {"type": "array", "items": {"type": "object", "additionalProperties": true,
          "properties": {"id": {"type": "string"}, "text": {"type": "string"}, "checked": {"type": "boolean"}, "wontfix": {"type": "boolean"}}}}
      }
    },
    "title": {"type": "string", "maxLength": 200},
    "goal": {"type": "string", "format": "markdown", "maxLength": 2000},
    "steps": {"type": "array", "maxItems": 60, "items": {"type": "object", "required": ["title"],
      "properties": {
        "title": {"type": "string", "maxLength": 200},
        "detail": {"type": "string", "format": "markdown", "maxLength": 2000},
        "owner": {"type": "string", "maxLength": 80},
        "status": {"type": "string", "enum": ["todo", "doing", "done", "blocked"]}
      }}},
    "risks": {"type": "array", "maxItems": 50, "items": {"type": "string", "maxLength": 500}},
    "decisions": {"type": "array", "maxItems": 50, "items": {"type": "string", "maxLength": 500}}
  }
}
