{
  "type": "object",
  "description": "Sprint or session status. The agent writes only the narrative; the sprint card is read live.",
  "required": ["summary"],
  "properties": {
    "sprint": {
      "type": "object",
      "x-source": "sprint",
      "description": "Live sprint card; filled from `bashy sprint show N --json` when omitted",
      "required": ["id", "title", "goals"],
      "additionalProperties": true,
      "properties": {
        "id": {"type": "integer"},
        "title": {"type": "string"},
        "column": {"type": "string"},
        "primary_goal": {"type": "string"},
        "stories": {"type": "integer"},
        "goals": {"type": "array", "items": {"type": "object", "additionalProperties": true,
          "properties": {"id": {"type": "string"}, "text": {"type": "string"}, "checked": {"type": "boolean"}, "wontfix": {"type": "boolean"}}}}
      }
    },
    "title": {"type": "string", "maxLength": 200},
    "summary": {"type": "string", "format": "markdown", "maxLength": 4000},
    "done": {"type": "array", "maxItems": 50, "items": {"type": "string", "maxLength": 500}},
    "next": {"type": "array", "maxItems": 50, "items": {"type": "string", "maxLength": 500}},
    "risks": {"type": "array", "maxItems": 50, "items": {"type": "string", "maxLength": 500}},
    "asks": {"type": "array", "maxItems": 50, "items": {"type": "string", "maxLength": 500}},
    "metrics": {"type": "array", "maxItems": 24, "description": "Rendered as a bar chart",
      "items": {"type": "object", "required": ["label", "value"],
        "properties": {"label": {"type": "string", "maxLength": 60}, "value": {"type": "number"}}}}
  }
}
