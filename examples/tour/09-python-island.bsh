#!/usr/bin/env -S bashy --bashsharp
# 09 — Any fenced language where you need a library. A tilde-fenced Python
# block ("py as py") is an island: its functions are ordinary callables from
# shell text and typed values cross the boundary. The same shape exists for
# TypeScript, Rust, C/C++, Go and bash. Needs a python3 on PATH; check.sh
# SKIPs this section without one. (Do not write a tilde fence inside a
# comment — the scanner would take it for a real one.)

~~~py as py
def major() -> int:
    import sys
    return sys.version_info[0]

def shout(s: str) -> str:
    return s.upper() + "!"
~~~

v := py.major()
echo "python major version: $v"
s := py.shout("islands")
echo "$s"
