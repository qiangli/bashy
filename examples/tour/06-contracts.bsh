#!/usr/bin/env -S bashy --bashsharp
# 06 — Contracts on ordinary functions. `@require` runs BEFORE the body,
# `@ensure` AFTER it; each is a shell command run in the call's own frame
# ($1..$n = the arguments; $RESULT = a typed function's return). A failed
# clause exits 3 and names itself. A check's own variables never leak back.

work=$(mktemp -d)
trap 'rm -rf "$work"' EXIT

@require('test -d "$work" && test -n "$1"')
@ensure('probe=leaked; test -f "$work/$1"')
function produce() {
    : > "$work/$1"
}

@ensure('test "$RESULT" -gt 0')
func twice(n int) int { return n * 2 }

produce made;      echo "produce -> $? $(test -f "$work/made" && echo made) probe=${probe-unset}"
produce "";        echo "produce -> $?"
x := twice(2);     echo "twice 2 -> $? x=$x"
y := twice(0);     echo "twice 0 -> $? y=$y"
