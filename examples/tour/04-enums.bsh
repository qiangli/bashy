#!/usr/bin/env -S bashy --bashsharp
# 04 — Exhaustive enums: `type T enum { ... }` lowers to Go constants, and a
# `switch` over an enum must cover every member.

type Color enum { Red; Green }
func label(c Color) string {
    switch c {
    case Red:
        return "red"
    case Green:
        return "green"
    }
}
printf '%s\n' label(Red)
printf '%s\n' label(Green)
