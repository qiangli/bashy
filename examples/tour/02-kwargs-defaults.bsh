#!/usr/bin/env -S bashy --bashsharp
# 02 — Keyword arguments and default parameters. Both shapes are bash syntax
# errors in stock bash, so admitting them changes no existing script.

func greet(name string, retries int = 3) {
    printf '%s:%d\n' name retries
}

greet("Ada")                    # default applied
greet("Bob", 5)                 # positional
greet(retries: 7, name: "Cy")   # keywords, any order
