#!/usr/bin/env -S bashy --bashsharp
# 03 — Decorators. A decorator is an ordinary function whose first parameter
# is `c *Call`; `c.Name` is the callee, `c.Next()` runs it. `@name(args)`
# lines stack above a declaration; arguments are evaluated PER CALL in the
# declaring scope — so the same decorator can carry a changing shell value.

func tag(c *Call, label string, level string = "info") {
    name := c.Name
    echo "[$level] $label -> $name"
    c.Next()
}

suffix="a"

@tag("positional")
func one() {
    echo "one:body"
}

@tag(label: "keyword", level: "debug")
func two() {
    echo "two:body"
}

@tag("late-$suffix")
func three() {
    echo "three:body"
}

one()
two()
three()
suffix="b"
three()
