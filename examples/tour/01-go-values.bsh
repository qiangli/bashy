#!/usr/bin/env -S bashy --bashsharp
# 01 — Go where you need types: `:=` declarations, typed functions, and calls
# written as ordinary words. Shell expansion sees a Go value as text, so
# "$x" works everywhere it always did; a call as a WORD (`twice(y)`) is a
# Bash# form — stock bash rejects the `(`, which is why it is safe to add.

x := 42
name := "gopher"
func twice(n int) int { return n * 2 }
y := twice(x)
echo "x=$x y=$y name=$name"
printf '%s doubled is %d\n' "$name" twice(y)
