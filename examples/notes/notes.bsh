#!/usr/bin/env -S bashy --bashsharp
set -euo pipefail

here=$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)
runner=${BASHY_BIN:-bashy}
git_bin=${NOTES_GIT_BIN:-/usr/bin/git}
pin=d0c6e2a7afc6de17220f9b439bb077a5aa12f83f
fork=https://github.com/qiangli/memos-shape.git
home=${BASHY_HOME:-$HOME/.bashy}
state=$home/notes
source=$state/source
port=${NOTES_CONSOLE_PORT:-22749}

usage() {
  cat <<'EOF'
notes install|start|stop|status|source
  install  Fetch the pinned MIT source, build the web UI, and register a shaped app.
  start    Run the local app console in the foreground; the notes server starts on first request.
  stop     Stop the console started by this command.
  status   Show the managed console and source revision.
  source   Print the managed source directory.

notes list [--filter CEL] [--state normal|archived] [--page-size N] [--page-token TOKEN]
notes show ID
notes add --content MARKDOWN [--tags a,b] [--visibility private|protected|public|space] [--space spaces/ID]
notes set ID [--content MARKDOWN] [--tags a,b] [--visibility VALUE] [--pinned true|false] [--space spaces/ID]
notes archive|unarchive|rm ID
notes search TEXT [--filter CEL] [--page-size N] [--page-token TOKEN]
notes export ID [--format markdown|json]
  Data verbs require Python 3.9+, NOTES_URL (numeric loopback URL including port
  and optional app proxy prefix), and NOTES_TOKEN (existing app bearer token).
  --url overrides NOTES_URL. No identity or credential is created or saved.
  All data verbs accept --json (the app response); writes accept --dry-run.
  Dry-run prints a request manifest without contacting the app or reading a token.
  Tags are Markdown hashtags: --tags appends them to explicit replacement --content.
  list/search return one page and nextPageToken; --order-by passes API ordering.
  export defaults to Markdown; --json always returns the original memo JSON.
  rm also deletes comment descendants, as on the page.
EOF
}

installed() {
  test -f "$source/.notes-source-pin" &&
    test "$(cat "$source/.notes-source-pin")" = "$pin" &&
    test -s "$source/server/frontend/dist/index.html" &&
    test -f "$source/shaped.json"
}

register_app() {
  "$runner" app add notes --type shaped --source "$source" --label Notes \
    --icon '📝' --tip 'A personal notes board with a shapeable web UI'
}

install() {
  if installed; then
    register_app
    return
  fi
  if test -e "$source"; then
    echo 'notes: source exists but does not match the pinned build; inspect it manually' >&2
    exit 1
  fi
  test -x "$git_bin"
  command -v go >/dev/null
  command -v corepack >/dev/null
  mkdir -p "$state"
  scratch=$(mktemp -d "$state/install.XXXXXX")
  trap 'rm -rf "$scratch"' EXIT
  "$git_bin" clone --quiet --filter=blob:none "$fork" "$scratch/source"
  "$git_bin" -C "$scratch/source" switch --quiet -c shape-notes "$pin"
  if ! head -n 1 "$scratch/source/LICENSE" | grep -qx 'MIT License'; then
    echo 'notes: pinned source is not MIT licensed' >&2
    exit 1
  fi
  if find "$scratch/source" -type d \( -name ee -o -name premium -o -name enterprise \) -print | grep -q .; then
    echo 'notes: non-permissive source directory found' >&2
    exit 1
  fi
  "$git_bin" -C "$scratch/source" apply --unidiff-zero "$here/web-prefix.patch"
  (cd "$scratch/source/web" && corepack pnpm install --frozen-lockfile && corepack pnpm release)
  rm -rf "$scratch/source/web/node_modules"
  printf '\n!server/frontend/dist/\n!server/frontend/dist/**\n' >> "$scratch/source/.gitignore"
  cp "$here/shaped.json" "$scratch/source/shaped.json"
  cp "$here/contract.bsh" "$scratch/source/contract.bsh"
  mkdir -p "$scratch/source/checks"
  cp "$here/checks/notes.bsh" "$scratch/source/checks/notes.bsh"
  cp "$here/shape_version.go.tmpl" "$scratch/source/cmd/memos/zz_shape_version.go"
  printf '%s\n' "$pin" > "$scratch/source/.notes-source-pin"
  "$git_bin" -C "$scratch/source" add .gitignore shaped.json contract.bsh checks/notes.bsh \
    cmd/memos/zz_shape_version.go .notes-source-pin web/vite.config.mts \
    web/src/router/index.tsx web/src/connect.ts web/src/hooks/useLiveMemoRefresh.ts
  "$git_bin" -C "$scratch/source" add -f server/frontend/dist
  "$git_bin" -C "$scratch/source" -c user.name='Bashy Notes' -c user.email='notes@example.invalid' \
    commit -qm 'Add per-principal shaping adapter' \
    -m 'Sprint: #631' -m 'Story: #209' -m 'Story-ID: 3af901c7c3bf' -m 'Agent: codex-gpt6-sol'
  mv "$scratch/source" "$source"
  register_app
}

running_pid() {
  test -f "$state/console.pid" || return 1
  pid=$(cat "$state/console.pid")
  case "$pid" in *[!0-9]*|'') return 1;; esac
  kill -0 "$pid" 2>/dev/null || return 1
  cmdline=$(/bin/ps -p "$pid" -o args= 2>/dev/null) || return 1
  case "$cmdline" in *"app serve --bind lan --port $port --pair"*) ;; *) return 1 ;; esac
  printf '%s\n' "$pid"
}

case ${1:---help} in
  -h|--help|help) usage ;;
  list|show|add|set|archive|unarchive|rm|search|export)
    exec python3 "$here/notes_api.py" "$@"
    ;;
  install) install ;;
  start)
    installed || { echo 'notes: run notes install first' >&2; exit 1; }
    if running_pid >/dev/null; then echo "notes: console already running on port $port"; exit 0; fi
    echo "notes: paired console starting on port $port; run bashy app pair --allow notes --principal NAME --port $port"
    "$runner" app serve --bind lan --port "$port" --pair &
    pid=$!
    echo "$pid" > "$state/console.pid"
    wait "$pid" || result=$?
    rm -f "$state/console.pid"
    exit "${result:-0}"
    ;;
  stop)
    if pid=$(running_pid); then
      kill "$pid"
      rm -f "$state/console.pid"
      echo 'notes: console stopped'
    else
      echo 'notes: console is not running'
    fi
    ;;
  status)
    if installed; then echo "notes: source pin $pin"; else echo 'notes: not installed'; fi
    if running_pid >/dev/null; then echo "notes: console running on port $port"; else echo 'notes: console stopped'; fi
    ;;
  source) installed && printf '%s\n' "$source" ;;
  *) usage >&2; exit 2 ;;
esac
