#!/usr/bin/env -S bashy --bashsharp
# Decorators: an ordinary function whose first parameter is `c *Call`.
# `@tag(...)` lines stack above a declaration; the arguments are evaluated
# PER INVOCATION in the declaring scope, with keyword and default arguments.
# (From bashsharp-tests/tests/decorators/arguments.bpp.)

func tag(c *Call, label string, level string = "info") {
    name := c.Name
    echo "[$level] $label -> $name"
    c.Next()
}

suffix="a"

@tag("positional")
func one() {
    echo "one:body"
}

@tag(label: "keyword", level: "debug")
func two() {
    echo "two:body"
}

@tag("late-$suffix")
func three() {
    echo "three:body"
}

one()
two()
three()
suffix="b"
three()
