#!/usr/bin/env -S bashy --bashsharp
# Exhaustive enums: a `switch` over an enum must cover every member.
# (From bashsharp-tests/tests/bashsharp/enums/exhaustive.bpp.)

type Color enum { Red; Green }
func label(c Color) string {
    switch c {
    case Red:
        return "red"
    case Green:
        return "green"
    }
}
printf '%s\n' label(Green)
