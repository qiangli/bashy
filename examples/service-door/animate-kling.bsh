#!/usr/bin/env -S bashy --bashsharp
# animate-kling: browser rod for video animation via Kling (https://klingai.com).
# Route: browser. Role: animate. Contract: docs/service-rod-contract.md.
#
# SPEND/VENUE RULE: drives the operator's real logged-in Chrome.
# Takes 'bashy claim chrome-browser' before ANY live-mode action and releases it after.
# Supports --dry-run and recorded page fixtures (--fixture).
# Refuses generation without --yes. Live path with --yes submits, waits for completion,
# downloads the real artifact into BASHY_SVC_OUT, checks it with ffprobe, and reports it.
set -eu

PROG=animate-kling
bashy_bin=${BASHY_SVC_BASHY_BIN:-bashy}

if [ "${1:-}" = "--doctor" ]; then
    json=0
    if [ "${2:-}" = "--json" ]; then json=1; fi
    if [ "$json" = 1 ]; then
        if "$bashy_bin" browser status >/dev/null 2>&1; then
            echo '{"schema_version":"bashy-svc-doctor-v1","available":true,"missing":[]}'
            exit 0
        else
            echo '{"schema_version":"bashy-svc-doctor-v1","available":false,"missing":[{"need":"has=bashy","install":"install bashy or configure chrome browser"}]}'
            exit 0
        fi
    else
        echo "$PROG: ready (browser provider for Kling)"
        exit 0
    fi
fi

role=${BASHY_SVC_ROLE:-animate}
route=${BASHY_SVC_ROUTE:-browser}
request=${BASHY_SVC_REQUEST:-}
out=${BASHY_SVC_OUT:-}
yes=${BASHY_SVC_YES:-0}
dry=0
fixture=${BASHY_SVC_FIXTURE:-}
mode=${BASHY_BROWSER_MODE:-live}
operands=()

while [ "$#" -gt 0 ]; do
    case $1 in
        --dry-run) dry=1; shift ;;
        --yes) yes=1; shift ;;
        --out) out=${2:?}; shift 2 ;;
        --out=*) out=${1#*=}; shift ;;
        --fixture) fixture=${2:?}; shift 2 ;;
        --fixture=*) fixture=${1#*=}; shift ;;
        --mode) mode=${2:?}; shift 2 ;;
        --mode=*) mode=${1#*=}; shift ;;
        --role) role=${2:?}; shift 2 ;;
        --role=*) role=${1#*=}; shift ;;
        --help|-h)
            echo "Usage: $PROG [--dry-run] [--yes] [--out DIR] [--fixture PATH] [--mode live|solo] [REQUEST.json]"
            exit 0
            ;;
        *)
            if [ -z "$request" ] && [[ $1 == *.json ]] && [ -f "$1" ]; then
                request=$(cd "$(dirname "$1")" && pwd)/$(basename "$1")
            else
                operands+=("$1")
            fi
            shift
            ;;
    esac
done

image_file=""
audio_file=""
prompt=""
duration_s=5
width=1280
height=720
fps=30
title=""

if [ -n "$request" ] && [ -f "$request" ]; then
    schema=$(jq -r '.schema_version // ""' "$request" 2>/dev/null || true)
    if [ -n "$schema" ] && [[ $schema != bashy-svc-request-v1* ]]; then
        echo "$PROG: unsupported request schema version: $schema" >&2
        exit 2
    fi
    image_file=$(jq -r '.image // empty' "$request" 2>/dev/null || true)
    audio_file=$(jq -r '.audio // empty' "$request" 2>/dev/null || true)
    prompt=$(jq -r '.prompt // empty' "$request" 2>/dev/null || true)
    dur=$(jq -r '.duration_s // empty' "$request" 2>/dev/null || true)
    [ -z "$dur" ] || duration_s=$dur
    w=$(jq -r '.width // empty' "$request" 2>/dev/null || true)
    [ -z "$w" ] || width=$w
    h=$(jq -r '.height // empty' "$request" 2>/dev/null || true)
    [ -z "$h" ] || height=$h
    f=$(jq -r '.fps // empty' "$request" 2>/dev/null || true)
    [ -z "$f" ] || fps=$f
    title=$(jq -r '.title // empty' "$request" 2>/dev/null || true)
elif [ "${#operands[@]}" -gt 0 ]; then
    prompt="${operands[*]}"
fi

[ -n "$prompt" ] || prompt="lip-synced singing performance with subtle natural motion"

if [ "$dry" = 1 ]; then
    printf '{"schema_version":"bashy-svc-rod-v1","outputs":[{"path":"animate.mp4","media_type":"video/mp4"}],"text":"[dry-run] Kling animation: image=\\"%s\\", audio=\\"%s\\", prompt=\\"%s\\", duration=%ss"}\n' "$image_file" "$audio_file" "$prompt" "$duration_s"
    exit 0
fi

if [ "$yes" != 1 ]; then
    echo "$PROG: requires --yes to allow spend effect (Kling subscription credits)" >&2
    exit 2
fi

if [ -z "$out" ]; then
    out=$(mktemp -d "${TMPDIR:-/tmp}/$PROG.XXXXXX")
fi
mkdir -p "$out"
out=$(cd "$out" && pwd)
out_file="$out/animate.mp4"

verify_video() {
    local file="$1"
    if [ ! -s "$file" ]; then
        echo "$PROG: output video file is missing or empty: $file" >&2
        return 1
    fi
    if command -v ffprobe >/dev/null 2>&1; then
        if ! ffprobe -v error -select_streams v -show_entries stream=codec_type -of default=noprint_wrappers=1 "$file" >/dev/null 2>&1; then
            echo "$PROG: ffprobe verification failed for video: $file" >&2
            return 1
        fi
    fi
}

download_media() {
    local url="$1"
    local dest="$2"
    if [[ $url == file://* ]]; then
        local p="${url#file://}"
        cp "$p" "$dest" || { echo "$PROG: failed to copy $p to $dest" >&2; return 1; }
    elif [[ $url == http://* ]] || [[ $url == https://* ]]; then
        if command -v curl >/dev/null 2>&1; then
            curl -sSfL "$url" -o "$dest" || { echo "$PROG: failed to download $url" >&2; return 1; }
        elif command -v "$bashy_bin" >/dev/null 2>&1; then
            "$bashy_bin" fetch "$url" > "$dest" || { echo "$PROG: failed to fetch $url" >&2; return 1; }
        else
            echo "$PROG: no download tool available for $url" >&2
            return 1
        fi
    elif [[ $url == data:* ]]; then
        echo "${url#*,}" | base64 -d > "$dest" || { echo "$PROG: failed to decode data URL" >&2; return 1; }
    elif [ -f "$url" ]; then
        cp "$url" "$dest" || { echo "$PROG: failed to copy $url to $dest" >&2; return 1; }
    elif [ -n "$fixture" ] && [ -f "$(dirname "$fixture")/$url" ]; then
        cp "$(dirname "$fixture")/$url" "$dest" || { echo "$PROG: failed to copy $(dirname "$fixture")/$url" >&2; return 1; }
    else
        echo "$PROG: unknown or unresolvable media url: $url" >&2
        return 1
    fi
}

# Recorded page fixture execution
if [ -n "$fixture" ]; then
    if [ ! -f "$fixture" ]; then
        echo "$PROG: fixture file not found: $fixture" >&2
        exit 1
    fi
    fixture_abs=$(cd "$(dirname "$fixture")" && pwd)/$(basename "$fixture")
    b_mode=${mode:-probe}
    if [ "$b_mode" = "live" ]; then b_mode="probe"; fi

    cleanup_fixture_probe() {
        if [ "$b_mode" = "probe" ]; then
            "$bashy_bin" browser --mode probe stop >/dev/null 2>&1 || true
        fi
    }
    trap cleanup_fixture_probe EXIT INT TERM

    # Navigate
    "$bashy_bin" browser --mode "$b_mode" navigate "file://$fixture_abs" >/dev/null || {
        echo "$PROG: failed step: navigate to fixture $fixture_abs" >&2
        exit 1
    }

    # Submit: if motion-prompt and generate-btn exist, type and click generate
    if "$bashy_bin" browser --mode "$b_mode" --json extract | jq -e '.data.elements[]? | select(.selector == "#generate-btn" or .selector == ".generate-btn")' >/dev/null 2>&1; then
        if "$bashy_bin" browser --mode "$b_mode" --json extract | jq -e '.data.elements[]? | select(.selector == "#motion-prompt")' >/dev/null 2>&1; then
            "$bashy_bin" browser --mode "$b_mode" type '#motion-prompt' "$prompt" >/dev/null || {
                echo "$PROG: failed step: type prompt in fixture" >&2
                exit 1
            }
        fi
        "$bashy_bin" browser --mode "$b_mode" click '#generate-btn' >/dev/null || {
            echo "$PROG: failed step: click generate button" >&2
            exit 1
        }
    fi

    # Wait: wait for video element or download link
    "$bashy_bin" browser --mode "$b_mode" wait-for-selector 'video#video-player, .preview-area video, a[download]' --timeout-ms 10000 --state visible >/dev/null || {
        echo "$PROG: failed step: wait for video completion" >&2
        exit 1
    }

    # Extract media URL
    media_url=$("$bashy_bin" browser --mode "$b_mode" --json eval '(() => {
        const v = document.querySelector("video#video-player, .preview-area video, video[src]");
        if (v && v.src) return v.src;
        const link = document.querySelector("a[download], a[href*=\".mp4\"]");
        if (link && link.href) return link.href;
        return "";
    })()' | jq -r '.data // empty')

    if [ -z "$media_url" ]; then
        echo "$PROG: failed step: extract video URL from completed fixture page" >&2
        exit 1
    fi

    # Download
    download_media "$media_url" "$out_file" || {
        echo "$PROG: failed step: download video artifact" >&2
        exit 1
    }

    # Verify
    verify_video "$out_file" || {
        echo "$PROG: failed step: video verification failed" >&2
        exit 1
    }

    cleanup_fixture_probe
    trap - EXIT INT TERM

    printf '{"schema_version":"bashy-svc-rod-v1","outputs":[{"path":"animate.mp4","media_type":"video/mp4"}],"text":"Kling animation via fixture: prompt=\\"%s\\""}\n' "$prompt"
    exit 0
fi

# Live mode execution
claim_held=0
cleanup_claim() {
    if [ "$claim_held" = 1 ]; then
        "$bashy_bin" claim release chrome-browser >/dev/null 2>&1 || true
        claim_held=0
    fi
}
trap cleanup_claim EXIT INT TERM

# Claim chrome-browser before any live-mode action
"$bashy_bin" claim chrome-browser --intent "$PROG: live Kling browser generation" || {
    echo "$PROG: failed step: claim chrome-browser" >&2
    exit 9
}
claim_held=1

# Check if a Kling tab is already open
kling_tab=$("$bashy_bin" browser --mode live --json tabs list 2>/dev/null | jq -r '.data[]? | select(.url | contains("klingai.com")) | .id' | head -n 1 || true)

if [ -n "$kling_tab" ]; then
    tab_arg=(--id "$kling_tab")
else
    "$bashy_bin" browser --mode live navigate "https://klingai.com" || {
        echo "$PROG: failed step: navigate to klingai.com" >&2
        exit 1
    }
    tab_arg=(--url "klingai.com")
fi

"$bashy_bin" browser --mode live "${tab_arg[@]}" type '#motion-prompt' "$prompt" || {
    echo "$PROG: failed step: type prompt into Kling input" >&2
    exit 1
}

# Submit generation in live browser
"$bashy_bin" browser --mode live "${tab_arg[@]}" click '#generate-btn, .generate-btn' || {
    echo "$PROG: failed step: click generate button" >&2
    exit 1
}

# Wait for video generation completion (bounded timeout)
"$bashy_bin" browser --mode live "${tab_arg[@]}" wait-for-selector 'video#video-player, .preview-area video, video[src], a[download*=".mp4"]' --timeout-ms 300000 --state visible || {
    echo "$PROG: failed step: wait for Kling video generation completion" >&2
    exit 1
}

# Extract generated video URL
media_url=$("$bashy_bin" browser --mode live "${tab_arg[@]}" --json eval '(() => {
    const v = document.querySelector("video#video-player, .preview-area video, video[src]");
    if (v && v.src) return v.src;
    const link = document.querySelector("a[download*=\".mp4\"], a[href*=\".mp4\"]");
    if (link && link.href) return link.href;
    return "";
})()' | jq -r '.data // empty')

if [ -z "$media_url" ]; then
    echo "$PROG: failed step: extract video URL from Kling page" >&2
    exit 1
fi

# Download the real artifact into BASHY_SVC_OUT
download_media "$media_url" "$out_file" || {
    echo "$PROG: failed step: download video artifact from Kling" >&2
    exit 1
}

# Check real artifact with ffprobe
verify_video "$out_file" || {
    echo "$PROG: failed step: verify downloaded video artifact" >&2
    exit 1
}

cleanup_claim
trap - EXIT INT TERM

printf '{"schema_version":"bashy-svc-rod-v1","outputs":[{"path":"animate.mp4","media_type":"video/mp4"}],"text":"Kling animation generated: prompt=\\"%s\\""}\n' "$prompt"
