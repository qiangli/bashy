#!/usr/bin/env -S bashy --bashsharp
# Measured: agy print mode invokes search_web and returns a grounded citation.
set -eu
if [ "${1:-}" = --json ]; then shift; fi
if [ "${1:-}" = --max ]; then max=${2:?maximum required}; shift 2; else max=8; fi
[ "$#" -gt 0 ] || { echo 'search-agy: query required' >&2; exit 2; }
exec agy -p "Search the web for: $*. Return up to $max source titles and URLs as markdown links. Do not answer from memory." --output-format stream-json --print-timeout 90s
