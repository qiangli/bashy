# Build and test the complete app from the candidate source revision.
set -eu
scratch="$(mktemp -d "$PWD/.check.XXXXXX")"
mkdir "$scratch/bin"
ln -s "$BASH" "$scratch/bin/bashy"
export TMPDIR="$scratch" PATH="$scratch/bin:$PATH"
export GOWORK=off
# The verifier may provision Go inside the scratch clone's home.
# Address the two app packages explicitly so Go never scans that SDK.
bashy go build -o "$scratch/out/" . ./checks/meshfixture
bashy go test . ./checks/meshfixture
