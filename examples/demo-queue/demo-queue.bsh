#!/usr/bin/env -S bashy --bashsharp
set -euo pipefail
here=$(cd -- "$(dirname -- "${BASH_SOURCE[0]}")" && pwd)
cd "$here"

case "${1:-help}" in
  build)
    mkdir -p .build
    output=".build/demo-queue$(go env GOEXE)"
    GOWORK=off CGO_ENABLED=0 go build -trimpath -o "$output" .
    printf 'Built %s\n' "$output"
    ;;
  test)
    GOWORK=off go test -race ./...
    ;;
  help|-h|--help)
    printf '%s\n' 'Usage: demo-queue.bsh build | test'
    ;;
  *) printf '%s\n' 'Unknown command. Run demo-queue.bsh --help.' >&2; exit 2 ;;
esac
