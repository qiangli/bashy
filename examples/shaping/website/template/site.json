{
  "site_url": "https://example.com",
  "title": "Example Person",
  "contact": "mailto:owner@example.com?subject=Access%20request",
  "sign_in": "/cloud/signin",
  "ai": {
    "base_url": "https://generativelanguage.googleapis.com/v1beta/openai",
    "model": "gemini-flash-lite-latest",
    "key_env": "SITE_AI_KEY",
    "daily_cap": 5,
    "daily_max": 50,
    "max_tokens": 900
  },
  "views": [
    {
      "name": "recruiter-summary",
      "title": "Recruiter summary",
      "prompt": "Write a one-page recruiter summary: a two-sentence headline, the strongest skills as bullets, the most relevant roles with years, and certifications. If contact details are among the facts, end with them; otherwise end with one line saying more details are shared on request.",
      "audience": {
        "signed_in": true
      }
    }
  ],
  "properties": {
    "theme": {
      "values": ["default", "dark", "light"],
      "class_prefix": "ss-theme-",
      "description": "Color scheme"
    },
    "text_size": {
      "values": ["default", "large", "larger"],
      "class_prefix": "ss-text-",
      "description": "Text size"
    },
    "density": {
      "values": ["default", "compact"],
      "class_prefix": "ss-density-",
      "description": "Spacing density"
    },
    "contrast": {
      "values": ["default", "high"],
      "class_prefix": "ss-contrast-",
      "description": "Contrast level"
    },
    "motion": {
      "values": ["default", "reduce"],
      "class_prefix": "ss-motion-",
      "description": "Motion preference"
    }
  },
  "wishes": [
    {"id": "dark", "label": "Dark", "patch": {"theme": "dark"}},
    {"id": "light", "label": "Light", "patch": {"theme": "light"}},
    {"id": "larger-text", "label": "Larger text", "patch": {"text_size": "large"}},
    {"id": "compact", "label": "Compact", "patch": {"density": "compact"}},
    {"id": "high-contrast", "label": "High contrast", "patch": {"contrast": "high"}},
    {"id": "reduce-motion", "label": "Reduce motion", "patch": {"motion": "reduce"}}
  ]
}
