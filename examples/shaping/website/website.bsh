#!/usr/bin/env -S bashy --bashsharp
# website: shaping-enable an existing website. The site stays where it is;
# a small shaping layer (its own shaped app, in a private companion repo)
# fronts it through outpost, injects a panel, and serves visitors by tier.
# One editable Bash# body for the website command and skill.
#
#   website assess URL
#   website enable DIR --site URL [--title T] [--contact URI]
#   website wishes ls DIR [--json]
#   website wishes add DIR --id ID --label LABEL --patch PROP=VAL [--patch ...] [--dry-run] [--json]
#   website wishes rm DIR --id ID [--dry-run] [--json]
#   website serve DIR [--name NAME] [--port PORT]
#   website register DIR [--name NAME]
#   website status [--name NAME]
#   website stop [--name NAME]
#
# Rod not fish: every action is one existing verb (curl, go build,
# outpost apps add/secret, bashy app add); this script only orders them.

~~~skill as guide
---
name: website
description: Shaping-enable an existing website (static host, e.g. GitHub Pages) at no cost. The site stays where it is; a shaping layer in a private companion repo fronts it through outpost as a cloudbox-public app, injects a panel, and serves visitors by tier (anonymous, signed-in, circle member, owner) with private fields gated by audience and generated views from a free OpenAI-compatible route. The executable body is this Bash# file; run it with bashy --bashsharp.
metadata:
  requires: "has=bashy"
---
# website — shaping-enable an existing site

Roles: the OWNER runs the shaping host (a free cloud workspace or their own
outpost machine) and owns the private companion repo. VISITORS reach the
site two ways: the static host, unchanged, and the engine face
(`/matrix/h/<host>/app/<name>/` on cloudbox), where the panel appears.

| Visitor | Gets | The site learns |
|---|---|---|
| anonymous | the page as today and a sign-in hint | nothing |
| signed-in, not a member | the views open to `signed_in` | a per-site pseudonym, never the email |
| member | also the fields whose audience admits their circle | email and circle |
| owner | everything | everything |

## The steps

1. `website assess URL` — is the site reachable, what generated it, does it
   use root-absolute links (rebased automatically), does it send a CSP.
2. `website enable DIR --site URL` — writes the shaping layer into DIR (the
   private companion repo): the Go server, `site.json`, `fields/`,
   `public/shaping.{js,css}`, `shaped.json`, `contract.bsh`, `checks/`.
   By default `site.json` includes declared personalization `properties`
   and a common `wishes` list (dark, light, larger text, compact, high
   contrast, reduce motion) that every visitor (including anonymous) can
   apply locally in `localStorage` with zero model calls.
   Edit `site.json` (title, contact, AI route, views, properties) and
   `fields/*.md` (one private fact each; `circles:` / `groups:` /
   `emails:` / `signed_in:` front matter; no audience = owner only).
   Manage the wish list with:
   - `website wishes ls DIR [--json]`
   - `website wishes add DIR --id ID --label LABEL --patch PROP=VAL [--json]`
     (refuses any entry outside `site.json`'s declared `properties`, fail-closed)
   - `website wishes rm DIR --id ID [--json]`
3. `website serve DIR --name NAME` — builds the server, registers the
   outpost app NAME (cloudbox public, trusted identity), reads its SSO
   secret, and runs it on loopback. Set the AI key first in the variable
   `site.json` names (`SITE_AI_KEY` by default) — any OpenAI-compatible
   route: a free API tier, or `bashy llm` on the owner's machine.
4. `website register DIR --name NAME` — registers the same repo as a shaped
   app so the owner shapes the layer with `bashy shape` (wish, verify,
   preview, approve); a running `serve` rebuilds from the approved revision
   and open pages reload automatically.
5. Put a plain link on the static site:
   `<a href="https://<cloudbox>/matrix/h/<host>/app/<name>/">Shape this page</a>`.

`website status` shows the server, the outpost app and the engine URL;
`website stop` stops the server (the static site is unaffected).

## Rules

- The site repo stays public and unchanged except for the link; private
  fields live only in the companion repo and never reach the static build.
- Visitors never code-shape the site; only the owner shapes, with
  `bashy shape` on the host.
- `--dry-run` anywhere prints the calls and runs none.
- `WEBSITE_OUTPOST_BIN` / `WEBSITE_BASHY_BIN` / `WEBSITE_GO_BIN` override the
  executables; `WEBSITE_STATE` the state dir (default `~/.bashy/website`).
~~~

set -e

PROG=website
DRY_RUN=0
JSON_OUT=0
NAME=site
PORT=18930

usage() {
    echo "Usage: $PROG assess URL" >&2
    echo "       $PROG enable DIR --site URL [--title T] [--contact URI]" >&2
    echo "       $PROG wishes ls DIR [--json]" >&2
    echo "       $PROG wishes add DIR [--id ID] --label LABEL --patch PROP=VAL [--patch ...] [--dry-run] [--json]" >&2
    echo "       $PROG wishes rm DIR (--id ID | ID) [--dry-run] [--json]" >&2
    echo "       $PROG serve DIR [--name NAME] [--port PORT] [--app APP] [--principal P]" >&2
    echo "       $PROG register DIR [--name NAME]" >&2
    echo "       $PROG status [--name NAME]" >&2
    echo "       $PROG stop [--name NAME]" >&2
    exit 2
}

fail() {
    if [ "$JSON_OUT" = 1 ]; then
        msg=$(printf '%s' "$1" | sed 's/\\/\\\\/g; s/"/\\"/g')
        printf '{"ok":false,"error":"%s"}\n' "$msg"
    else
        echo "$PROG: $1" >&2
    fi
    exit "${2:-1}"
}

outpost_bin() { printf '%s\n' "${WEBSITE_OUTPOST_BIN:-outpost}"; }
bashy_bin() { printf '%s\n' "${WEBSITE_BASHY_BIN:-bashy}"; }
go_bin() { printf '%s\n' "${WEBSITE_GO_BIN:-go}"; }
state_dir() { printf '%s\n' "${WEBSITE_STATE:-$HOME/.bashy/website}"; }

run() {
    if [ "$DRY_RUN" = 1 ]; then
        echo "would run: $*"
        return 0
    fi
    "$@"
}

template_dir() {
    t="$(dirname "$0")/template"
    [ -f "$t/main.go" ] || fail "template not found next to $0"
    printf '%s\n' "$t"
}

# json_safe refuses characters this script does not escape.
json_safe() {
    case "$1" in
        *'"'* | *'\'*) fail "value must not contain a quote or backslash: $1" ;;
    esac
}

cmd_assess() {
    url="$1"
    [ "${2:-}" = "--dry-run" ] && DRY_RUN=1
    [ -n "$url" ] || usage
    tmp="$(state_dir)/assess.html"
    run mkdir -p "$(state_dir)"
    if [ "$DRY_RUN" = 1 ]; then
        echo "would run: curl -fsSL -D - $url"
        return 0
    fi
    headers=$(curl -fsSL -D - -o "$tmp" "$url") || fail "cannot fetch $url"
    generator=unknown
    if LC_ALL=C grep -q '/_next/' "$tmp"; then generator=nextjs; fi
    if LC_ALL=C grep -qi 'name="generator" content="Hugo' "$tmp"; then generator=hugo; fi
    if LC_ALL=C grep -q '/assets/index-' "$tmp"; then generator=vite; fi
    rooted=$(LC_ALL=C grep -o '\(href\|src\)="/[^/]' "$tmp" | LC_ALL=C grep -c . || true)
    csp=no
    case "$headers" in
        *[Cc]ontent-[Ss]ecurity-[Pp]olicy*) csp=yes ;;
    esac
    echo "{\"url\":\"$url\",\"generator\":\"$generator\",\"root_absolute_links\":$rooted,\"csp\":\"$csp\",\"bytes\":$(wc -c <"$tmp" | tr -d ' ')}"
    echo "next: $PROG enable DIR --site $url" >&2
}

cmd_enable() {
    dir="$1"
    shift || true
    site="" title="My site" contact=""
    while [ $# -gt 0 ]; do
        case "$1" in
            --site) site="$2"; shift 2 ;;
            --title) title="$2"; shift 2 ;;
            --contact) contact="$2"; shift 2 ;;
            --dry-run) DRY_RUN=1; shift ;;
            *) usage ;;
        esac
    done
    [ -n "$dir" ] && [ -n "$site" ] || usage
    json_safe "$site"; json_safe "$title"; json_safe "$contact"
    t=$(template_dir)
    run mkdir -p "$dir"
    for f in go.mod main.go identity.go audience.go proxy.go view.go version.go exec_unix.go exec_windows.go main_test.go shaped.json contract.bsh; do
        if [ -e "$dir/$f" ]; then
            echo "keep: $f (exists)"
        else
            run cp "$t/$f" "$dir/$f"
        fi
    done
    for d in public checks fields .devcontainer; do
        if [ -e "$dir/$d" ]; then
            echo "keep: $d/ (exists)"
        else
            run cp -R "$t/$d" "$dir/$d"
        fi
    done
    run mkdir -p "$dir/bin"
    for f in "$0" "$(dirname "$0")/../../shaping-host/shaping-host.bsh"; do
        b=$(basename "$f")
        if [ -f "$f" ] && [ ! -e "$dir/bin/$b" ]; then
            run cp "$f" "$dir/bin/$b"
        fi
    done
    if [ -e "$dir/site.json" ]; then
        echo "keep: site.json (exists)"
    elif [ "$DRY_RUN" = 1 ]; then
        echo "would write: $dir/site.json (site_url $site)"
    else
        {
            echo '{'
            echo "  \"site_url\": \"$site\","
            echo "  \"title\": \"$title\","
            echo "  \"contact\": \"$contact\","
            echo '  "sign_in": "/cloud/signin",'
            echo '  "ai": {"base_url": "https://generativelanguage.googleapis.com/v1beta/openai", "model": "gemini-flash-lite-latest", "key_env": "SITE_AI_KEY", "daily_cap": 5, "daily_max": 50, "max_tokens": 900},'
            echo '  "views": [{"name": "recruiter-summary", "title": "Recruiter summary", "audience": {"signed_in": true},'
            echo '    "prompt": "Write a one-page recruiter summary: a two-sentence headline, the strongest skills as bullets, the most relevant roles with years, and certifications. If contact details are among the facts, end with them; otherwise end with one line saying more details are shared on request."}],'
            echo '  "properties": {'
            echo '    "theme": {"values": ["default", "dark", "light"], "class_prefix": "ss-theme-", "description": "Color scheme"},'
            echo '    "text_size": {"values": ["default", "large", "larger"], "class_prefix": "ss-text-", "description": "Text size"},'
            echo '    "density": {"values": ["default", "compact"], "class_prefix": "ss-density-", "description": "Spacing density"},'
            echo '    "contrast": {"values": ["default", "high"], "class_prefix": "ss-contrast-", "description": "Contrast level"},'
            echo '    "motion": {"values": ["default", "reduce"], "class_prefix": "ss-motion-", "description": "Motion preference"}'
            echo '  },'
            echo '  "wishes": ['
            echo '    {"id": "dark", "label": "Dark", "patch": {"theme": "dark"}},'
            echo '    {"id": "light", "label": "Light", "patch": {"theme": "light"}},'
            echo '    {"id": "larger-text", "label": "Larger text", "patch": {"text_size": "large"}},'
            echo '    {"id": "compact", "label": "Compact", "patch": {"density": "compact"}},'
            echo '    {"id": "high-contrast", "label": "High contrast", "patch": {"contrast": "high"}},'
            echo '    {"id": "reduce-motion", "label": "Reduce motion", "patch": {"motion": "reduce"}}'
            echo '  ]'
            echo '}'
        } >"$dir/site.json"
    fi
    if [ ! -d "$dir/.git" ]; then
        run git -C "$dir" init -q
    fi
    if [ ! -e "$dir/.gitignore" ] && [ "$DRY_RUN" = 0 ]; then
        printf '.build/\n' >"$dir/.gitignore"
    fi
    echo "enabled: $dir — edit site.json and fields/*.md (they are private: keep this repo private), then: $PROG serve $dir --name NAME"
}

# Codespaces injects user secrets into the container's own startup and
# terminals, but not into every session (an ssh session has none); read a
# missing one from the shared secrets file. Values are never printed.
load_codespace_secrets() {
    f=/workspaces/.codespaces/shared/user-secrets-envs.json
    [ -f "$f" ] || return 0
    for v in "$@"; do
        eval "cur=\${$v:-}"
        [ -n "$cur" ] && continue
        val=$(python3 -c 'import json,sys; print(json.load(open(sys.argv[1])).get(sys.argv[2], ""))' "$f" "$v" 2>/dev/null) || continue
        if [ -n "$val" ]; then
            export "$v=$val"
        fi
    done
}

have_pkill() { command -v pkill >/dev/null 2>&1; }

app_secret() {
    "$(outpost_bin)" apps secret "$1" 2>/dev/null || true
}

read_active_rev() {
    [ -f "$1" ] || return 1
    while IFS= read -r line || [ -n "$line" ]; do
        case "$line" in
            *'"active_revision"'*)
                rest=${line#*'"active_revision"'}
                rest=${rest#*'"'}
                rev=${rest%%'"'*}
                if [ -n "$rev" ]; then
                    printf '%s\n' "$rev"
                    return 0
                fi
                ;;
        esac
    done <"$1"
    return 1
}

# encode_state_component mirrors the shape state store's path encoding:
# [A-Za-z0-9._-] kept, every other byte as %XX.
encode_state_component() {
    LC_ALL=C
    v="$1"
    out=""
    while [ -n "$v" ]; do
        c="${v%"${v#?}"}"
        v="${v#?}"
        case "$c" in
            [A-Za-z0-9._-]) out="$out$c" ;;
            *) out="$out$(printf '%%%02X' "'$c")" ;;
        esac
    done
    printf '%s' "$out"
}

find_active_revision() {
    shome="$1"
    apps_csv="$2"
    principal="$3"
    old_ifs=$IFS
    IFS=,
    for app in $apps_csv; do
        [ -n "$app" ] || continue
        [ -d "$shome/src/$app" ] || continue
        if [ -n "$principal" ]; then
            enc=$(encode_state_component "$principal")
            if [ -f "$shome/shape/$app/$enc/state.json" ]; then
                rev=$(read_active_rev "$shome/shape/$app/$enc/state.json") || rev=""
                if [ -n "$rev" ]; then
                    IFS=$old_ifs
                    printf '%s\t%s\n' "$app" "$rev"
                    return 0
                fi
            fi
            continue
        fi
        # Only the owner's line is public: no newest-of-any-principal scan.
    done
    IFS=$old_ifs
    return 1
}

cmd_serve() {
    load_codespace_secrets SITE_AI_KEY
    dir="$1"
    shift || true
    shape_app=""
    shape_principal="${BASHY_PRINCIPAL:-}"
    while [ $# -gt 0 ]; do
        case "$1" in
            --name) NAME="$2"; shift 2 ;;
            --port) PORT="$2"; shift 2 ;;
            --app) shape_app="$2"; shift 2 ;;
            --principal) shape_principal="$2"; shift 2 ;;
            --dry-run) DRY_RUN=1; shift ;;
            *) usage ;;
        esac
    done
    [ -n "$dir" ] && [ -f "$dir/site.json" ] || fail "no shaping layer in '$dir' (run: $PROG enable DIR --site URL)"
    [ -n "$shape_app" ] || shape_app="$NAME-shaping,$NAME"
    shape_home="${BASHY_HOME:-$HOME/.bashy}"
    st=$(state_dir)
    run mkdir -p "$st" "$dir/.build"
    site_version=""
    built_from_active=0
    if [ "$DRY_RUN" = 0 ]; then
        if active_info=$(find_active_revision "$shape_home" "$shape_app" "$shape_principal"); then
            active_app=${active_info%%	*}
            active_rev=${active_info#*	}
            abs_out="$(cd "$dir" && pwd)/.build/site-shaping"
            tmp_src="$st/.build-$NAME-$$"
            rm -rf "$tmp_src"
            mkdir -p "$tmp_src"
            if env git -c "safe.directory=*" -C "$shape_home/src/$active_app" archive "$active_rev" | tar -x -f - -C "$tmp_src"; then
                env GOWORK=off CGO_ENABLED=0 "$(go_bin)" -C "$tmp_src" build -trimpath -o "$abs_out" . || { rm -rf "$tmp_src"; fail "failed to build active revision $active_rev"; }
                rm -rf "$tmp_src"
                site_version="$active_rev"
                built_from_active=1
            else
                rm -rf "$tmp_src"
            fi
        fi
    fi
    if [ "$built_from_active" = 0 ]; then
        run env GOWORK=off CGO_ENABLED=0 "$(go_bin)" -C "$dir" build -trimpath -o .build/site-shaping .
        if [ "$DRY_RUN" = 0 ] && [ -d "$dir/.git" ]; then
            site_version=$(env git -c "safe.directory=*" -C "$dir" rev-parse --verify HEAD 2>/dev/null || true)
        fi
    fi
    if [ "$DRY_RUN" = 1 ]; then
        echo "would run: $(outpost_bin) apps add $NAME --port $PORT --trust-cloud-identity"
    else
        # The daemon may be restarting (an attach restarts it): retry briefly.
        n=0
        until "$(outpost_bin)" apps add "$NAME" --port "$PORT" --trust-cloud-identity; do
            n=$((n + 1))
            [ "$n" -lt 20 ] || fail "outpost did not accept the app (is the daemon running? outpost start)"
            sleep 3
        done
    fi
    if [ "$DRY_RUN" = 1 ]; then
        echo "would run: $dir/.build/site-shaping -addr 127.0.0.1:$PORT (SITE_SSO_SECRET from outpost apps secret $NAME)"
        return 0
    fi
    secret=$(app_secret "$NAME")
    [ -n "$secret" ] || echo "$PROG: warning: no SSO secret for $NAME; every visitor will be anonymous" >&2
    cmd_stop_quiet
    # Its own session, so it outlives the shell (or ssh session) that started it.
    if command -v setsid >/dev/null 2>&1; then
        SITE_SSO_SECRET="$secret" SITE_SHAPE_APP="$shape_app" SITE_SHAPE_HOME="$shape_home" SITE_SHAPE_PRINCIPAL="$shape_principal" SITE_GO_BIN="$(go_bin)" SITE_VERSION="$site_version" setsid nohup "$dir/.build/site-shaping" -addr "127.0.0.1:$PORT" >"$st/$NAME.log" 2>&1 </dev/null &
    else
        SITE_SSO_SECRET="$secret" SITE_SHAPE_APP="$shape_app" SITE_SHAPE_HOME="$shape_home" SITE_SHAPE_PRINCIPAL="$shape_principal" SITE_GO_BIN="$(go_bin)" SITE_VERSION="$site_version" nohup "$dir/.build/site-shaping" -addr "127.0.0.1:$PORT" >"$st/$NAME.log" 2>&1 </dev/null &
    fi
    echo $! >"$st/$NAME.pid"
    echo "$PORT" >"$st/$NAME.port"
    echo "serving: $NAME on 127.0.0.1:$PORT (pid $(cat "$st/$NAME.pid"), log $st/$NAME.log)"
    echo "engine face: https://<cloudbox>/matrix/h/<this host>/app/$NAME/ — link it from the static site"
}

cmd_stop_quiet() {
    pidf="$(state_dir)/$NAME.pid"
    if [ -f "$pidf" ]; then
        kill "$(cat "$pidf")" 2>/dev/null || true
        rm -f "$pidf"
    fi
    # The recorded pid may be a wrapper's: also stop whatever holds the port.
    portf="$(state_dir)/$NAME.port"
    if [ -f "$portf" ] && have_pkill; then
        # [s]: the pattern must not match a wrapper's own command line.
        pkill -f "[s]ite-shaping -addr 127.0.0.1:$(cat "$portf")" 2>/dev/null || true
    fi
}

cmd_stop() {
    while [ $# -gt 0 ]; do
        case "$1" in
            --name) NAME="$2"; shift 2 ;;
            --dry-run) DRY_RUN=1; shift ;;
            *) usage ;;
        esac
    done
    if [ "$DRY_RUN" = 1 ]; then
        echo "would stop: $NAME"
        return 0
    fi
    cmd_stop_quiet
    echo "stopped: $NAME (the static site is unaffected)"
}

cmd_register() {
    dir="$1"
    shift || true
    while [ $# -gt 0 ]; do
        case "$1" in
            --name) NAME="$2"; shift 2 ;;
            --dry-run) DRY_RUN=1; shift ;;
            *) usage ;;
        esac
    done
    [ -n "$dir" ] && [ -f "$dir/shaped.json" ] || fail "no shaped app in '$dir'"
    run "$(bashy_bin)" app add "$NAME-shaping" --type shaped --source "$(cd "$dir" && pwd)" --label "Shaping layer for $NAME"
    echo "next: bashy shape wish $NAME-shaping \"...\"; after approving, the running site rebuilds and open pages reload automatically"
}

cmd_status() {
    while [ $# -gt 0 ]; do
        case "$1" in
            --name) NAME="$2"; shift 2 ;;
            --dry-run) DRY_RUN=1; shift ;;
            *) usage ;;
        esac
    done
    pidf="$(state_dir)/$NAME.pid"
    running=no
    # The pid may be a wrapper's; the server answering on its port is the truth.
    portf="$(state_dir)/$NAME.port"
    if [ -f "$portf" ] && curl -fs -m 5 -o /dev/null "http://127.0.0.1:$(cat "$portf")/_shaping/api/me"; then
        running=yes
    elif [ -f "$pidf" ] && kill -0 "$(cat "$pidf")" 2>/dev/null; then
        running=yes
    fi
    secret=no
    if [ -n "$(app_secret "$NAME")" ]; then secret=yes; fi
    echo "{\"name\":\"$NAME\",\"server_running\":\"$running\",\"sso_secret\":\"$secret\",\"log\":\"$(state_dir)/$NAME.log\"}"
}

cmd_wishes() {
    sub="${1:-}"
    [ -n "$sub" ] || usage
    shift
    case "$sub" in
        ls | add | rm) ;;
        *) usage ;;
    esac
    dir="" id="" label=""
    set -- "$@"
    # Collect patch args separately by rebuilding positional args after flags.
    patch_count=0
    dir_set=0
    while [ $# -gt 0 ]; do
        case "$1" in
            --json) JSON_OUT=1; shift ;;
            --dry-run) DRY_RUN=1; shift ;;
            --id)
                [ $# -ge 2 ] || fail "--id requires a value" 2
                id="$2"; shift 2 ;;
            --label)
                [ $# -ge 2 ] || fail "--label requires a value" 2
                label="$2"; shift 2 ;;
            --patch)
                [ $# -ge 2 ] || fail "--patch requires a value" 2
                patch_count=$((patch_count + 1))
                eval "patch_${patch_count}=\$2"
                shift 2 ;;
            -*)
                usage ;;
            *)
                if [ "$dir_set" = 0 ]; then
                    dir="$1"
                    dir_set=1
                elif [ "$sub" = "rm" ] && [ -z "$id" ]; then
                    id="$1"
                else
                    usage
                fi
                shift ;;
        esac
    done
    [ -n "$dir" ] || usage
    site_json="$dir/site.json"
    [ -f "$site_json" ] || fail "no shaping layer in '$dir' (run: $PROG enable DIR --site URL)"
    command -v python3 >/dev/null 2>&1 || fail "python3 is required for wishes"

    set -- "$sub" "$site_json" "$JSON_OUT" "$DRY_RUN" "$id" "$label"
    i=1
    while [ "$i" -le "$patch_count" ]; do
        eval "p=\$patch_${i}"
        set -- "$@" "$p"
        i=$((i + 1))
    done

    python3 - "$@" <<'PY'
import json
import os
import re
import sys

sub, site_json, json_out_s, dry_run_s, wish_id, wish_label = sys.argv[1:7]
patch_args = sys.argv[7:]
json_out = json_out_s == "1"
dry_run = dry_run_s == "1"

def err(msg, code=1):
    if json_out:
        print(json.dumps({"ok": False, "error": msg}))
    else:
        print(f"website: {msg}", file=sys.stderr)
    sys.exit(code)

try:
    with open(site_json, "r", encoding="utf-8") as f:
        data = json.load(f)
except Exception as exc:
    err(f"cannot read {site_json}: {exc}")

if not isinstance(data, dict):
    err(f"invalid {site_json}: expected JSON object")

props = data.get("properties")
if props is None:
    props = {}
if not isinstance(props, dict):
    err("invalid site.json: properties must be an object")

wishes = data.get("wishes")
if wishes is None:
    wishes = []
if not isinstance(wishes, list):
    err("invalid site.json: wishes must be an array")

def write_atomic(obj):
    parent = os.path.dirname(os.path.abspath(site_json)) or "."
    tmp = os.path.join(parent, f".site.json.tmp.{os.getpid()}")
    with open(tmp, "w", encoding="utf-8") as f:
        json.dump(obj, f, indent=2)
        f.write("\n")
    os.replace(tmp, site_json)

if sub == "ls":
    if json_out:
        print(json.dumps({"ok": True, "properties": props, "wishes": wishes}))
    else:
        if not wishes:
            print("(no wishes)")
        for w in wishes:
            p = w.get("patch") or {}
            patch_str = ", ".join(f"{k}={p[k]}" for k in sorted(p))
            print(f"{w.get('id', '')}\t{w.get('label', '')}\t{patch_str}")
        declared = ", ".join(sorted(props.keys())) if props else "none"
        print(f"declared properties: {declared}")
    sys.exit(0)

if sub == "add":
    if not patch_args:
        err("at least one --patch PROPERTY=VALUE is required", 2)
    patch = {}
    for raw in patch_args:
        s = raw.strip()
        if s.startswith("{"):
            try:
                parsed = json.loads(s)
            except Exception as exc:
                err(f"invalid --patch JSON: {exc}", 2)
            if not isinstance(parsed, dict) or not parsed:
                err("invalid --patch JSON: expected non-empty object", 2)
            for k, v in parsed.items():
                if not isinstance(k, str) or not k.strip() or not isinstance(v, str) or v == "":
                    err(f"invalid --patch entry for property {k!r}: values must be non-empty strings", 2)
                patch[k.strip()] = v
        elif "=" in raw:
            k, v = raw.split("=", 1)
            k = k.strip()
            if not k or v == "":
                err("invalid --patch: expected PROPERTY=VALUE", 2)
            patch[k] = v
        else:
            err("invalid --patch: expected PROPERTY=VALUE or JSON object", 2)

    if not wish_id:
        wish_id = re.sub(r"[^a-z0-9]+", "-", wish_label.lower()).strip("-")
    if not wish_label:
        wish_label = wish_id
    if not wish_id or not wish_label:
        err("--id or --label is required", 2)

    for existing in wishes:
        if isinstance(existing, dict) and existing.get("id") == wish_id:
            err(f"wish {wish_id!r} already exists")

    declared_list = ", ".join(sorted(props.keys())) if props else "none"
    for k in sorted(patch.keys()):
        if k not in props:
            err(f"refused: property {k!r} is not in declared properties (declared: {declared_list})")
        spec = props[k]
        allowed = spec.get("values") if isinstance(spec, dict) else None
        if not isinstance(allowed, list) or len(allowed) == 0 or patch[k] not in allowed:
            allowed_str = ", ".join(str(x) for x in allowed) if isinstance(allowed, list) and allowed else "none"
            err(f"refused: value {patch[k]!r} is not allowed for property {k!r} (allowed: {allowed_str})")

    entry = {"id": wish_id, "label": wish_label, "patch": patch}
    new_wishes = list(wishes) + [entry]
    if not dry_run:
        data["wishes"] = new_wishes
        write_atomic(data)

    if json_out:
        out = {"ok": True, "added": entry, "wishes": new_wishes}
        if dry_run:
            out["dry_run"] = True
        print(json.dumps(out))
    else:
        verb_word = "would add" if dry_run else "added"
        print(f"{verb_word}: {wish_id} ({wish_label})")
    sys.exit(0)

if sub == "rm":
    if not wish_id:
        err("--id is required", 2)
    kept = [w for w in wishes if not (isinstance(w, dict) and w.get("id") == wish_id)]
    if len(kept) == len(wishes):
        err(f"wish {wish_id!r} not found")
    if not dry_run:
        data["wishes"] = kept
        write_atomic(data)
    if json_out:
        out = {"ok": True, "removed": wish_id, "wishes": kept}
        if dry_run:
            out["dry_run"] = True
        print(json.dumps(out))
    else:
        verb_word = "would remove" if dry_run else "removed"
        print(f"{verb_word}: {wish_id}")
    sys.exit(0)
PY
}

while [ "${1:-}" = "--dry-run" ]; do
    DRY_RUN=1
    shift
done
[ $# -gt 0 ] || usage
verb="$1"
shift
case "$verb" in
    assess) cmd_assess "$@" ;;
    enable) cmd_enable "$@" ;;
    wishes) cmd_wishes "$@" ;;
    serve) cmd_serve "$@" ;;
    register) cmd_register "$@" ;;
    status) cmd_status "$@" ;;
    stop) cmd_stop "$@" ;;
    -h | --help | help) usage ;;
    *) usage ;;
esac
