#!/usr/bin/env -S bashy --bashsharp
# One body, two orientations: executable Bash# and its embedded agent skill.
# Verbs dispatch to stdlib Python modules in lib/ (one module per story) and a
# Go stdlib server in server/. tutor composes plain bashy commands only.

~~~skill as guide
---
name: tutor
description: Plan and run an AI-guided, timeboxed session (group sessions, meetings or solo work) on a bashy sprint card - editable format, timed steps owned by people, one-line status for chat, hints that never give answers.
metadata:
  requires: "has=bashy"
  step-porota: 'bashy tutor status "${TUTOR_SPRINT:?set TUTOR_SPRINT}" --json'
  check-tests: 'bashy tutor status "${TUTOR_SPRINT:?set TUTOR_SPRINT}" --json'
---
# Tutor

A session is a sprint card; each step is a todo owned by a person, labelled
`step-NN`, `timebox-Nm` and `role-WORD`. The session clock is
the sprint's own clock (`bashy sprint start N --owner AGENT --for 90m`, `extend`, `stop`);
tutor reads that clock, falling back to the run log from `tutor start --for`.
Starting requires an explicit manager agent; without one, planning, applying,
next/done, status and fallback hints still work, and start reports a clean error.

Start a session like a coding sprint:
`bashy sprint start N --owner AGENT --for 90m --instruction "run today's session with the tutor skill"`.
People never close sprint stories: `tutor done` records a run-log done event
and labels the todo `step-done`. At the end the session manager (the owner's
agent) runs `bashy sprint accept N ID -m EVIDENCE` for each done step.
Participant progress counts participant steps; owner steps remain in `steps[]`.
Set `TUTOR_SPRINT=N` then `bashy skill run tutor --json` to attest status
through the registered command. No default sprint is silently selected.

- `bashy tutor plan "GOAL" --minutes 90 [--people a,b] [--format F] [--agent A]`
  prints an editable JSON draft. With no agent it splits the format's
  template. Edit the draft, then `bashy tutor apply DRAFT` creates the card,
  the people and the steps.
- `bashy tutor next N`, `done N STEP [-m EVIDENCE]`, `extend N STEP --by 5m`
  move people through steps; `status N --json|--line` reports the current step,
  time left and overdue flags. `--line` is one line for a chat header.
- `bashy tutor nudge N [--person P]` asks that person's own agent for a hint or
  a question about the current step. Hints only: the tutor never does the work.
- `bashy tutor render STEP --edition ROLE|owner|shared` prints one edition of a
  content item; `~~~private` is owner-only, `~~~private ROLE...` also grants
  named roles access. The shared edition excludes every private block.
- `bashy tutor serve N` / `join URL` / `stop` run the display and per-participant
  pages. `bashy tutor prep DIR [--from PATH]` shapes a content dir before a session.

Compose, don't couple: `examples/tutor/chat-status.sh N CONFIG GROUP` pipes
`status --line` to `bashy klatch topic CONFIG GROUP -` and posts on step change.
Formats are editable Markdown (`formats/session.md`); copy one to make your own
session, meeting or solo format. This is Software Shaping: edit phases, pairing,
timeboxes, tools, tone and owner steps, then plan with `--format PATH`.
Render the same source with `--edition owner` for preparation and
`--edition shared` for sharing; owner-only notes stay out of participant output.
~~~

set -euo pipefail
export BASHY_HINTS=off
here=$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)
usage='Usage: tutor plan|apply|start|next|done|extend|status|nudge|render|prep|serve|join|stop|test [ARGS] [--json]'
# Registered schemas canonicalize flags before positionals as --name=value.
# Restore the verb-first argv expected by the shared Python dispatchers.
bound_flags=()
while [[ ${1:-} == --*=* ]]; do
  case $1 in
    --json=true|--line=true|--help=true) bound_flags+=("${1%=true}") ;;
    --json=false|--line=false|--help=false) ;;
    *) bound_flags+=("$1") ;;
  esac
  shift
done
if (( ${#bound_flags[@]} )); then set -- "$@" "${bound_flags[@]}"; fi
case ${1:-} in
--skill)
  copying=false
  while IFS= read -r line; do
    if [[ $line == '~~~skill as guide' ]]; then copying=true; continue; fi
    if [[ $copying == true && $line == '~~~' ]]; then break; fi
    if [[ $copying == true ]]; then printf '%s\n' "$line"; fi
  done < "${BASH_SOURCE[0]}"
  ;;
--contract) echo 'sokilili tutoro efefecato reada wurite neto fini sotepo porota porota fini enisure gereeni fini fini' ;;
''|-h|--help) echo "$usage" ;;
plan|apply)                   exec python3 "$here/lib/plan.py" "$@" ;;
start|next|done|extend|status) exec python3 "$here/lib/run.py" "$@" ;;
nudge)                        exec python3 "$here/lib/nudge.py" "$@" ;;
render)                       exec python3 "$here/lib/render.py" "$@" ;;
prep)                         exec python3 "$here/lib/prep.py" "$@" ;;
join)
  # The command registry expands -m to --message; Go join accepts only -m.
  join_args=()
  for arg in "$@"; do
    case $arg in
      --message=*) join_args+=(-m "${arg#--message=}") ;;
      --message)   join_args+=(-m) ;;
      *)           join_args+=("$arg") ;;
    esac
  done
  exec bash "$here/server/run.sh" "${join_args[@]}"
  ;;
serve|stop)                   exec bash "$here/server/run.sh" "$@" ;;
test)
  cd "$here"
  python3 -m unittest discover -s tests -t . -v
  if [[ -f server/go.mod ]]; then (cd server && GOWORK=off go test -race ./...); fi
  ;;
*) echo "$usage" >&2; exit 2 ;;
esac
