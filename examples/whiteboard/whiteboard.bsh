#!/usr/bin/env -S bashy --bashsharp
set -euo pipefail

here=$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)
runner=${BASHY_BIN:-bashy}
git_bin=${WHITEBOARD_GIT_BIN:-/usr/bin/git}
pin=a2ec2889babf7d2295469c6d90ebe77fae57df84
fork=https://github.com/qiangli/excalidraw-shape.git
home=${BASHY_HOME:-$HOME/.bashy}
state=$home/whiteboard
source=$state/source
port=${WHITEBOARD_CONSOLE_PORT:-22752}

usage() {
  cat <<'EOF'
whiteboard install|start|stop|status|source
  install  Fetch the pinned MIT source, build the web UI, and register a shaped app.
  start    Run the local app console in the foreground; the whiteboard server starts on first request.
  stop     Stop the console started by this command.
  status   Show the managed console and source revision.
  source   Print the managed source directory.

whiteboard boards [--json]
whiteboard new [NAME] [--note TEXT]
whiteboard show ID
whiteboard set ID --note TEXT
whiteboard lock ID
whiteboard rm ID
whiteboard share ID
whiteboard save --file PATH
whiteboard load SCENE-ID [--output PATH]
whiteboard upload PATH --file LOCAL
whiteboard download PATH [--output LOCAL]
whiteboard export ID [--format json] [--scene SCENE-ID] [--output PATH]
  Data verbs require Python 3.9+, WHITEBOARD_URL (numeric loopback URL including port
  and optional app proxy prefix), sent to the running local whiteboard service.
  --url overrides WHITEBOARD_URL. The local service has no per-board credential:
  loopback reachability plus the paired console is the access boundary, exactly as
  on the page; WHITEBOARD_TOKEN, when set, is sent as the app Bearer [REDACTED] and
  ignored by the service. No identity or credential is created or saved.
  All data verbs accept --json; writes accept --dry-run.
  Dry-run prints a request manifest without contacting the app or reading a file.
  A missing board is a not_found denial naming the board, as on the page.
  export --format png|svg is refused: PNG/SVG export is a browser canvas render
  with no server API; --format json exports the board record (plus --scene bytes).
  Freehand drawing, shapes, text, move/resize, clear, zoom/pan/grid/theme are
  page-only canvas interactions with no server API and have no verb.

The shared whiteboard is local. Install needs the network. To enable owner-owned
observability, set OTEL_EXPORTER_OTLP_ENDPOINT for the console's bashy OTel.
EOF
}

installed() {
  test -f "$source/.whiteboard-source-pin" &&
    test "$(cat "$source/.whiteboard-source-pin")" = "$pin" &&
    test -s "$source/excalidraw-app/build/index.html" &&
    test -f "$source/shaped.json"
}

register_app() {
  "$runner" app add whiteboard --type shaped --source "$source" --label Whiteboard \
    --icon '🎨' --tip 'A personal whiteboard with a shapeable web UI'
}

install() {
  if installed; then
    register_app
    return
  fi
  if test -e "$source"; then
    echo 'whiteboard: source exists but does not match the pinned build; inspect it manually' >&2
    exit 1
  fi
  test -x "$git_bin" || command -v "$git_bin" >/dev/null
  command -v go >/dev/null
  command -v yarn >/dev/null
  command -v node >/dev/null
  mkdir -p "$state"
  scratch=$(mktemp -d "$state/install.XXXXXX")
  trap 'rm -rf "$scratch"' EXIT
  "$git_bin" clone --quiet "$fork" "$scratch/source"
  "$git_bin" -C "$scratch/source" switch --quiet -c shape-whiteboard "$pin"
  if ! head -n 1 "$scratch/source/LICENSE" | grep -qx 'MIT License'; then
    echo 'whiteboard: pinned source is not MIT licensed' >&2
    exit 1
  fi
  if find "$scratch/source" -type d \( -name ee -o -name premium -o -name enterprise \) -print | grep -q .; then
    echo 'whiteboard: non-permissive source directory found' >&2
    exit 1
  fi
  echo "ignore-engines true" >> "$scratch/source/.yarnrc"
  echo "ignore-engines true" >> "$scratch/source/excalidraw-app/.yarnrc"
  "$git_bin" -C "$scratch/source" apply --unidiff-zero "$here/web-prefix.patch"
  (cd "$scratch/source" && yarn install --frozen-lockfile --ignore-engines && yarn build:app)
  rm -rf "$scratch/source/node_modules" "$scratch/source/excalidraw-app/node_modules" "$scratch/source/packages"/*/node_modules
  printf '\n!excalidraw-app/build/\n!excalidraw-app/build/**\n' >> "$scratch/source/.gitignore"
  cp "$here/shaped.json" "$scratch/source/shaped.json"
  cp "$here/contract.bsh" "$scratch/source/contract.bsh"
  mkdir -p "$scratch/source/checks" "$scratch/source/server"
  cp "$here/checks/whiteboard.bsh" "$scratch/source/checks/whiteboard.bsh"
  cp "$here/server/"*.go "$scratch/source/server/"
  cp "$here/server/go.mod" "$scratch/source/server/"
  printf '%s\n' "$pin" > "$scratch/source/.whiteboard-source-pin"
  "$git_bin" -C "$scratch/source" add -f excalidraw-app/build
  "$git_bin" -C "$scratch/source" add .gitignore .yarnrc excalidraw-app/.yarnrc shaped.json contract.bsh \
    checks/whiteboard.bsh server/ .whiteboard-source-pin \
    .env.production excalidraw-app/bug-issue-template.js excalidraw-app/components/TopErrorBoundary.tsx \
    excalidraw-app/index.html excalidraw-app/index.tsx excalidraw-app/package.json excalidraw-app/vite.config.mts
  "$git_bin" -C "$scratch/source" rm -f --ignore-unmatch .github/workflows/sentry-production.yml excalidraw-app/sentry.ts
  "$git_bin" -C "$scratch/source" -c user.name='Bashy Whiteboard' -c user.email='whiteboard@example.invalid' \
    commit -qm 'Add per-principal shaping adapter' \
    -m 'Sprint: #631' -m 'Story: #211' -m 'Story-ID: 9bc0dd7f28a1' -m 'Agent: agy-gemini3.8-flash'
  mv "$scratch/source" "$source"
  register_app
}

running_pid() {
  test -f "$state/console.pid" || return 1
  pid=$(cat "$state/console.pid")
  case "$pid" in *[!0-9]*|'') return 1;; esac
  kill -0 "$pid" 2>/dev/null || return 1
  cmdline=$(ps -p "$pid" -o args= 2>/dev/null) || return 1
  case "$cmdline" in *"app serve --bind lan --port $port --pair"*) ;; *) return 1 ;; esac
  printf '%s\n' "$pid"
}

case ${1:---help} in
  -h|--help|help) usage ;;
  boards|new|show|set|lock|rm|share|save|load|upload|download|export)
    exec python3 "$here/whiteboard_api.py" "$@"
    ;;
  install) install ;;
  start)
    installed || { echo 'whiteboard: run whiteboard install first' >&2; exit 1; }
    if running_pid >/dev/null; then echo "whiteboard: console already running on port $port"; exit 0; fi
    if test -n "${OTEL_EXPORTER_OTLP_ENDPOINT:-}"; then
      (umask 077; printf '%s\n' "$OTEL_EXPORTER_OTLP_ENDPOINT" > "$state/otel-endpoint")
    else
      rm -f "$state/otel-endpoint"
    fi
    echo "whiteboard: paired console starting on port $port; run bashy app pair --allow whiteboard --principal NAME --port $port"
    "$runner" app serve --bind lan --port "$port" --pair &
    pid=$!
    echo "$pid" > "$state/console.pid"
    wait "$pid" || result=$?
    rm -f "$state/console.pid"
    exit "${result:-0}"
    ;;
  stop)
    if pid=$(running_pid); then
      kill "$pid"
      rm -f "$state/console.pid"
      echo 'whiteboard: console stopped'
    else
      echo 'whiteboard: console is not running'
    fi
    ;;
  status)
    if installed; then echo "whiteboard: source pin $pin"; else echo 'whiteboard: not installed'; fi
    if running_pid >/dev/null; then echo "whiteboard: console running on port $port"; else echo 'whiteboard: console stopped'; fi
    ;;
  source)
    if ! installed; then echo 'whiteboard: run whiteboard install first' >&2; exit 1; fi
    printf '%s\n' "$source"
    ;;
  *) usage >&2; exit 2 ;;
esac
