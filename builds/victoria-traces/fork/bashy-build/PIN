# bashy verified build declaration for victoria-traces (builds/README.md).
# Shell-sourceable KEY=VALUE only. builds/render.sh renders ../fork from this
# file + files/ + builds/_shared, and ships it verbatim as the fork's
# bashy-build/PIN. The workflow refuses to build unless the checked-out
# upstream tag resolves to UPSTREAM_COMMIT and the bashy tag is
# bashy-${UPSTREAM_TAG}-N.
#
# The pin is the release yoke runs today: external/otel/stack/execstore.go
# victoriaTracesVersion. Upstream LICENSE at this tag: Apache-2.0.
TOOL=victoria-traces
FORK_REPO=qiangli/victoria-traces
UPSTREAM_REPO=https://github.com/VictoriaMetrics/VictoriaTraces
UPSTREAM_SLUG=VictoriaMetrics/VictoriaTraces
UPSTREAM_TAG=v0.9.4
# Annotated tag object 8d4eb497f6b6128aea98be8462719d2ce7882850 -> this commit.
UPSTREAM_COMMIT=f96aa3dd58fc2ef7711806ff4371d829a4a00471
# Toolchain kind: build/audit job steps come from builds/_shared/kinds/go.
KIND=go
# Must equal the go/toolchain directive in the tag's go.mod (setup.yml gates it).
GO_TOOLCHAIN=1.26.4
GOVULNCHECK_VERSION=v1.9.0
GO_SBOM_VERSION=v1.12.0
GO_PACKAGE=./app/victoria-traces
# Version stamp only — upstream's own -ldflags also embed a build DATE and a
# `git describe`, which is exactly what a reproducible build must not do.
GO_LDFLAGS="-X github.com/VictoriaMetrics/VictoriaMetrics/lib/buildinfo.Version=victoria-traces-$UPSTREAM_TAG"
GO_BUILD_TAGS=""
GO_BUILD_FLAGS=""
GO_BUILD_ENV=""
GO_VERSION_ARG=-version
COSIGN_VERSION=v3.1.3
# Build matrix: ASSET=RUNNER; each leg uploads out/ASSET.
MATRIX="victoria-traces-linux-amd64=ubuntu-24.04 victoria-traces-linux-arm64=ubuntu-24.04-arm victoria-traces-darwin-arm64=macos-15 victoria-traces-darwin-amd64=macos-15-intel"
# CGO per asset, as the UPSTREAM release does: deployment/docker/Makefile
# app-via-docker-linux-{amd64,arm64} set CGO_ENABLED=1, the darwin legs set 0.
GO_CGO="victoria-traces-linux-amd64=1 victoria-traces-linux-arm64=1 victoria-traces-darwin-arm64=0 victoria-traces-darwin-amd64=0"
APT_PACKAGES="build-essential strace util-linux iproute2 curl"
PRE_BUILD_GATES=""
# Argument of bashy-build/no-egress-test.sh (a GitHub expression is allowed).
EGRESS_TARGET='out/${{ matrix.asset }}'
# Release: SRC=ASSET copies from bashy-build/, the assets that must exist,
# the ones that are executables, and the release-notes lines.
RELEASE_EXTRA="PIN=victoria-traces-pin.txt otel.env=victoria-traces-otel.env no-tracking.env=victoria-traces-no-tracking.env vuln-ignore=vuln-ignore"
RELEASE_ASSETS="victoria-traces-linux-amd64 victoria-traces-linux-arm64 victoria-traces-darwin-arm64 victoria-traces-darwin-amd64 victoria-traces-$UPSTREAM_TAG.cdx.json victoria-traces-$UPSTREAM_TAG.govulncheck.json victoria-traces-pin.txt victoria-traces-otel.env victoria-traces-no-tracking.env vuln-ignore"
RELEASE_EXECUTABLES="victoria-traces-linux-amd64 victoria-traces-linux-arm64 victoria-traces-darwin-arm64 victoria-traces-darwin-amd64"
RELEASE_NOTE="No update check, no usage reporting and no remote write: -pushmetrics.url is never passed and the HTTP server is bound to loopback."
RELEASE_GATES="pinned commit, pinned Go toolchain, govulncheck (reachable, unwaived = fail), CycloneDX SBOM, no-egress."
