# bashy verified build declaration for victoria-metrics (builds/README.md).
# Shell-sourceable KEY=VALUE only. builds/render.sh renders ../fork from this
# file + files/ + builds/_shared, and ships it verbatim as the fork's
# bashy-build/PIN. The workflow refuses to build unless the checked-out
# upstream tag resolves to UPSTREAM_COMMIT and the bashy tag is
# bashy-${UPSTREAM_TAG}-N.
#
# The pin is the release yoke runs today: external/otel/stack/execstore.go
# victoriaMetricsVersion. Upstream LICENSE at this tag: Apache-2.0.
TOOL=victoria-metrics
FORK_REPO=qiangli/victoria-metrics
UPSTREAM_REPO=https://github.com/VictoriaMetrics/VictoriaMetrics
UPSTREAM_SLUG=VictoriaMetrics/VictoriaMetrics
UPSTREAM_TAG=v1.147.0
# Annotated tag object 1791215d0b6af0657d698d8edcc193f66f4f23e3 -> this commit.
UPSTREAM_COMMIT=3ac6505d7ff2c02b1c7878d92525e7b681e9cadc
# Toolchain kind: build/audit job steps come from builds/_shared/kinds/go.
KIND=go
# Must equal the go/toolchain directive in the tag's go.mod (setup.yml gates it).
GO_TOOLCHAIN=1.26.4
GOVULNCHECK_VERSION=v1.9.0
GO_SBOM_VERSION=v1.12.0
GO_PACKAGE=./app/victoria-metrics
# Version stamp only — upstream's own -ldflags also embed a build DATE and a
# `git describe`, which is exactly what a reproducible build must not do.
GO_LDFLAGS="-X github.com/VictoriaMetrics/VictoriaMetrics/lib/buildinfo.Version=victoria-metrics-$UPSTREAM_TAG"
GO_BUILD_TAGS=""
GO_BUILD_FLAGS=""
GO_BUILD_ENV=""
GO_VERSION_ARG=-version
COSIGN_VERSION=v3.1.3
# Build matrix: ASSET=RUNNER; each leg uploads out/ASSET.
MATRIX="victoria-metrics-linux-amd64=ubuntu-24.04 victoria-metrics-linux-arm64=ubuntu-24.04-arm victoria-metrics-darwin-arm64=macos-15 victoria-metrics-darwin-amd64=macos-15-intel"
# CGO per asset, as the UPSTREAM release does: deployment/docker/Makefile
# app-via-docker-linux-{amd64,arm64} set CGO_ENABLED=1, the darwin legs set 0.
GO_CGO="victoria-metrics-linux-amd64=1 victoria-metrics-linux-arm64=1 victoria-metrics-darwin-arm64=0 victoria-metrics-darwin-amd64=0"
APT_PACKAGES="build-essential strace util-linux iproute2 curl"
PRE_BUILD_GATES=""
# Argument of bashy-build/no-egress-test.sh (a GitHub expression is allowed).
EGRESS_TARGET='out/${{ matrix.asset }}'
# Release: SRC=ASSET copies from bashy-build/, the assets that must exist,
# the ones that are executables, and the release-notes lines.
RELEASE_EXTRA="PIN=victoria-metrics-pin.txt otel.env=victoria-metrics-otel.env no-tracking.env=victoria-metrics-no-tracking.env vuln-ignore=vuln-ignore"
RELEASE_ASSETS="victoria-metrics-linux-amd64 victoria-metrics-linux-arm64 victoria-metrics-darwin-arm64 victoria-metrics-darwin-amd64 victoria-metrics-$UPSTREAM_TAG.cdx.json victoria-metrics-$UPSTREAM_TAG.govulncheck.json victoria-metrics-pin.txt victoria-metrics-otel.env victoria-metrics-no-tracking.env vuln-ignore"
RELEASE_EXECUTABLES="victoria-metrics-linux-amd64 victoria-metrics-linux-arm64 victoria-metrics-darwin-arm64 victoria-metrics-darwin-amd64"
RELEASE_NOTE="No update check, no usage reporting and no remote write: -pushmetrics.url is never passed and the HTTP server is bound to loopback."
RELEASE_GATES="pinned commit, pinned Go toolchain, govulncheck (reachable, unwaived = fail), CycloneDX SBOM, no-egress."
