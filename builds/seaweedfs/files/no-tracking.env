# No-tracking environment for a bashy-run seaweedfs (shell-sourceable).
#
# seaweedfs's tracking surface is NOT environment-driven: usage reporting is a
# command-line flag that defaults to ON, so the knobs that actually matter are
# the `-telemetry=false` / `-master.telemetry=false` arguments documented in
# ../README.md and asserted by no-egress-test.sh. This file carries only the
# ambient environment that could otherwise route a weed process off-host.
#
# Usage: set -a; . bashy-build/no-tracking.env; set +a

# No inherited proxy may carry seaweedfs traffic off this host.
HTTP_PROXY=
HTTPS_PROXY=
ALL_PROXY=
http_proxy=
https_proxy=
all_proxy=
NO_PROXY=127.0.0.1,::1,localhost
no_proxy=127.0.0.1,::1,localhost

# Go's own telemetry (the toolchain's, not seaweedfs's) stays local. Harmless
# for a released binary; set so a `weed` built or run under bashy never uploads.
GOTELEMETRY=off
GOFLAGS=
