# NO-TRACKING environment for the bashy gitea verified build.
# Shell-sourceable; shipped as a release asset so a launcher applies exactly
# what this build was gated against. Every knob is documented in
# builds/gitea/README.md with its upstream source at the pinned tag.
#
# Usage: set -a; . bashy-build/no-tracking.env; set +a
#
# Gitea's configuration lives in app.ini, so the no-tracking knobs that matter
# are in the shipped bashy-build/app.ini baseline, not here:
#   [cron.update_checker] ENABLED = false   the ONE upstream phone-home
#   [service] DISABLE_REGISTRATION = true   no self-service accounts
#   [server]  DISABLE_SSH = true            HTTP on loopback only
#   [actions] ENABLED = false               no runner control plane by default
#   [proxy]   PROXY_ENABLED = false         never route Gitea traffic via a proxy
#
# Env-level, GITEA_WORK_DIR is the launcher's choice (yoke external/loom sets
# it); everything below is the egress boundary.
#
# Gitea reads the standard Go proxy variables for its outbound HTTP (migrations,
# webhooks, the update checker) on top of [proxy]; clearing them is defence in
# depth behind PROXY_ENABLED = false.
# Go's net/http honours the proxy environment, so an operator shell that
# exports a proxy would hand the service an egress path it never asked for.
# Clearing all three and allowing only loopback in NO_PROXY closes that door.
HTTP_PROXY=
HTTPS_PROXY=
http_proxy=
https_proxy=
ALL_PROXY=
all_proxy=
NO_PROXY=127.0.0.1,::1,localhost
no_proxy=127.0.0.1,::1,localhost
