# bashy verified build declaration for gitea (builds/README.md).
# Shell-sourceable KEY=VALUE only. builds/render.sh renders ../fork from this
# file + files/ + build.yml + builds/_shared, and ships it verbatim as the
# fork's bashy-build/PIN. The workflow refuses to build unless the checked-out
# upstream tag resolves to UPSTREAM_COMMIT and the bashy tag is
# bashy-${UPSTREAM_TAG}-N.
#
# The pin is the release yoke runs today: external/loom DefaultVersion (loom is
# bashy's name for the gitea-backed forge; the fork is qiangli/gitea because
# that is what it builds). Upstream LICENSE at this tag: MIT.
TOOL=gitea
FORK_REPO=qiangli/gitea
UPSTREAM_REPO=https://github.com/go-gitea/gitea
UPSTREAM_SLUG=go-gitea/gitea
UPSTREAM_TAG=v28.1.0
# Annotated tag object acf5fd902d4be6ad7a62f20acad004a52fdea153 -> this commit.
UPSTREAM_COMMIT=4ebd5e319b6a9e629bfd7a04292a6fe85b08dee9
# Toolchain kind: builds/_shared/kinds/go supplies setup + audit; the BUILD is
# tool-specific (build.yml next to this file) because the `bindata` tag embeds
# the vite-built frontend, so Node and pnpm have to run first.
KIND=go
WINDOWS_SHELL=bash
# Must equal the go/toolchain directive in the tag's go.mod (setup.yml gates it).
GO_TOOLCHAIN=1.27.1
# Security override, in-minor patch bump: go1.27.1 predates the go1.27.2 stdlib
# fixes, and v28.1.0 is the current gitea release, so no upstream tag carries a
# newer toolchain. 1.27 is a supported minor, so this is the ordinary shape —
# the newest patch of the tag's own minor, no language-version change.
# qiangli/gitea run 38326618659 measured 12 reachable stdlib findings at the
# tag's own go1.27.1; govulncheck at the pinned commit with both overrides
# below leaves 0 reachable, nothing waived.
GO_TOOLCHAIN_SECURITY_OVERRIDE=1.27.2
# Module half of the same override. golang.org/x/net v0.59.0 is what the tag
# requires and carries 5 findings reachable from gitea's own code
# (GO-2026-6603/6610/6611/6612/6617); v0.60.0 fixes all five. Nothing else in
# the graph moves with it (the go.mod diff gate proves that). Retire this the
# moment a gitea tag requires v0.60.0 or later.
GO_SECURITY_OVERRIDES="golang.org/x/net@v0.60.0"
GOVULNCHECK_VERSION=v1.9.0
GO_SBOM_VERSION=v1.12.0
GO_PACKAGE=.
# Upstream's tools/build-release.sh builds with RELEASE_TAGS="bindata $TAGS"
# (TAGS empty for a release) and RELEASE_LDFLAGS="-s -w $LDFLAGS". VERSION is
# the tag without its leading v; main.Tags records what we actually built with.
GO_LDFLAGS="-X main.Version=${UPSTREAM_TAG#v} -X main.Tags=bindata"
GO_BUILD_TAGS=bindata
# The audit analyses the shipped package UNTAGGED, the one sanctioned
# divergence from GO_BUILD_TAGS: `bindata` selects the generated
# modules/public/bindata.go over the !bindata filesystem fallback, and the
# audit job does not run the vite build that generates it. The choice is
# between which file serves an embedded asset, so the module graph govulncheck
# and the SBOM see is the shipped one.
GO_AUDIT_TAGS=""
GO_BUILD_FLAGS=""
GO_BUILD_ENV=""
GO_VERSION_ARG=--version
# Node 26 and pnpm 12.6.0: upstream .github/actions/node-setup node-version and
# package.json packageManager at the pinned tag. Used by build.yml.
NODE_VERSION=26
PNPM_VERSION=12.6.0
COSIGN_VERSION=v3.1.3
# Build matrix: ASSET=RUNNER; each leg uploads out/ASSET.
MATRIX="gitea-linux-amd64=ubuntu-24.04 gitea-linux-arm64=ubuntu-24.04-arm gitea-darwin-arm64=macos-15 gitea-darwin-amd64=macos-15-intel gitea-windows-amd64.exe=windows-2025"
# CGO per asset, as the UPSTREAM release does: tools/build-release.sh forces
# CGO_ENABLED=0 on every platform ("host-independent static builds"), and the
# sqlite driver this release defaults to is modernc (pure Go), so nothing is lost.
GO_CGO="gitea-linux-amd64=0 gitea-linux-arm64=0 gitea-darwin-arm64=0 gitea-darwin-amd64=0 gitea-windows-amd64.exe=0"
APT_PACKAGES="strace util-linux iproute2 curl"
PRE_BUILD_GATES=""
# Shared helper scripts copied from builds/_shared into bashy-build/.
SHARED_FILES="egress-verdict.sh windows-defender-egress.ps1 go-windows-egress.sh go-service-exercise.py"
# Argument of bashy-build/no-egress-test.sh (a GitHub expression is allowed).
EGRESS_TARGET='out/${{ matrix.asset }}'
# Release: SRC=ASSET copies from bashy-build/, the assets that must exist,
# the ones that are executables, and the release-notes lines.
RELEASE_EXTRA="PIN=gitea-pin.txt app.ini=gitea-bashy.ini otel.env=gitea-otel.env no-tracking.env=gitea-no-tracking.env vuln-ignore=vuln-ignore"
RELEASE_ASSETS="gitea-linux-amd64 gitea-linux-arm64 gitea-darwin-arm64 gitea-darwin-amd64 gitea-$UPSTREAM_TAG.cdx.json gitea-$UPSTREAM_TAG.govulncheck.json gitea-pin.txt gitea-bashy.ini gitea-otel.env gitea-no-tracking.env vuln-ignore gitea-windows-amd64.exe"
RELEASE_EXECUTABLES="gitea-linux-amd64 gitea-linux-arm64 gitea-darwin-arm64 gitea-darwin-amd64 gitea-windows-amd64.exe"
RELEASE_NOTE="The update checker is off, registration and SSH are off, Actions is off by default and no proxy is honoured (gitea-bashy.ini)."
RELEASE_GATES="pinned commit, pinned Go toolchain (security override: built with go1.27.2, not the tag's go1.27.1), reviewed module security override (golang.org/x/net@v0.60.0), frozen pnpm lockfile, govulncheck of the shipped package (reachable, unwaived = fail; 0 reachable, nothing waived), CycloneDX SBOM, no-egress."
