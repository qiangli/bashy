# OpenTelemetry environment for a bashy-run tuwunel (shell-sourceable).
# tuwunel v1.9.4 as built here links NO OpenTelemetry SDK (check-features.sh
# asserts the crates are absent), so nothing is exported. These variables are
# defence in depth: should any OTel SDK ever be present it is disabled, and if
# a future pin enables it deliberately the ONLY permitted endpoint is bashy's
# local collector.
OTEL_SDK_DISABLED=true
OTEL_TRACES_EXPORTER=none
OTEL_METRICS_EXPORTER=none
OTEL_LOGS_EXPORTER=none
OTEL_EXPORTER_OTLP_ENDPOINT=http://127.0.0.1:31415
OTEL_EXPORTER_OTLP_PROTOCOL=http/protobuf
