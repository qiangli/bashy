# Cargo features for the bashy build (shell-sourceable). Built with
# --no-default-features, so ONLY these are enabled. Never add:
#   sentry_telemetry   crash/perf reporting to sentry.io (src/main/Cargo.toml:188)
#   perf_measurements  OTLP exporter, but also tuwunel-core/sentry_telemetry (src/main/Cargo.toml:165-173)
#   tokio_console      opens a tokio-console server (src/main/Cargo.toml:201)
#   jemalloc_prof / jemalloc_stats  profiling (src/main/Cargo.toml:145-150)
#   url_preview        server-side fetch of arbitrary user-posted URLs (src/main/Cargo.toml:208)
# Upstream defaults (src/main/Cargo.toml:76-88) minus url_preview, io_uring
# and systemd (Linux-only; bashy supervises the process, not systemd).
FEATURES="brotli_compression element_hacks gzip_compression jemalloc jemalloc_conf media_thumbnail release_max_log_level zstd_compression"
# check-features.sh fails if any of these is in FEATURES or in the resolved
# dependency graph.
FORBIDDEN_FEATURES="sentry_telemetry perf_measurements tokio_console jemalloc_prof jemalloc_stats url_preview"
FORBIDDEN_CRATES="sentry sentry-core sentry-tower sentry-tracing sentry-backtrace sentry-contexts sentry-debug-images sentry-panic opentelemetry opentelemetry-otlp opentelemetry_sdk tracing-opentelemetry tracing-flame console-subscriber"
