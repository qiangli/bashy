# Dockerfile.shipped — build the DISTRIBUTABLE patched image from the base image.
#
# The base image is the pinned upstream Dockerfile built verbatim from the
# pinned source checkout (src/Dockerfile at UPSTREAM_COMMIT). Its /app holds
# a vulnerable bundled copy (npm 12.x bundles http-cache-semantics 4.2.0,
# GHSA-ch52-4w7c-c8xp, and bundled deps ignore overrides), so the workflow
# NEVER ships the base image. Instead it:
#
#   1. extracts the base image's /app to installed/package,
#   2. patches the extracted-tree tarball (patch_bundled.py, pinned
#      http-cache-semantics@4.3.0 tarball, integrity-checked),
#   3. re-extracts the PATCHED tarball over installed/package, so the
#      on-disk tree is byte-identical to what the tarball ships,
#   4. builds THIS Dockerfile with BASE_IMAGE=<the base image> and build
#      context installed/ (which holds package/, the patched tree).
#
# The result is the LAYERED shipped image: FROM the pinned Dockerfile-built
# base, with /app replaced by the exact patched runtime that the tarball
# ships (proven by `diff -r installed/package image-app` in build.yml,
# where image-app is /app copied back out of a container from THIS image,
# and by patch_bundled.py --verify-only passing on BOTH the tarball and
# the image-extracted tree). This image is NEVER distributed: its lower
# layers still carry the base's vulnerable bundled copy, and `docker save`
# ships every layer. The workflow instead exports this image's merged view,
# patches the full rootfs (patch_rootfs.py — including copies OUTSIDE /app),
# and re-imports it as a SINGLE-LAYER distributable image
# (fork/bashy-build/flatten-image.sh, with runtime config inherited and
# parity-checked). The workflow then `docker save`s THAT image to the
# per-arch <asset>-<tag>.docker.tar release asset (`docker load -i` it;
# Docker archive format, not OCI layout) and records its sha256 + image ID
# (+ size, layer count) in <asset>-image.digest, gated by
# gate_image_archive.py over the distributed bytes. All files are
# cosign-signed at release like every other asset.
#
# Nothing here reaches the network: COPY is from the local build context.
ARG BASE_IMAGE
FROM ${BASE_IMAGE}
COPY package/ /app/
