# OTel environment for the bashy OpenClaw verified build.
# Points OpenTelemetry export ONLY at the local OTLP collector on
# localhost. Never a vendor default. Source after no-tracking.env.
#
# Usage: set -a; . bashy-build/otel.env; set +a

# Select the diagnostics-otel plugin id for source/docker builds
# (upstream Dockerfile ARG OPENCLAW_EXTENSIONS; runtime enablement is the
# plugins.allow + entries block in openclaw-bashy.json).
OPENCLAW_EXTENSIONS=diagnostics-otel
# Shared OTLP/HTTP endpoint fallback: the local collector only
# (bashy's collector: http://127.0.0.1:31415 OTLP/HTTP).
OTEL_EXPORTER_OTLP_ENDPOINT=http://127.0.0.1:31415
OTEL_EXPORTER_OTLP_PROTOCOL=http/protobuf
OTEL_SERVICE_NAME=openclaw-gateway
