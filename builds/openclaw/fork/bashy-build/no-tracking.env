# NO-TRACKING environment for the bashy OpenClaw verified build.
# Source this file (or export each var) before starting the gateway built from
# bashy-build/PIN. Every knob is documented in builds/openclaw/README.md with
# its upstream source at the pinned tag (openclaw/openclaw v2026.10.2).
#
# Usage: set -a; . bashy-build/no-tracking.env; set +a

# Force anonymous feature statistics OFF even if config says enabled.
# NOTE: does NOT disable the daily update check (update-only GET still fires
# unless the update controls below stop it).
DO_NOT_TRACK=1
# Prevent all automatic update requests (version check + notice), both tiers.
OPENCLAW_NO_AUTO_UPDATE=1
# Defense in depth: redirect any residual telemetry request at a
# localhost blackhole (discard port) instead of the vendor default.
# NOTE: configuring an endpoint lifts the CI suppression below by design, so
# this file relies on update.checkOnStart=false + OPENCLAW_NO_AUTO_UPDATE=1
# (which stop every automatic request) with the blackhole catching residuals.
OPENCLAW_TELEMETRY_ENDPOINT=http://127.0.0.1:9/
# Upstream sends nothing when it detects an automated environment; set
# explicitly so the guarantee does not depend on runner defaults.
CI=true
# Disable mDNS (Bonjour) LAN advertising outright, overriding
# discovery.mdns.mode in config.
OPENCLAW_DISABLE_BONJOUR=1
