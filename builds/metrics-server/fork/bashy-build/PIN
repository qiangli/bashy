# bashy verified build declaration for metrics-server (builds/README.md).
# Shell-sourceable KEY=VALUE only. builds/render.sh renders ../fork from this
# file + files/ + builds/_shared, and ships it verbatim as the fork's
# bashy-build/PIN. The workflow refuses to build unless the checked-out
# upstream tag resolves to UPSTREAM_COMMIT and the bashy tag is
# bashy-${UPSTREAM_TAG}-N.
#
# The k3s runtime image's metrics-server (k3s embeds no metrics-server
# manifest in the bashy build, so the image deploys this binary itself).
# Upstream LICENSE at this tag: Apache-2.0.
TOOL=metrics-server
FORK_REPO=qiangli/metrics-server
UPSTREAM_REPO=https://github.com/kubernetes-sigs/metrics-server
UPSTREAM_SLUG=kubernetes-sigs/metrics-server
UPSTREAM_TAG=v0.9.0
# Lightweight tag: it names this commit directly.
UPSTREAM_COMMIT=2a7c4b2c7d46552ff47f4aeaa3a735c582587ecd
# Toolchain kind: build/audit job steps come from builds/_shared/kinds/go.
KIND=go
# Must equal the go directive in the tag's go.mod (setup.yml gates it).
GO_TOOLCHAIN=1.26.4
# In-minor security patch: go1.26.4 predates stdlib fixes that go1.26.9
# carries (GO-2026-6603 among them).
GO_TOOLCHAIN_SECURITY_OVERRIDE=1.26.9
# Reachable module findings at v0.9.0 under go1.26.9: x/net v0.56.0
# (GO-2026-6603/-6610/-6611/-6612/-6617), grpc v1.81.1 (GO-2026-6061/-6348),
# otel sdk/otlptrace/otlptracegrpc v1.44.0 (GO-2026-6505) and x/text v0.38.0
# (GO-2026-5970). The first three entries fix them; the rest are exactly the
# require lines MVS moves as a consequence (declared so the go.mod gate
# admits them). All stay within their major; no require is added and the go
# directive does not move. govulncheck of ./cmd/metrics-server is then clean.
GO_SECURITY_OVERRIDES="golang.org/x/net@v0.60.0 google.golang.org/grpc@v1.83.1 go.opentelemetry.io/otel/exporters/otlp/otlptrace/otlptracegrpc@v1.45.0 github.com/go-logr/logr@v1.4.4 go.opentelemetry.io/otel@v1.45.0 go.opentelemetry.io/otel/exporters/otlp/otlptrace@v1.45.0 go.opentelemetry.io/otel/metric@v1.45.0 go.opentelemetry.io/otel/sdk@v1.45.0 go.opentelemetry.io/otel/trace@v1.45.0 go.opentelemetry.io/proto/otlp@v1.11.0 golang.org/x/crypto@v0.57.0 golang.org/x/mod@v0.41.0 golang.org/x/sync@v0.23.0 golang.org/x/sys@v0.48.0 golang.org/x/term@v0.46.0 golang.org/x/text@v0.42.0 golang.org/x/tools@v0.49.0 google.golang.org/genproto/googleapis/api@v0.0.0-20260803160001-6ac0973c030d google.golang.org/genproto/googleapis/rpc@v0.0.0-20260803160001-6ac0973c030d"
GOVULNCHECK_VERSION=v1.9.0
GO_SBOM_VERSION=v1.12.0
GO_PACKAGE=./cmd/metrics-server
# Upstream Makefile VERSION_LDFLAGS from the pin: no buildDate and no
# `git describe`, so the same bashy tag rebuilds the same bytes.
GO_LDFLAGS="-X k8s.io/client-go/pkg/version.gitVersion=$UPSTREAM_TAG -X k8s.io/client-go/pkg/version.gitCommit=$UPSTREAM_COMMIT"
GO_BUILD_TAGS=""
GO_BUILD_FLAGS=""
GO_BUILD_ENV=""
GO_VERSION_ARG=--version
COSIGN_VERSION=v3.1.3
# Build matrix: ASSET=RUNNER; each leg uploads out/ASSET.
MATRIX="metrics-server-linux-amd64=ubuntu-24.04 metrics-server-linux-arm64=ubuntu-24.04-arm"
# CGO per asset, as the UPSTREAM Makefile does (CGO_ENABLED=0 go build).
GO_CGO="metrics-server-linux-amd64=0 metrics-server-linux-arm64=0"
APT_PACKAGES="strace util-linux iproute2"
PRE_BUILD_GATES=""
SHARED_FILES="egress-verdict.sh"
# Argument of bashy-build/no-egress-test.sh (a GitHub expression is allowed).
EGRESS_TARGET='out/${{ matrix.asset }}'
# Release: SRC=ASSET copies from bashy-build/, the assets that must exist,
# the ones that are executables, and the release-notes lines.
RELEASE_EXTRA="PIN=metrics-server-pin.txt otel.env=metrics-server-otel.env no-tracking.env=metrics-server-no-tracking.env vuln-ignore=vuln-ignore"
RELEASE_ASSETS="metrics-server-linux-amd64 metrics-server-linux-arm64 metrics-server-$UPSTREAM_TAG.cdx.json metrics-server-$UPSTREAM_TAG.govulncheck.json metrics-server-pin.txt metrics-server-otel.env metrics-server-no-tracking.env vuln-ignore"
RELEASE_EXECUTABLES="metrics-server-linux-amd64 metrics-server-linux-arm64"
RELEASE_NOTE="Static, cgo-free metrics-server. No update check and no usage reporting; it dials only the apiserver it is configured with and the kubelets that apiserver names."
RELEASE_GATES="pinned commit, pinned Go toolchain (security override: built with go1.26.9, not the tag's go1.26.4), reviewed GO_SECURITY_OVERRIDES module bumps, govulncheck of the shipped package (reachable, unwaived = fail), CycloneDX SBOM, no-egress."
