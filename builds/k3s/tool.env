# bashy verified build declaration for k3s (builds/README.md).
# Shell-sourceable KEY=VALUE only. builds/render.sh renders ../fork from this
# file + files/ + builds/_shared, and ships it verbatim as the fork's
# bashy-build/PIN. The workflow refuses to build unless the checked-out
# upstream tag resolves to UPSTREAM_COMMIT and the bashy tag is
# bashy-${UPSTREAM_TAG}-N.
#
# The pin is the release the outpost runtime image downloads today
# (outpost internal/agent/runtime/image/Dockerfile K3S_VERSION). Upstream
# LICENSE at this tag: Apache-2.0.
TOOL=k3s
FORK_REPO=qiangli/k3s
UPSTREAM_REPO=https://github.com/k3s-io/k3s
UPSTREAM_SLUG=k3s-io/k3s
UPSTREAM_TAG=v1.36.1+k3s1
UPSTREAM_TAG_FORM=vX.Y.Z+k3sN
# Lightweight tag -> this commit directly.
UPSTREAM_COMMIT=a9663261a7ff40522542485a6b2f81916b6d72f9
# Toolchain kind: setup steps come from builds/_shared/kinds/go; build.yml and
# audit.yml are k3s's own (static musl cgo, two binaries, see README.md).
KIND=go
# Must equal the go directive in the tag's go.mod (setup.yml gates it).
GO_TOOLCHAIN=1.26.2
# Security override, in-minor patch bump: go1.26.2 predates the stdlib fixes
# through go1.26.9 and v1.36.1+k3s1 is the pinned release. 1.26 is a supported
# minor, so this is the ordinary shape — the newest patch of the tag's own
# minor, no language-version change.
GO_TOOLCHAIN_SECURITY_OVERRIDE=1.26.9
GO_SECURITY_OVERRIDES=""
GOVULNCHECK_VERSION=v1.9.0
GO_SBOM_VERSION=v1.12.0
# The k3s multicall binary (server, agent, kubectl, crictl, ctr, containerd).
GO_PACKAGE=./cmd/server
# The containerd shim, built from the containerd module k3s pins (its go.mod
# replace: github.com/k3s-io/containerd/v2), so it needs no second checkout.
SHIM_PACKAGE=github.com/containerd/containerd/v2/cmd/containerd-shim-runc-v2
# Upstream scripts/build VERSIONFLAGS, from the pin only: no build date and no
# `git describe`, so the same bashy tag rebuilds the same bytes. The kubelet
# reports component-base's gitVersion as its node version, so it must be set.
# build.yml appends the containerd and crictl versions read from go.mod.
GO_LDFLAGS="-X github.com/k3s-io/k3s/pkg/version.Version=$UPSTREAM_TAG -X github.com/k3s-io/k3s/pkg/version.GitCommit=${UPSTREAM_COMMIT:0:8} -X github.com/k3s-io/k3s/pkg/version.UpstreamGolang=go${GO_TOOLCHAIN_SECURITY_OVERRIDE:-$GO_TOOLCHAIN} -X k8s.io/client-go/pkg/version.gitVersion=$UPSTREAM_TAG -X k8s.io/client-go/pkg/version.gitCommit=$UPSTREAM_COMMIT -X k8s.io/client-go/pkg/version.gitTreeState=clean -X k8s.io/component-base/version.gitVersion=$UPSTREAM_TAG -X k8s.io/component-base/version.gitCommit=$UPSTREAM_COMMIT -X k8s.io/component-base/version.gitTreeState=clean"
# Upstream scripts/build TAGS for a static linux build, minus `libsqlite3`:
# go-sqlite3 compiles its bundled amalgamation (public domain) instead of
# linking the system library. The `seccomp` tag selects containerd's pure-Go
# profile generator; nothing in this graph links libseccomp.
GO_BUILD_TAGS="static_build,ctrd,netcgo,osusergo,providerless,urfave_cli_no_docs,sqlite_omit_load_extension,apparmor,seccomp"
GO_AUDIT_TAGS="static_build,ctrd,netcgo,osusergo,providerless,urfave_cli_no_docs,sqlite_omit_load_extension,apparmor,seccomp"
GO_BUILD_FLAGS=""
GO_BUILD_ENV=""
# Upstream scripts/build CGO_CFLAGS for the bundled sqlite (one value with a
# space, so not expressible as a GO_BUILD_ENV word).
K3S_CGO_CFLAGS="-DSQLITE_ENABLE_DBSTAT_VTAB=1 -DSQLITE_USE_ALLOCA=1"
GO_VERSION_ARG=--version
# Manifests embedded in pkg/deploy, as upstream scripts/build copies them. Only
# the ones that reference NO container image: coredns, local-storage,
# metrics-server and traefik pull upstream images (traefik also needs charts
# fetched from k3s.io), so they are not in the binary at all.
K3S_MANIFESTS="ccm.yaml rolebindings.yaml runtimes.yaml"
COSIGN_VERSION=v3.1.3
# Build matrix: ASSET=RUNNER; each leg uploads out/ASSET and the shim.
MATRIX="k3s-linux-amd64=ubuntu-24.04 k3s-linux-arm64=ubuntu-24.04-arm"
# k3s needs cgo (sqlite, btrfs snapshotter); it is linked statically against
# musl (MIT), which is also upstream's libc (its Dapper image is alpine).
GO_CGO="k3s-linux-amd64=1 k3s-linux-arm64=1"
# musl-tools: musl-gcc for the static cgo link. linux-libc-dev: the kernel UAPI
# headers the btrfs snapshotter compiles against (GPL-2.0 WITH
# Linux-syscall-note; headers only, nothing of them is linked).
APT_PACKAGES="strace util-linux iproute2 curl musl-tools linux-libc-dev"
PRE_BUILD_GATES=""
SHARED_FILES="egress-verdict.sh"
# Argument of bashy-build/no-egress-test.sh (a GitHub expression is allowed).
EGRESS_TARGET='out/${{ matrix.asset }}'
# Release: SRC=ASSET copies from bashy-build/, the assets that must exist,
# the ones that are executables, and the release-notes lines.
RELEASE_EXTRA="PIN=k3s-pin.txt otel.env=k3s-otel.env no-tracking.env=k3s-no-tracking.env vuln-ignore=vuln-ignore"
RELEASE_ASSETS="k3s-linux-amd64 k3s-linux-arm64 containerd-shim-runc-v2-linux-amd64 containerd-shim-runc-v2-linux-arm64 k3s-$UPSTREAM_TAG.cdx.json k3s-$UPSTREAM_TAG.govulncheck.json k3s-pin.txt k3s-otel.env k3s-no-tracking.env vuln-ignore"
RELEASE_EXECUTABLES="k3s-linux-amd64 k3s-linux-arm64 containerd-shim-runc-v2-linux-amd64 containerd-shim-runc-v2-linux-arm64"
RELEASE_NOTE="Static k3s multicall binary and containerd-shim-runc-v2. No k3s-root userland, no runc, no CNI plugins and no Helm charts are embedded; only the image-free manifests (ccm, rolebindings, runtimes) are, so coredns, local-storage, metrics-server and traefik are never deployed from upstream images."
RELEASE_GATES="pinned commit, pinned Go toolchain (security override: built with go1.26.9, not the tag's go1.26.2), static musl link (no ELF interpreter), govulncheck of the shipped packages (reachable, unwaived = fail), CycloneDX SBOM, no-egress."
