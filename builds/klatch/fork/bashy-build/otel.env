# OpenTelemetry environment for a bashy-run klatch (shell-sourceable).
# net/server/go.mod carries no go.opentelemetry.io module at all: klatch
# links no OpenTelemetry SDK in the pinned build. These variables are
# defence in depth: should an SDK ever appear it is disabled, and if a
# future pin enables export deliberately the ONLY permitted destination is
# bashy's local collector — the same endpoints and protocols yoke's
# external/internal/serviceenv LocalOTLP() installs
# (LocalCollectorEndpoint = http://127.0.0.1:31415).
#
# Usage: set -a; . bashy-build/otel.env; set +a
OTEL_SDK_DISABLED=true
OTEL_TRACES_EXPORTER=none
OTEL_METRICS_EXPORTER=none
OTEL_LOGS_EXPORTER=none
OTEL_EXPORTER_OTLP_ENDPOINT=http://127.0.0.1:31415
OTEL_EXPORTER_OTLP_TRACES_ENDPOINT=http://127.0.0.1:31415/v1/traces
OTEL_EXPORTER_OTLP_METRICS_ENDPOINT=http://127.0.0.1:31415/v1/metrics
OTEL_EXPORTER_OTLP_LOGS_ENDPOINT=http://127.0.0.1:31415/v1/logs
OTEL_EXPORTER_OTLP_PROTOCOL=http/protobuf
OTEL_EXPORTER_OTLP_TRACES_PROTOCOL=http/protobuf
OTEL_EXPORTER_OTLP_METRICS_PROTOCOL=http/protobuf
OTEL_EXPORTER_OTLP_LOGS_PROTOCOL=http/protobuf
OTEL_SERVICE_NAME=klatch
