# NO-TRACKING environment for the bashy tailscale verified build.
# Shell-sourceable; shipped as a release asset so a launcher applies exactly
# what this build was gated against. See builds/tailscale/README.md.
#
# Usage: set -a; . bashy-build/no-tracking.env; set +a
#
# Log upload (logtail), self-update (clientupdate) and the cloud-metadata
# probe are compiled out of this build. TS_NO_LOGS_NO_SUPPORT is the runtime
# switch for the same log-upload decision (tailscaled --no-logs-no-support),
# kept as defence in depth. tailscaled contacts a control server and DERP
# relays only once it is configured to (`tailscale up --login-server=...`).
TS_NO_LOGS_NO_SUPPORT=true
#
# Go's net/http honours the proxy environment, so an operator shell that
# exports a proxy would hand the daemon an egress path it never asked for.
# Clearing all of them and allowing only loopback in NO_PROXY closes that door.
HTTP_PROXY=
HTTPS_PROXY=
http_proxy=
https_proxy=
ALL_PROXY=
all_proxy=
NO_PROXY=127.0.0.1,::1,localhost
no_proxy=127.0.0.1,::1,localhost
