# bashy verified build declaration for pause (builds/README.md).
# Shell-sourceable KEY=VALUE only. builds/render.sh renders ../fork from this
# file + files/ + build.yml + audit.yml + builds/_shared, and ships it verbatim
# as the fork's bashy-build/PIN. The workflow refuses to build unless the
# checked-out upstream tag resolves to UPSTREAM_COMMIT and the bashy tag is
# bashy-${UPSTREAM_TAG}-N.
#
# The pod sandbox ("pause") binary the outpost runtime image serves to k3s in
# place of the upstream pause image (k3s --pause-image). Upstream's pause is C
# (build/pause/linux/pause.c, built static against glibc in a container), so
# the shipped program is bashy's pure-Go port of it, bashy-build/pause/, built
# CGO_ENABLED=0 with the standard library only. The kubernetes tag is the
# SPECIFICATION the port is checked against: build.yml refuses to build unless
# the tag's pause.c hashes to PAUSE_C_SHA256 (the file the port was reviewed
# against) and its Makefile TAG is PAUSE_VERSION. Upstream LICENSE at this
# tag: Apache-2.0.
TOOL=pause
FORK_REPO=qiangli/pause
UPSTREAM_REPO=https://github.com/kubernetes/kubernetes
UPSTREAM_SLUG=kubernetes/kubernetes
UPSTREAM_TAG=v1.37.1
# Annotated tag d2b770f4c94636a992534a8d3156b6b2d8e82ac3 -> this commit.
UPSTREAM_COMMIT=f78e722310e50bcaca9276be22276d9e91d91308
# Toolchain kind: setup comes from builds/_shared/kinds/go; build.yml and
# audit.yml are pause's own (they build and judge bashy-build/pause, not src).
KIND=go
# Must equal the go directive in the tag's go.mod (setup.yml gates it).
GO_TOOLCHAIN=1.26.0
# Security override, in-minor patch bump: go1.26.0 predates the stdlib fixes
# through go1.26.9. 1.26 is a supported minor, so this is the ordinary shape.
GO_TOOLCHAIN_SECURITY_OVERRIDE=1.26.9
GO_SECURITY_OVERRIDES=""
GOVULNCHECK_VERSION=v1.9.0
GO_SBOM_VERSION=v1.12.0
# The port's module, relative to the fork checkout.
GO_PACKAGE=./bashy-build/pause
# build/pause/linux/pause.c and build/pause/Makefile TAG at the pinned tag.
PAUSE_C_SHA256=14a3fe21ab5f8e62937a2b453e76f3b94b0d3c7c04c3d09bc37195f54c1695ea
PAUSE_VERSION=3.10.2
# Upstream Makefile CFLAGS -DVERSION=v$(TAG)-$(REV); REV is the kubernetes tag
# here (upstream: `git describe --contains`), plus -bashy for the port.
GO_LDFLAGS="-X main.version=v$PAUSE_VERSION-$UPSTREAM_TAG-bashy"
GO_BUILD_TAGS=""
GO_AUDIT_TAGS=""
GO_BUILD_FLAGS=""
GO_BUILD_ENV=""
GO_VERSION_ARG=-v
COSIGN_VERSION=v3.1.3
# Build matrix: ASSET=RUNNER; each leg uploads out/ASSET.
MATRIX="pause-linux-amd64=ubuntu-24.04 pause-linux-arm64=ubuntu-24.04-arm"
# No cgo: the port is the standard library only, static by construction.
GO_CGO="pause-linux-amd64=0 pause-linux-arm64=0"
APT_PACKAGES="strace util-linux iproute2"
PRE_BUILD_GATES=""
SHARED_FILES="egress-verdict.sh"
# Argument of bashy-build/no-egress-test.sh (a GitHub expression is allowed).
EGRESS_TARGET='out/${{ matrix.asset }}'
# Release: SRC=ASSET copies from bashy-build/, the assets that must exist,
# the ones that are executables, and the release-notes lines.
RELEASE_EXTRA="PIN=pause-pin.txt otel.env=pause-otel.env no-tracking.env=pause-no-tracking.env vuln-ignore=vuln-ignore"
RELEASE_ASSETS="pause-linux-amd64 pause-linux-arm64 pause-$UPSTREAM_TAG.cdx.json pause-$UPSTREAM_TAG.govulncheck.json pause-pin.txt pause-otel.env pause-no-tracking.env vuln-ignore"
RELEASE_EXECUTABLES="pause-linux-amd64 pause-linux-arm64"
RELEASE_NOTE="Static, cgo-free pod sandbox (pause) binary: bashy's pure-Go port of Kubernetes build/pause/linux/pause.c (pause 3.10.2 at kubernetes v1.37.1), standard library only. It makes no network connection."
RELEASE_GATES="pinned kubernetes commit, the tag's pause.c and pause version equal to the ones the port was reviewed against, pinned Go toolchain (security override: built with go1.26.9, not the tag's go1.26.0), CGO_ENABLED=0 and no non-stdlib module, static (no ELF interpreter), the port's unit test, govulncheck of the shipped package (reachable, unwaived = fail), CycloneDX SBOM, no-egress plus the pause.c signal contract."
