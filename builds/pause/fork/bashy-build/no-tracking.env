# NO-TRACKING environment for the bashy pause verified build.
# Shell-sourceable; shipped as a release asset so a launcher applies exactly
# what this build was gated against. See builds/pause/README.md.
#
# Usage: set -a; . bashy-build/no-tracking.env; set +a
#
# pause opens no socket at all: it waits for signals and reaps children. The
# proxy variables are cleared anyway so every bashy service runs under the
# same environment contract.
HTTP_PROXY=
HTTPS_PROXY=
http_proxy=
https_proxy=
ALL_PROXY=
all_proxy=
NO_PROXY=127.0.0.1,::1,localhost
no_proxy=127.0.0.1,::1,localhost
