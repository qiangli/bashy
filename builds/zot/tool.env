# bashy verified build declaration for zot (builds/README.md).
# Shell-sourceable KEY=VALUE only. builds/render.sh renders ../fork from this
# file + files/ + builds/_shared, and ships it verbatim as the fork's
# bashy-build/PIN. The workflow refuses to build unless the checked-out
# upstream tag resolves to UPSTREAM_COMMIT and the bashy tag is
# bashy-${UPSTREAM_TAG}-N.
#
# The pin is the release yoke runs today: pkg/fleet/baseline/services/zot.yaml
# settings.version. Upstream LICENSE at this tag: Apache-2.0.
TOOL=zot
FORK_REPO=qiangli/zot
UPSTREAM_REPO=https://github.com/project-zot/zot
UPSTREAM_SLUG=project-zot/zot
UPSTREAM_TAG=v2.1.22
# Lightweight tag -> this commit directly.
UPSTREAM_COMMIT=6bbc7e56db2b7a64eee589324efe5813245e3a28
# Toolchain kind: build/audit job steps come from builds/_shared/kinds/go.
KIND=go
# Must equal the go/toolchain directive in the tag's go.mod (setup.yml gates it).
GO_TOOLCHAIN=1.27.0
# Security override, in-minor patch bump: go1.27.0 predates the go1.27.2 stdlib
# fixes and v2.1.22 is the current zot release, so no upstream tag carries a
# newer toolchain. 1.27 is a supported minor, so this is the ordinary shape —
# the newest patch of the tag's own minor, no language-version change.
GO_TOOLCHAIN_SECURITY_OVERRIDE=1.27.2
# Module half of the same override, and the whole of what the reduced extension
# set (see GO_BUILD_TAGS) does not already settle:
#   golang.org/x/net v0.59.0 -> v0.60.0   GO-2026-6603/6610/6611/6612/6617
#   otlptracegrpc + otlptracehttp 1.44.0 -> 1.45.0   GO-2026-6505
# GO-2026-6505 names five otel modules; only those two are below 1.45.0 in this
# graph (otlptrace and otel/sdk are already at or above it, and naming them
# would DOWNGRADE sdk from the v1.46.0 the tag selects). Verified at the pinned
# commit: the go.mod diff gate passes with exactly these three and govulncheck
# then reports 0 reachable, nothing waived.
GO_SECURITY_OVERRIDES="golang.org/x/net@v0.60.0 go.opentelemetry.io/otel/exporters/otlp/otlptrace/otlptracegrpc@v1.45.0 go.opentelemetry.io/otel/exporters/otlp/otlptrace/otlptracehttp@v1.45.0"
GOVULNCHECK_VERSION=v1.9.0
GO_SBOM_VERSION=v1.12.0
GO_PACKAGE=./cmd/zot
# Upstream's `binary` target, minus the `git describe` calls: ReleaseTag and
# Commit come from the pin, so the stamp stays reproducible. BinaryType records
# the extension set actually linked (see README.md §Extension set), and
# GoVersion follows the EFFECTIVE toolchain, so a recorded security override
# cannot leave the running binary reporting a Go release it was not built with.
GO_LDFLAGS="-X zotregistry.dev/zot/v2/pkg/buildinfo.ReleaseTag=$UPSTREAM_TAG -X zotregistry.dev/zot/v2/pkg/buildinfo.Commit=$UPSTREAM_COMMIT -X zotregistry.dev/zot/v2/pkg/buildinfo.BinaryType=bashy-minimal -X zotregistry.dev/zot/v2/pkg/buildinfo.GoVersion=go${GO_TOOLCHAIN_SECURITY_OVERRIDE:-$GO_TOOLCHAIN}"
# Upstream EXTENSIONS minus `ui`, `search`, `sync` and `imagetrust`. `ui` links
# a web bundle downloaded from a SECOND upstream repository (project-zot/zui at
# ZUI_VERSION) that this pipeline cannot pin or verify; the other three each
# link a dependency carrying a vulnerability with NO upstream fix, and each is
# already disabled at runtime by the empty extensions map in files/config.json:
#   search     -> github.com/aquasecurity/trivy            GO-2026-4919
#   sync       -> github.com/chrismellard/docker-credential-acr-env  GO-2026-6225
#   imagetrust -> golang.org/x/crypto/openpgp (via sigstore/rekor)   GO-2026-5932
# So the choice is a capability zot's bashy configuration never turns on versus
# an unfixable finding in the signed artifact. README.md §Extension set has the
# measurements; GO_AUDIT_TAGS below keeps the audit honest about the choice.
GO_BUILD_TAGS="events,lint,metrics,mgmt,profile,scrub,userprefs"
# The audit and the SBOM analyse exactly what is built: no divergence here, so
# govulncheck's reachability and the SBOM's component list are the artifact's.
GO_AUDIT_TAGS="events,lint,metrics,mgmt,profile,scrub,userprefs"
# Upstream BUILDMODE_FLAGS and the jsonv2 experiment its sources require.
GO_BUILD_FLAGS="-buildmode=pie"
GO_BUILD_ENV="GOEXPERIMENT=jsonv2"
GO_VERSION_ARG=--version
COSIGN_VERSION=v3.1.3
# Build matrix: ASSET=RUNNER; each leg uploads out/ASSET.
MATRIX="zot-linux-amd64=ubuntu-24.04 zot-linux-arm64=ubuntu-24.04-arm zot-darwin-arm64=macos-15 zot-darwin-amd64=macos-15-intel"
# CGO per asset, as the UPSTREAM release does: every `go build` in the Makefile
# is prefixed with CGO_ENABLED=0.
GO_CGO="zot-linux-amd64=0 zot-linux-arm64=0 zot-darwin-arm64=0 zot-darwin-amd64=0"
APT_PACKAGES="strace util-linux iproute2 curl"
PRE_BUILD_GATES=""
# Shared helper scripts copied from builds/_shared into bashy-build/.
SHARED_FILES="egress-verdict.sh"
# Argument of bashy-build/no-egress-test.sh (a GitHub expression is allowed).
EGRESS_TARGET='out/${{ matrix.asset }}'
# Release: SRC=ASSET copies from bashy-build/, the assets that must exist,
# the ones that are executables, and the release-notes lines.
RELEASE_EXTRA="PIN=zot-pin.txt config.json=zot-bashy.json otel.env=zot-otel.env no-tracking.env=zot-no-tracking.env vuln-ignore=vuln-ignore"
RELEASE_ASSETS="zot-linux-amd64 zot-linux-arm64 zot-darwin-arm64 zot-darwin-amd64 zot-$UPSTREAM_TAG.cdx.json zot-$UPSTREAM_TAG.govulncheck.json zot-pin.txt zot-bashy.json zot-otel.env zot-no-tracking.env vuln-ignore"
RELEASE_EXECUTABLES="zot-linux-amd64 zot-linux-arm64 zot-darwin-arm64 zot-darwin-amd64"
RELEASE_NOTE="No update check and no usage reporting; the extensions map is empty (no sync, no CVE feed, no events) and the ui web bundle, the trivy CVE scanner, the sync credential helpers and the sigstore image-trust stack are not linked in at all (buildinfo.BinaryType is stamped bashy-minimal)."
RELEASE_GATES="pinned commit, pinned Go toolchain (security override: built with go1.27.2, not the tag's go1.27.0), reviewed module security overrides (golang.org/x/net@v0.60.0, otlptracegrpc and otlptracehttp @v1.45.0), govulncheck of the shipped package and tag set (reachable, unwaived = fail; 0 reachable, nothing waived), CycloneDX SBOM, no-egress."
