# bashy verified build declaration for zot (builds/README.md).
# Shell-sourceable KEY=VALUE only. builds/render.sh renders ../fork from this
# file + files/ + builds/_shared, and ships it verbatim as the fork's
# bashy-build/PIN. The workflow refuses to build unless the checked-out
# upstream tag resolves to UPSTREAM_COMMIT and the bashy tag is
# bashy-${UPSTREAM_TAG}-N.
#
# The pin is the release yoke runs today: pkg/fleet/baseline/services/zot.yaml
# settings.version. Upstream LICENSE at this tag: Apache-2.0.
TOOL=zot
FORK_REPO=qiangli/zot
UPSTREAM_REPO=https://github.com/project-zot/zot
UPSTREAM_SLUG=project-zot/zot
UPSTREAM_TAG=v2.1.22
# Lightweight tag -> this commit directly.
UPSTREAM_COMMIT=6bbc7e56db2b7a64eee589324efe5813245e3a28
# Toolchain kind: build/audit job steps come from builds/_shared/kinds/go.
KIND=go
# Must equal the go/toolchain directive in the tag's go.mod (setup.yml gates it).
GO_TOOLCHAIN=1.27.0
GOVULNCHECK_VERSION=v1.9.0
GO_SBOM_VERSION=v1.12.0
GO_PACKAGE=./cmd/zot
# Upstream's `binary` target, minus the `git describe` calls: ReleaseTag and
# Commit come from the pin, so the stamp stays reproducible. BinaryType records
# the extension set actually linked (see README.md §Extension set).
GO_LDFLAGS="-X zotregistry.dev/zot/v2/pkg/buildinfo.ReleaseTag=$UPSTREAM_TAG -X zotregistry.dev/zot/v2/pkg/buildinfo.Commit=$UPSTREAM_COMMIT -X zotregistry.dev/zot/v2/pkg/buildinfo.BinaryType=bashy-no-ui -X zotregistry.dev/zot/v2/pkg/buildinfo.GoVersion=go$GO_TOOLCHAIN"
# Upstream EXTENSIONS minus `ui`: the ui tag links a web bundle downloaded from
# a SECOND upstream repository (project-zot/zui at ZUI_VERSION), which this
# pipeline cannot pin or verify. README.md §Extension set has the rationale.
GO_BUILD_TAGS="events,imagetrust,lint,metrics,mgmt,profile,scrub,search,sync,userprefs"
# Upstream BUILDMODE_FLAGS and the jsonv2 experiment its sources require.
GO_BUILD_FLAGS="-buildmode=pie"
GO_BUILD_ENV="GOEXPERIMENT=jsonv2"
GO_VERSION_ARG=--version
COSIGN_VERSION=v3.1.3
# Build matrix: ASSET=RUNNER; each leg uploads out/ASSET.
MATRIX="zot-linux-amd64=ubuntu-24.04 zot-linux-arm64=ubuntu-24.04-arm zot-darwin-arm64=macos-15 zot-darwin-amd64=macos-15-intel"
# CGO per asset, as the UPSTREAM release does: every `go build` in the Makefile
# is prefixed with CGO_ENABLED=0.
GO_CGO="zot-linux-amd64=0 zot-linux-arm64=0 zot-darwin-arm64=0 zot-darwin-amd64=0"
APT_PACKAGES="strace util-linux iproute2 curl"
PRE_BUILD_GATES=""
# Shared helper scripts copied from builds/_shared into bashy-build/.
SHARED_FILES="egress-verdict.sh"
# Argument of bashy-build/no-egress-test.sh (a GitHub expression is allowed).
EGRESS_TARGET='out/${{ matrix.asset }}'
# Release: SRC=ASSET copies from bashy-build/, the assets that must exist,
# the ones that are executables, and the release-notes lines.
RELEASE_EXTRA="PIN=zot-pin.txt config.json=zot-bashy.json otel.env=zot-otel.env no-tracking.env=zot-no-tracking.env vuln-ignore=vuln-ignore"
RELEASE_ASSETS="zot-linux-amd64 zot-linux-arm64 zot-darwin-arm64 zot-darwin-amd64 zot-$UPSTREAM_TAG.cdx.json zot-$UPSTREAM_TAG.govulncheck.json zot-pin.txt zot-bashy.json zot-otel.env zot-no-tracking.env vuln-ignore"
RELEASE_EXECUTABLES="zot-linux-amd64 zot-linux-arm64 zot-darwin-arm64 zot-darwin-amd64"
RELEASE_NOTE="No update check and no usage reporting; the extensions map is empty (no sync, no CVE feed, no events) and the ui web bundle is not linked in."
RELEASE_GATES="pinned commit, pinned Go toolchain, govulncheck (reachable, unwaived = fail), CycloneDX SBOM, no-egress."
