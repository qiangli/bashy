# bashy verified build declaration for kopia (builds/README.md).
# Shell-sourceable KEY=VALUE only. builds/render.sh renders ../fork from this
# file + files/ + builds/_shared, and ships it verbatim as the fork's
# bashy-build/PIN. The workflow refuses to build unless the checked-out
# upstream tag resolves to UPSTREAM_COMMIT and the bashy tag is
# bashy-${UPSTREAM_TAG}-N.
#
# The pin is the release yoke runs today: pkg/fleet/baseline/services/
# kopia.yaml settings.version. Upstream LICENSE at this tag: Apache-2.0.
TOOL=kopia
FORK_REPO=qiangli/kopia
UPSTREAM_REPO=https://github.com/kopia/kopia
UPSTREAM_SLUG=kopia/kopia
UPSTREAM_TAG=v0.23.1
# Annotated tag object d1d5ee564495be8616b86d3578812a321fc83e3f -> this commit.
UPSTREAM_COMMIT=72ec08fd8edb86c67ed27099bf1b955e1f308ffa
# Toolchain kind: build/audit job steps come from builds/_shared/kinds/go.
KIND=go
# Must equal the go/toolchain directive in the tag's go.mod (setup.yml gates it).
GO_TOOLCHAIN=1.25.11
GOVULNCHECK_VERSION=v1.9.0
GO_SBOM_VERSION=v1.12.0
GO_PACKAGE=.
# Upstream's KOPIA_BUILD_FLAGS, minus the `git rev-parse HEAD` call: the pinned
# commit IS the build info, so the stamp stays reproducible. BuildVersion drops
# the leading v, as upstream's KOPIA_VERSION_NO_PREFIX does.
GO_LDFLAGS="-X github.com/kopia/kopia/repo.BuildVersion=${UPSTREAM_TAG#v} -X github.com/kopia/kopia/repo.BuildInfo=$UPSTREAM_COMMIT -X github.com/kopia/kopia/repo.BuildGitHubRepo=$UPSTREAM_SLUG"
GO_BUILD_TAGS=""
GO_BUILD_FLAGS=""
GO_BUILD_ENV=""
GO_VERSION_ARG=--version
COSIGN_VERSION=v3.1.3
# Build matrix: ASSET=RUNNER; each leg uploads out/ASSET.
MATRIX="kopia-linux-amd64=ubuntu-24.04 kopia-linux-arm64=ubuntu-24.04-arm kopia-darwin-arm64=macos-15 kopia-darwin-amd64=macos-15-intel"
# CGO per asset, as the UPSTREAM release does: .goreleaser.yml sets
# CGO_ENABLED=0 for the linux archives, while the macOS archives come from the
# Makefile's native `go build` on a mac runner, where cgo is on by default.
GO_CGO="kopia-linux-amd64=0 kopia-linux-arm64=0 kopia-darwin-arm64=1 kopia-darwin-amd64=1"
APT_PACKAGES="strace util-linux iproute2 curl"
PRE_BUILD_GATES=""
# Shared helper scripts copied from builds/_shared into bashy-build/.
SHARED_FILES="egress-verdict.sh"
# Argument of bashy-build/no-egress-test.sh (a GitHub expression is allowed).
EGRESS_TARGET='out/${{ matrix.asset }}'
# Release: SRC=ASSET copies from bashy-build/, the assets that must exist,
# the ones that are executables, and the release-notes lines.
RELEASE_EXTRA="PIN=kopia-pin.txt otel.env=kopia-otel.env no-tracking.env=kopia-no-tracking.env vuln-ignore=vuln-ignore"
RELEASE_ASSETS="kopia-linux-amd64 kopia-linux-arm64 kopia-darwin-arm64 kopia-darwin-amd64 kopia-$UPSTREAM_TAG.cdx.json kopia-$UPSTREAM_TAG.govulncheck.json kopia-pin.txt kopia-otel.env kopia-no-tracking.env vuln-ignore"
RELEASE_EXECUTABLES="kopia-linux-amd64 kopia-linux-arm64 kopia-darwin-arm64 kopia-darwin-amd64"
RELEASE_NOTE="The GitHub update check is off (--no-check-for-updates) and the only OTLP destination is bashy's local collector 127.0.0.1:31415."
RELEASE_GATES="pinned commit, pinned Go toolchain, govulncheck (reachable, unwaived = fail), CycloneDX SBOM, no-egress."
