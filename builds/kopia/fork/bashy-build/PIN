# bashy verified build declaration for kopia (builds/README.md).
# Shell-sourceable KEY=VALUE only. builds/render.sh renders ../fork from this
# file + files/ + builds/_shared, and ships it verbatim as the fork's
# bashy-build/PIN. The workflow refuses to build unless the checked-out
# upstream tag resolves to UPSTREAM_COMMIT and the bashy tag is
# bashy-${UPSTREAM_TAG}-N.
#
# The pin is the release yoke runs today: pkg/fleet/baseline/services/
# kopia.yaml settings.version. Upstream LICENSE at this tag: Apache-2.0.
TOOL=kopia
FORK_REPO=qiangli/kopia
UPSTREAM_REPO=https://github.com/kopia/kopia
UPSTREAM_SLUG=kopia/kopia
UPSTREAM_TAG=v0.23.1
# Annotated tag object d1d5ee564495be8616b86d3578812a321fc83e3f -> this commit.
UPSTREAM_COMMIT=72ec08fd8edb86c67ed27099bf1b955e1f308ffa
# Toolchain kind: build/audit job steps come from builds/_shared/kinds/go.
KIND=go
# Must equal the go/toolchain directive in the tag's go.mod (setup.yml gates it).
GO_TOOLCHAIN=1.25.11
# EOL-minor security override. Go 1.25 is no longer a supported minor now that
# 1.27 has shipped (Go fixes only its two newest minors), so go1.25.11 is the
# LAST 1.25 release there will ever be: there is no later patch to move to, and
# v0.23.1 is the current kopia release, so no upstream tag carries a newer
# toolchain either. Staying put therefore cannot be made safe, which is the one
# case setup.yml lets the override leave the tag's minor — and then only to the
# OLDEST supported minor's latest patch, the smallest language-version jump
# that gets security fixes again. Measured at the pinned commit: the move to
# go1.26.9 clears every reachable stdlib finding on its own, leaving only the
# module findings GO_SECURITY_OVERRIDES below fixes.
GO_TOOLCHAIN_SECURITY_OVERRIDE=1.26.9
# Module half of the same override. At go1.26.9 the shipped package still has
# 11 reachable findings, all of them in dependencies with published fixes:
#   golang.org/x/net    -> v0.60.0  GO-2026-6603/6610/6611/6612/6617
#   golang.org/x/crypto -> v0.56.0  GO-2026-6354, GO-2026-6355
#   google.golang.org/grpc -> v1.83.1  GO-2026-6061, GO-2026-6348
#   golang.org/x/text   -> v0.39.0  GO-2026-5970
#   otlptracegrpc       -> v1.45.0  GO-2026-6505
# The list below is DERIVED, not hand-picked: taking those five fixes into a
# graph this old moves 23 require lines by MVS, and the go.mod diff gate
# refuses any module it was not told about — so every module MVS moves is named
# here, each at the version MVS actually selects (which is at or above the fix
# in every case). Pinning the selected version is what keeps it a no-op rather
# than a downgrade; regenerate the whole list when the kopia pin moves, do not
# patch it by hand. Taking the x/net and x/crypto fixes also raises go.mod's
# own `go` directive from 1.25.8 to 1.26.0, because those releases declare it;
# setup.yml allows that only up to the effective toolchain, which the override
# above has already gated.
GO_SECURITY_OVERRIDES="golang.org/x/text@v0.42.0 golang.org/x/crypto@v0.57.0 golang.org/x/net@v0.60.0 google.golang.org/grpc@v1.83.1 go.opentelemetry.io/otel/exporters/otlp/otlptrace/otlptracegrpc@v1.45.0 cel.dev/expr@v0.25.2 github.com/GoogleCloudPlatform/opentelemetry-operations-go/detectors/gcp@v1.33.0 github.com/go-logr/logr@v1.4.4 github.com/spiffe/go-spiffe/v2@v2.7.0 go.opentelemetry.io/contrib/detectors/gcp@v1.44.0 go.opentelemetry.io/otel@v1.45.0 go.opentelemetry.io/otel/exporters/otlp/otlptrace@v1.45.0 go.opentelemetry.io/otel/metric@v1.45.0 go.opentelemetry.io/otel/sdk@v1.45.0 go.opentelemetry.io/otel/sdk/metric@v1.45.0 go.opentelemetry.io/otel/trace@v1.45.0 go.opentelemetry.io/proto/otlp@v1.11.0 golang.org/x/mod@v0.41.0 golang.org/x/sync@v0.23.0 golang.org/x/sys@v0.48.0 golang.org/x/term@v0.46.0 google.golang.org/genproto/googleapis/api@v0.0.0-20260803160001-6ac0973c030d google.golang.org/genproto/googleapis/rpc@v0.0.0-20260803160001-6ac0973c030d"
GOVULNCHECK_VERSION=v1.9.0
GO_SBOM_VERSION=v1.12.0
GO_PACKAGE=.
# Upstream's KOPIA_BUILD_FLAGS, minus the `git rev-parse HEAD` call: the pinned
# commit IS the build info, so the stamp stays reproducible. BuildVersion drops
# the leading v, as upstream's KOPIA_VERSION_NO_PREFIX does.
GO_LDFLAGS="-X github.com/kopia/kopia/repo.BuildVersion=${UPSTREAM_TAG#v} -X github.com/kopia/kopia/repo.BuildInfo=$UPSTREAM_COMMIT -X github.com/kopia/kopia/repo.BuildGitHubRepo=$UPSTREAM_SLUG"
GO_BUILD_TAGS=""
GO_BUILD_FLAGS=""
GO_BUILD_ENV=""
GO_VERSION_ARG=--version
COSIGN_VERSION=v3.1.3
# Build matrix: ASSET=RUNNER; each leg uploads out/ASSET.
MATRIX="kopia-linux-amd64=ubuntu-24.04 kopia-linux-arm64=ubuntu-24.04-arm kopia-darwin-arm64=macos-15 kopia-darwin-amd64=macos-15-intel"
# CGO per asset, as the UPSTREAM release does: .goreleaser.yml sets
# CGO_ENABLED=0 for the linux archives, while the macOS archives come from the
# Makefile's native `go build` on a mac runner, where cgo is on by default.
GO_CGO="kopia-linux-amd64=0 kopia-linux-arm64=0 kopia-darwin-arm64=1 kopia-darwin-amd64=1"
APT_PACKAGES="strace util-linux iproute2 curl"
PRE_BUILD_GATES=""
# Shared helper scripts copied from builds/_shared into bashy-build/.
SHARED_FILES="egress-verdict.sh"
# Argument of bashy-build/no-egress-test.sh (a GitHub expression is allowed).
EGRESS_TARGET='out/${{ matrix.asset }}'
# Release: SRC=ASSET copies from bashy-build/, the assets that must exist,
# the ones that are executables, and the release-notes lines.
RELEASE_EXTRA="PIN=kopia-pin.txt otel.env=kopia-otel.env no-tracking.env=kopia-no-tracking.env vuln-ignore=vuln-ignore"
RELEASE_ASSETS="kopia-linux-amd64 kopia-linux-arm64 kopia-darwin-arm64 kopia-darwin-amd64 kopia-$UPSTREAM_TAG.cdx.json kopia-$UPSTREAM_TAG.govulncheck.json kopia-pin.txt kopia-otel.env kopia-no-tracking.env vuln-ignore"
RELEASE_EXECUTABLES="kopia-linux-amd64 kopia-linux-arm64 kopia-darwin-arm64 kopia-darwin-amd64"
RELEASE_NOTE="The GitHub update check is off (KOPIA_CHECK_FOR_UPDATES=false, in kopia-no-tracking.env) and the only OTLP destination is bashy's local collector 127.0.0.1:31415."
RELEASE_GATES="pinned commit, pinned Go toolchain (EOL-minor security override: built with go1.26.9, not the tag's end-of-life go1.25.11), reviewed module security overrides (23 require lines, from the five fixes listed in kopia-pin.txt), govulncheck of the shipped package (reachable, unwaived = fail; 0 reachable, nothing waived), CycloneDX SBOM, no-egress."
