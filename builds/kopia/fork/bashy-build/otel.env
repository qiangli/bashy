# OpenTelemetry environment for a bashy-run kopia (shell-sourceable).
# kopia is the one service in this set that DOES export: `--no-check-for-updates
# --otlp-trace` is the argv yoke's external/kopia launcher uses, and --otlp-trace
# makes kopia emit OTLP traces through the standard SDK environment. So the SDK
# stays enabled here and every destination is pinned at bashy's local collector —
# the same endpoints and protocols yoke's external/internal/serviceenv LocalOTLP()
# installs (LocalCollectorEndpoint = http://127.0.0.1:31415). Metrics and logs
# have no kopia exporter and are switched off rather than left to a default.
#
# Upstream flag reference: https://kopia.io/docs/reference/command-line/flags/
#
# Usage: set -a; . bashy-build/otel.env; set +a
OTEL_TRACES_EXPORTER=otlp
OTEL_METRICS_EXPORTER=none
OTEL_LOGS_EXPORTER=none
OTEL_EXPORTER_OTLP_ENDPOINT=http://127.0.0.1:31415
OTEL_EXPORTER_OTLP_TRACES_ENDPOINT=http://127.0.0.1:31415/v1/traces
OTEL_EXPORTER_OTLP_METRICS_ENDPOINT=http://127.0.0.1:31415/v1/metrics
OTEL_EXPORTER_OTLP_LOGS_ENDPOINT=http://127.0.0.1:31415/v1/logs
OTEL_EXPORTER_OTLP_PROTOCOL=http/protobuf
OTEL_EXPORTER_OTLP_TRACES_PROTOCOL=http/protobuf
OTEL_EXPORTER_OTLP_METRICS_PROTOCOL=http/protobuf
OTEL_EXPORTER_OTLP_LOGS_PROTOCOL=http/protobuf
OTEL_SERVICE_NAME=kopia
