# bashy verified build declaration for cni-plugins (builds/README.md).
# Shell-sourceable KEY=VALUE only. builds/render.sh renders ../fork from this
# file + files/ + builds/_shared, and ships it verbatim as the fork's
# bashy-build/PIN. The workflow refuses to build unless the checked-out
# upstream tag resolves to UPSTREAM_COMMIT and the bashy tag is
# bashy-${UPSTREAM_TAG}-N.
#
# The CNI plugins the k3s runtime image needs (k3s-root ships them today).
# Upstream LICENSE at this tag: Apache-2.0.
TOOL=cni-plugins
FORK_REPO=qiangli/cni-plugins
UPSTREAM_REPO=https://github.com/containernetworking/plugins
UPSTREAM_SLUG=containernetworking/plugins
UPSTREAM_TAG=v1.5.1
# Lightweight tag -> this commit directly.
UPSTREAM_COMMIT=c29dc79f96cd50452a247a4591443d2aac033429
# Toolchain kind: setup steps come from builds/_shared/kinds/go; build.yml and
# audit.yml are cni-plugins' own (several binaries, see README.md).
KIND=go
# Must equal the go directive in the tag's go.mod (setup.yml gates it).
GO_TOOLCHAIN=1.20
# EOL-minor security override: go1.20 gets no security fixes, so the build
# moves to the oldest supported minor's latest patch. Verified at the pinned
# commit: govulncheck of the six shipped plugins under go1.26.9 reports 0
# reachable, nothing waived, with no module override.
GO_TOOLCHAIN_SECURITY_OVERRIDE=1.26.9
GO_SECURITY_OVERRIDES=""
GOVULNCHECK_VERSION=v1.9.0
GO_SBOM_VERSION=v1.12.0
# The plugins shipped, as upstream build_linux.sh builds each: ./plugins/<dir>.
# bridge + host-local + loopback + portmap + bandwidth + firewall are the set
# k3s's flannel conflist and containerd's CRI loopback call.
CNI_PLUGINS="main/bridge ipam/host-local main/loopback meta/portmap meta/bandwidth meta/firewall"
# The skeleton names one package; the build and audit use CNI_PLUGINS.
GO_PACKAGE=./plugins/main/loopback
# Upstream scripts/release.sh BUILDFLAGS, minus -extldflags -static (no cgo,
# so nothing is linked externally).
GO_LDFLAGS="-X github.com/containernetworking/plugins/pkg/utils/buildversion.BuildVersion=$UPSTREAM_TAG"
GO_BUILD_TAGS=""
GO_BUILD_FLAGS=""
GO_BUILD_ENV=""
COSIGN_VERSION=v3.1.3
# Build matrix: ASSET=RUNNER; each leg uploads cni-<plugin>-linux-<arch>.
MATRIX="cni-plugins-linux-amd64=ubuntu-24.04 cni-plugins-linux-arm64=ubuntu-24.04-arm"
# CGO per asset, as the UPSTREAM release does (scripts/release.sh CGO_ENABLED=0).
GO_CGO="cni-plugins-linux-amd64=0 cni-plugins-linux-arm64=0"
APT_PACKAGES="strace util-linux iproute2"
PRE_BUILD_GATES=""
SHARED_FILES="egress-verdict.sh"
# Argument of bashy-build/no-egress-test.sh: the build's out/ dir.
EGRESS_TARGET='out'
# Release: SRC=ASSET copies from bashy-build/, the assets that must exist,
# the ones that are executables, and the release-notes lines.
RELEASE_EXTRA="PIN=cni-plugins-pin.txt otel.env=cni-plugins-otel.env no-tracking.env=cni-plugins-no-tracking.env vuln-ignore=vuln-ignore"
RELEASE_EXECUTABLES="cni-bridge-linux-amd64 cni-host-local-linux-amd64 cni-loopback-linux-amd64 cni-portmap-linux-amd64 cni-bandwidth-linux-amd64 cni-firewall-linux-amd64 cni-bridge-linux-arm64 cni-host-local-linux-arm64 cni-loopback-linux-arm64 cni-portmap-linux-arm64 cni-bandwidth-linux-arm64 cni-firewall-linux-arm64"
RELEASE_ASSETS="$RELEASE_EXECUTABLES cni-plugins-$UPSTREAM_TAG.cdx.json cni-plugins-$UPSTREAM_TAG.govulncheck.json cni-plugins-pin.txt cni-plugins-otel.env cni-plugins-no-tracking.env vuln-ignore"
RELEASE_NOTE="Static, cgo-free CNI plugins bridge, host-local, loopback, portmap, bandwidth and firewall. No plugin makes a network call of its own; the dhcp daemon is not shipped."
RELEASE_GATES="pinned commit, pinned Go toolchain (EOL-minor security override: built with go1.26.9, not the tag's end-of-life go1.20), static (no ELF interpreter), govulncheck of the six shipped plugins (reachable, unwaived = fail; 0 reachable, nothing waived), CycloneDX SBOM, no-egress."
