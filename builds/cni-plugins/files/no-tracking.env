# NO-TRACKING environment for the bashy cni-plugins verified build.
# Shell-sourceable; shipped as a release asset so a launcher applies exactly
# what this build was gated against. See builds/cni-plugins/README.md.
#
# Usage: set -a; . bashy-build/no-tracking.env; set +a
#
# The CNI plugins have NO update checker and NO usage reporting, and make no
# network call of their own: they configure interfaces, routes and iptables
# through netlink and the host's iptables binaries.
#
# Go's net/http honours the proxy environment, so an operator shell that
# exports a proxy would hand the service an egress path it never asked for.
# Clearing all of them and allowing only loopback in NO_PROXY closes that door.
HTTP_PROXY=
HTTPS_PROXY=
http_proxy=
https_proxy=
ALL_PROXY=
all_proxy=
NO_PROXY=127.0.0.1,::1,localhost
no_proxy=127.0.0.1,::1,localhost
