# bashy verified build declaration for coredns (builds/README.md).
# Shell-sourceable KEY=VALUE only. builds/render.sh renders ../fork from this
# file + files/ + builds/_shared, and ships it verbatim as the fork's
# bashy-build/PIN. The workflow refuses to build unless the checked-out
# upstream tag resolves to UPSTREAM_COMMIT and the bashy tag is
# bashy-${UPSTREAM_TAG}-N.
#
# The cluster DNS the outpost runtime image serves to k3s in place of the
# upstream coredns image (the bashy k3s build embeds no coredns manifest).
# Newest stable CoreDNS release. Upstream LICENSE at this tag: Apache-2.0.
TOOL=coredns
FORK_REPO=qiangli/coredns
UPSTREAM_REPO=https://github.com/coredns/coredns
UPSTREAM_SLUG=coredns/coredns
UPSTREAM_TAG=v1.14.7
# Lightweight tag: it names this commit directly.
UPSTREAM_COMMIT=427fc80ed9ca47f354585eb30a3f1332950856c4
# Toolchain kind: build/audit job steps come from builds/_shared/kinds/go.
KIND=go
# Must equal the go directive in the tag's go.mod (setup.yml gates it).
# (Upstream's release Makefile builds with .go-version, go1.26.6.)
GO_TOOLCHAIN=1.25.0
# EOL-minor security override: go1.25 gets no security fixes, so the build
# moves to the oldest supported minor's latest patch.
GO_TOOLCHAIN_SECURITY_OVERRIDE=1.26.9
# Reachable module findings at v1.14.7 under go1.26.9: grpc v1.83.0
# (GO-2026-6348, GO-2026-6443) and x/net v0.57.0 (GO-2026-6603/-6610/-6611/
# -6612/-6617). The first two entries fix them; the rest are exactly the
# require lines MVS moves as a consequence (declared so the go.mod gate admits
# them). All stay within their major and no require is added; x/net v0.60.0
# declares `go 1.26.0`, so the go directive rises 1.25.0 -> 1.26.0, within the
# effective go1.26.9. govulncheck of the shipped package is then clean.
GO_SECURITY_OVERRIDES="google.golang.org/grpc@v1.83.2 golang.org/x/net@v0.60.0 golang.org/x/crypto@v0.57.0 golang.org/x/mod@v0.41.0 golang.org/x/sync@v0.23.0 golang.org/x/sys@v0.48.0 golang.org/x/term@v0.46.0 golang.org/x/text@v0.42.0 golang.org/x/tools@v0.49.0"
GOVULNCHECK_VERSION=v1.9.0
GO_SBOM_VERSION=v1.12.0
GO_PACKAGE=.
# Upstream Makefile LDFLAGS from the pin: coremain.GitCommit is `git describe`
# upstream; here it is the pinned commit.
GO_LDFLAGS="-X github.com/coredns/coredns/coremain.GitCommit=$UPSTREAM_COMMIT"
# Upstream Makefile GOTAGS (gRPC tracing compiled out).
GO_BUILD_TAGS="grpcnotrace"
GO_AUDIT_TAGS="grpcnotrace"
GO_BUILD_FLAGS=""
GO_BUILD_ENV=""
GO_VERSION_ARG=-version
COSIGN_VERSION=v3.1.3
# Build matrix: ASSET=RUNNER; each leg uploads out/ASSET.
MATRIX="coredns-linux-amd64=ubuntu-24.04 coredns-linux-arm64=ubuntu-24.04-arm"
# CGO per asset, as the UPSTREAM Makefile does (CGO_ENABLED=0).
GO_CGO="coredns-linux-amd64=0 coredns-linux-arm64=0"
APT_PACKAGES="strace util-linux iproute2 curl"
PRE_BUILD_GATES=""
SHARED_FILES="egress-verdict.sh"
# Argument of bashy-build/no-egress-test.sh (a GitHub expression is allowed).
EGRESS_TARGET='out/${{ matrix.asset }}'
# Release: SRC=ASSET copies from bashy-build/, the assets that must exist,
# the ones that are executables, and the release-notes lines.
RELEASE_EXTRA="PIN=coredns-pin.txt otel.env=coredns-otel.env no-tracking.env=coredns-no-tracking.env vuln-ignore=vuln-ignore"
RELEASE_ASSETS="coredns-linux-amd64 coredns-linux-arm64 coredns-$UPSTREAM_TAG.cdx.json coredns-$UPSTREAM_TAG.govulncheck.json coredns-pin.txt coredns-otel.env coredns-no-tracking.env vuln-ignore"
RELEASE_EXECUTABLES="coredns-linux-amd64 coredns-linux-arm64"
RELEASE_NOTE="Static, cgo-free CoreDNS with upstream's default plugin set. No update check and no usage reporting; it dials only what its Corefile names (the apiserver for kubernetes, the resolvers for forward)."
RELEASE_GATES="pinned commit, pinned Go toolchain (EOL-minor security override: built with go1.26.9, not the tag's end-of-life go1.25.0), reviewed GO_SECURITY_OVERRIDES module bumps, govulncheck of the shipped package (reachable, unwaived = fail), CycloneDX SBOM, no-egress (a real DNS query answered on loopback)."
