# bashy verified build declaration for Headlamp's in-cluster server.
TOOL=headlamp
FORK_REPO=qiangli/headlamp
UPSTREAM_REPO=https://github.com/kubernetes-sigs/headlamp
UPSTREAM_SLUG=kubernetes-sigs/headlamp
UPSTREAM_TAG=v0.45.0
# Annotated tag 7ab6640167bd1496cc35c1efa9f61ec69ef8f9dc -> commit below.
UPSTREAM_COMMIT=0e9fe810cb618964172f420666727c9a67fd6ebf
KIND=custom
GO_TOOLCHAIN=1.26.7
# The tag predates the 2026-10 Go stdlib fixes; stay on upstream's minor.
GO_TOOLCHAIN_SECURITY_OVERRIDE=1.26.9
# No module override is applied. Headlamp's Go module is backend/go.mod, while
# the shared go kind currently gates only a root go.mod; keeping this custom
# build makes govulncheck fail closed on every reachable finding.
BLOCKED_ON_UPSTREAM="GO-2026-5064 GO-2026-5338 GO-2026-5622 GO-2026-5932"
GOVULNCHECK_VERSION=v1.9.0
GO_SBOM_VERSION=v1.12.0
NODE_VERSION=22
NPM_VERSION=11
COSIGN_VERSION=v3.1.3
MATRIX="headlamp-linux-amd64=ubuntu-24.04 headlamp-linux-arm64=ubuntu-24.04-arm headlamp-darwin-arm64=macos-15 headlamp-darwin-amd64=macos-15-intel"
APT_PACKAGES="strace util-linux iproute2 curl"
PRE_BUILD_GATES=""
SHARED_FILES="egress-verdict.sh"
EGRESS_TARGET='out/${{ matrix.asset }}'
OCI_IMAGE=ghcr.io/qiangli/headlamp
IMAGE_BASE=alpine:3.24.1@sha256:28bd5fe8b56d1bd048e5babf5b10710ebe0bae67db86916198a6eec434943f8b
RELEASE_EXTRA="PIN=headlamp-pin.txt otel.env=headlamp-otel.env no-tracking.env=headlamp-no-tracking.env vuln-ignore=vuln-ignore"
RELEASE_ASSETS="headlamp-linux-amd64 headlamp-linux-arm64 headlamp-darwin-arm64 headlamp-darwin-amd64 headlamp-$UPSTREAM_TAG.cdx.json headlamp-$UPSTREAM_TAG.govulncheck.json headlamp-$UPSTREAM_TAG.npm-audit.json headlamp-pin.txt headlamp-otel.env headlamp-no-tracking.env vuln-ignore"
RELEASE_EXECUTABLES="headlamp-linux-amd64 headlamp-linux-arm64 headlamp-darwin-arm64 headlamp-darwin-amd64"
RELEASE_NOTE='Embedded in-cluster server and frontend. Analytics, plugins, metrics and tracing are off; OCI image digest is recorded in headlamp-image-digest.txt.'
RELEASE_GATES="pinned tag/commit/toolchains, no Go module overrides, govulncheck reachable=fail, frontend npm high/critical reachable=fail, CycloneDX SBOM, runtime no-egress, OCI digest signature."
