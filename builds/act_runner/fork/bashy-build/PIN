# bashy verified build declaration for act_runner (builds/README.md).
# Shell-sourceable KEY=VALUE only. builds/render.sh renders ../fork from this
# file + files/ + builds/_shared, and ships it verbatim as the fork's
# bashy-build/PIN. The workflow refuses to build unless the checked-out
# upstream tag resolves to UPSTREAM_COMMIT and the bashy tag is
# bashy-${UPSTREAM_TAG}-N.
#
# The pin is the release yoke runs today: external/actrunner. Upstream LICENSE
# at this tag: MIT.
TOOL=act_runner
FORK_REPO=qiangli/act_runner
# THE ONE NON-GITHUB UPSTREAM in builds/. act_runner's home is gitea.com, not
# GitHub, which is why yoke resolves it with a binmgr.URLSpec rather than a
# GitHubSpec. render.sh derives the forge from this URL: a non-github.com host
# makes the build clone the official tag with `git clone --depth 1 --branch`
# instead of actions/checkout, and the pin gate is unchanged either way.
#
# Upstream RENAMED the repository gitea/act_runner -> gitea/runner (the binary
# and the project are now "gitea-runner"); gitea.com 301-redirects the old
# path. The canonical name is pinned here so neither the clone nor the release
# API call depends on a redirect. The bashy tool keeps the name act_runner,
# which is what yoke's binmgr and the fork repository are called.
UPSTREAM_REPO=https://gitea.com/gitea/runner
UPSTREAM_SLUG=gitea/runner
# Not GitHub, so the pin job needs the forge's own REST root. Gitea serves the
# identical /repos/SLUG/releases/tags/TAG shape, with the same .draft and
# .prerelease fields the gate reads.
UPSTREAM_API_BASE=https://gitea.com/api/v1
# Latest stable upstream release (2026-10-08), neither draft nor pre-release.
UPSTREAM_TAG=v5.0.0
UPSTREAM_COMMIT=8b14a38d4ad6a1cb40dabb953a8a65656de70301
# Toolchain kind: build/audit job steps come from builds/_shared/kinds/go.
KIND=go
# Must equal the go/toolchain directive in the tag's go.mod (setup.yml gates
# it): v5.0.0's go.mod says `go 1.27` with `toolchain go1.27.1`.
GO_TOOLCHAIN=1.27.1
# Recorded security override, toolchain half. go1.27.1 carries 10 REACHABLE
# stdlib vulnerabilities (GO-2026-6603/6605/6607..6613/6617), all fixed in
# go1.27.2. Reachable findings are never waived, and no later upstream tag
# exists yet, so the build and the audit both run on the newest patch of the
# tag's own Go minor. Retires itself when an upstream tag ships on go1.27.2+.
GO_TOOLCHAIN_SECURITY_OVERRIDE=1.27.2
# No module overrides are needed at this pin: under go1.27.2 govulncheck
# reports no reachable vulnerability in any dependency.
GO_SECURITY_OVERRIDES=""
GOVULNCHECK_VERSION=v1.9.0
GO_SBOM_VERSION=v1.12.0
# main.go is at the repository root (module gitea.com/gitea/runner).
GO_PACKAGE=.
# Upstream's release ldflags (.goreleaser.yaml `builds[].ldflags`), minus the
# `-s -w` the shared build already applies, and with the pinned tag in place of
# goreleaser's `{{ .Summary }}` (a `git describe`), so the stamp stays
# reproducible. Upstream's Makefile stamps the same variable.
GO_LDFLAGS="-X gitea.com/gitea/runner/internal/pkg/ver.version=$UPSTREAM_TAG"
# Upstream's goreleaser build declares no tags and only -trimpath, which the
# shared go build already passes.
GO_BUILD_TAGS=""
GO_BUILD_FLAGS=""
GO_BUILD_ENV=""
GO_VERSION_ARG=--version
COSIGN_VERSION=v3.1.3
# Build matrix: ASSET=RUNNER; each leg uploads out/ASSET. Free standard runners.
MATRIX="act_runner-linux-amd64=ubuntu-24.04 act_runner-linux-arm64=ubuntu-24.04-arm act_runner-darwin-arm64=macos-15 act_runner-darwin-amd64=macos-15-intel"
# CGO per asset, as the UPSTREAM release does: .goreleaser.yaml sets
# CGO_ENABLED=0 for every goos/goarch it publishes, darwin included.
GO_CGO="act_runner-linux-amd64=0 act_runner-linux-arm64=0 act_runner-darwin-arm64=0 act_runner-darwin-amd64=0"
APT_PACKAGES="strace util-linux iproute2 curl"
PRE_BUILD_GATES=""
# Shared helper scripts copied from builds/_shared into bashy-build/.
SHARED_FILES="egress-verdict.sh"
# Argument of bashy-build/no-egress-test.sh (a GitHub expression is allowed).
EGRESS_TARGET='out/${{ matrix.asset }}'
# Release: SRC=ASSET copies from bashy-build/, the assets that must exist,
# the ones that are executables, and the release-notes lines.
RELEASE_EXTRA="PIN=act_runner-pin.txt config.yaml=act_runner-bashy.yaml otel.env=act_runner-otel.env no-tracking.env=act_runner-no-tracking.env vuln-ignore=vuln-ignore"
RELEASE_ASSETS="act_runner-linux-amd64 act_runner-linux-arm64 act_runner-darwin-arm64 act_runner-darwin-amd64 act_runner-$UPSTREAM_TAG.cdx.json act_runner-$UPSTREAM_TAG.govulncheck.json act_runner-pin.txt act_runner-bashy.yaml act_runner-otel.env act_runner-no-tracking.env vuln-ignore"
RELEASE_EXECUTABLES="act_runner-linux-amd64 act_runner-linux-arm64 act_runner-darwin-arm64 act_runner-darwin-amd64"
RELEASE_NOTE="No update check and no usage reporting. cache.host is pinned to 127.0.0.1 in the shipped config, because leaving it empty makes the cache server probe its own address by dialling 8.8.8.8:80; the only OTLP destination is bashy's local collector 127.0.0.1:31415."
RELEASE_GATES="pinned commit (cloned from gitea.com at the pinned tag), pinned Go toolchain (recorded security override go1.27.2), govulncheck (reachable, unwaived = fail), CycloneDX SBOM, no-egress."
