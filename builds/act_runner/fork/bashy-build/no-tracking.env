# No-tracking environment for a bashy-run act_runner (shell-sourceable).
#
# act_runner has no usage reporting and no update check of its own: everything
# it talks to is configured (the Gitea instance it registers with, the Docker
# daemon it runs jobs on). Its one UNCONFIGURED outbound call is the cache
# server's address probe, and that is governed by a config key rather than an
# environment variable — see cache.host in ../README.md and config.yaml.
#
# Usage: set -a; . bashy-build/no-tracking.env; set +a

# No inherited proxy may carry runner traffic off this host.
HTTP_PROXY=
HTTPS_PROXY=
ALL_PROXY=
http_proxy=
https_proxy=
all_proxy=
NO_PROXY=127.0.0.1,::1,localhost
no_proxy=127.0.0.1,::1,localhost

# Go's own telemetry (the toolchain's, not act_runner's) stays local.
GOTELEMETRY=off
GOFLAGS=
