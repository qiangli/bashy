# bashy verified build declaration for victoria-logs (builds/README.md).
# Shell-sourceable KEY=VALUE only. builds/render.sh renders ../fork from this
# file + files/ + builds/_shared, and ships it verbatim as the fork's
# bashy-build/PIN. The workflow refuses to build unless the checked-out
# upstream tag resolves to UPSTREAM_COMMIT and the bashy tag is
# bashy-${UPSTREAM_TAG}-N.
#
# Upstream LICENSE at this tag: Apache-2.0 (checked at the tag, not HEAD).
# This pin is AHEAD of yoke: external/otel/stack/execstore.go victoriaLogsVersion
# still names v1.51.0. It was bumped to clear every REACHABLE govulncheck
# finding on the fork CI; yoke's flip to this release is its own story,
# after the fork CI is green and the bashy tag is cut.
TOOL=victoria-logs
FORK_REPO=qiangli/victoria-logs
UPSTREAM_REPO=https://github.com/VictoriaMetrics/VictoriaLogs
UPSTREAM_SLUG=VictoriaMetrics/VictoriaLogs
UPSTREAM_TAG=v1.53.0
# Annotated tag object cccc0afb52cb5799c27800ff00e1807be2d8fe1e -> this commit.
UPSTREAM_COMMIT=915d91904bf7f5be66ab00f88947ae7fc1431acc
# Toolchain kind: build/audit job steps come from builds/_shared/kinds/go.
KIND=go
WINDOWS_SHELL=bash
# Must equal the go/toolchain directive in the tag's go.mod (setup.yml gates it).
GO_TOOLCHAIN=1.27.1
# Recorded security override (builds/README.md): the tag's go.mod names
# go1.27.1, which predates the 2026-10-08 Go stdlib batch (GO-2026-6603,
# 6605, 6607, 6608, 6609, 6610, 6611, 6612, 6613, 6617 — 10 of them
# REACHABLE from called code), fixed in go1.27.2 and go1.26.9. go1.27.2 is
# the newest patch of the upstream minor; nothing is waived.
GO_TOOLCHAIN_SECURITY_OVERRIDE=1.27.2
GOVULNCHECK_VERSION=v1.9.0
GO_SBOM_VERSION=v1.12.0
GO_PACKAGE=./app/victoria-logs
# Version stamp only — upstream's own -ldflags also embed a build DATE and a
# `git describe`, which is exactly what a reproducible build must not do.
GO_LDFLAGS="-X github.com/VictoriaMetrics/VictoriaMetrics/lib/buildinfo.Version=victoria-logs-$UPSTREAM_TAG"
GO_BUILD_TAGS=""
GO_BUILD_FLAGS=""
GO_BUILD_ENV=""
GO_VERSION_ARG=-version
COSIGN_VERSION=v3.1.3
# Build matrix: ASSET=RUNNER; each leg uploads out/ASSET.
MATRIX="victoria-logs-linux-amd64=ubuntu-24.04 victoria-logs-linux-arm64=ubuntu-24.04-arm victoria-logs-darwin-arm64=macos-15 victoria-logs-darwin-amd64=macos-15-intel victoria-logs-windows-amd64.exe=windows-2025"
# CGO per asset, as the UPSTREAM release does: deployment/docker/Makefile
# app-via-docker-linux-{amd64,arm64} set CGO_ENABLED=1, the darwin and Windows legs set 0.
GO_CGO="victoria-logs-linux-amd64=1 victoria-logs-linux-arm64=1 victoria-logs-darwin-arm64=0 victoria-logs-darwin-amd64=0 victoria-logs-windows-amd64.exe=0"
APT_PACKAGES="build-essential strace util-linux iproute2 curl"
PRE_BUILD_GATES=""
# Shared helper scripts copied from builds/_shared into bashy-build/.
SHARED_FILES="egress-verdict.sh windows-defender-egress.ps1 go-windows-egress.sh go-service-exercise.py"
# Argument of bashy-build/no-egress-test.sh (a GitHub expression is allowed).
EGRESS_TARGET='out/${{ matrix.asset }}'
# Release: SRC=ASSET copies from bashy-build/, the assets that must exist,
# the ones that are executables, and the release-notes lines.
RELEASE_EXTRA="PIN=victoria-logs-pin.txt otel.env=victoria-logs-otel.env no-tracking.env=victoria-logs-no-tracking.env vuln-ignore=vuln-ignore"
RELEASE_ASSETS="victoria-logs-linux-amd64 victoria-logs-linux-arm64 victoria-logs-darwin-arm64 victoria-logs-darwin-amd64 victoria-logs-$UPSTREAM_TAG.cdx.json victoria-logs-$UPSTREAM_TAG.govulncheck.json victoria-logs-pin.txt victoria-logs-otel.env victoria-logs-no-tracking.env vuln-ignore victoria-logs-windows-amd64.exe"
RELEASE_EXECUTABLES="victoria-logs-linux-amd64 victoria-logs-linux-arm64 victoria-logs-darwin-arm64 victoria-logs-darwin-amd64 victoria-logs-windows-amd64.exe"
RELEASE_NOTE="No update check, no usage reporting and no remote write: -pushmetrics.url is never passed and the HTTP server is bound to loopback."
RELEASE_GATES="pinned commit, pinned Go toolchain (recorded security override: built with Go 1.27.2, not the tag's go.mod Go $GO_TOOLCHAIN), govulncheck (reachable, unwaived = fail), CycloneDX SBOM, no-egress."
