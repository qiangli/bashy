# bashy verified build declaration for runc (builds/README.md).
# Shell-sourceable KEY=VALUE only. builds/render.sh renders ../fork from this
# file + files/ + build.yml + audit.yml + builds/_shared, and ships it verbatim
# as the fork's bashy-build/PIN. The workflow refuses to build unless the
# checked-out upstream tag resolves to UPSTREAM_COMMIT and the bashy tag is
# bashy-${UPSTREAM_TAG}-N.
#
# The OCI runtime the outpost runtime image's containerd shim execs. The one
# cgo build in the image: runc's nsenter (and its userns helper) are C, linked
# statically against musl. Built WITHOUT the seccomp tag: libseccomp is LGPL,
# so neither it nor libseccomp-golang is linked.
# Upstream LICENSE at this tag: Apache-2.0.
TOOL=runc
FORK_REPO=qiangli/runc
UPSTREAM_REPO=https://github.com/opencontainers/runc
UPSTREAM_SLUG=opencontainers/runc
UPSTREAM_TAG=v1.4.2
# Annotated tag c909e4c214d9bb87351dc4fbecc2880a8ca7ff2c -> this commit.
UPSTREAM_COMMIT=c241c0bb5e60a8e8c1b2e53d4eca8d0068d8d57e
# Toolchain kind: setup comes from builds/_shared/kinds/go; build.yml and
# audit.yml are runc's own (static musl cgo, -mod=mod, see README.md).
KIND=go
# Must equal the go directive in the tag's go.mod (setup.yml gates it).
GO_TOOLCHAIN=1.24.0
# EOL-minor security override: go1.24 gets no security fixes, so the build
# moves to the oldest supported minor's latest patch.
GO_TOOLCHAIN_SECURITY_OVERRIDE=1.26.9
# Reachable at the tag under go1.26.9: GO-2026-6238 (cilium/ebpf v0.17.3, BTF
# parsing), reached through opencontainers/cgroups v0.0.6's devices
# haveBpfProgReplace. cilium/ebpf's fix (v0.22.0) breaks every released
# cgroups' API use; cgroups v0.1.0 (what runc v1.5.x requires) no longer
# reaches it. One require line moves, within its major, nothing is added and
# the go directive stays; govulncheck of the shipped package is then clean.
GO_SECURITY_OVERRIDES="github.com/opencontainers/cgroups@v0.1.0"
GOVULNCHECK_VERSION=v1.9.0
GO_SBOM_VERSION=v1.12.0
GO_PACKAGE=.
# Upstream Makefile LDFLAGS_COMMON: main.gitCommit (upstream: `git describe`).
# The version itself is the tag's VERSION file, embedded by main.go.
GO_LDFLAGS="-X main.gitCommit=$UPSTREAM_COMMIT"
# Upstream `make static` tags (BUILDTAGS + netgo osusergo) minus seccomp.
GO_BUILD_TAGS="urfave_cli_no_docs,netgo,osusergo"
GO_AUDIT_TAGS="urfave_cli_no_docs,netgo,osusergo"
GO_BUILD_FLAGS=""
GO_BUILD_ENV=""
GO_VERSION_ARG=--version
COSIGN_VERSION=v3.1.3
# Build matrix: ASSET=RUNNER; each leg uploads out/ASSET.
MATRIX="runc-linux-amd64=ubuntu-24.04 runc-linux-arm64=ubuntu-24.04-arm"
# CGO per asset: nsenter is C (upstream `make static` builds with cgo too).
GO_CGO="runc-linux-amd64=1 runc-linux-arm64=1"
# musl-tools: musl-gcc for the static cgo link (musl is MIT; a static glibc
# link would not be a permissive artifact). linux-libc-dev: the kernel UAPI
# headers nsenter includes.
APT_PACKAGES="strace util-linux iproute2 musl-tools linux-libc-dev"
PRE_BUILD_GATES=""
SHARED_FILES="egress-verdict.sh"
# Argument of bashy-build/no-egress-test.sh (a GitHub expression is allowed).
EGRESS_TARGET='out/${{ matrix.asset }}'
# Release: SRC=ASSET copies from bashy-build/, the assets that must exist,
# the ones that are executables, and the release-notes lines.
RELEASE_EXTRA="PIN=runc-pin.txt otel.env=runc-otel.env no-tracking.env=runc-no-tracking.env vuln-ignore=vuln-ignore"
RELEASE_ASSETS="runc-linux-amd64 runc-linux-arm64 runc-$UPSTREAM_TAG.cdx.json runc-$UPSTREAM_TAG.govulncheck.json runc-pin.txt runc-otel.env runc-no-tracking.env vuln-ignore"
RELEASE_EXECUTABLES="runc-linux-amd64 runc-linux-arm64"
RELEASE_NOTE="Static runc, cgo linked against musl for nsenter only. Built without the seccomp tag, so libseccomp (LGPL) is not linked and seccomp profiles are not enforced by this runc. It makes no network connection."
RELEASE_GATES="pinned commit, pinned Go toolchain (EOL-minor security override: built with go1.26.9, not the tag's end-of-life go1.24.0), reviewed GO_SECURITY_OVERRIDES module bump (opencontainers/cgroups v0.1.0), static musl link (no ELF interpreter), no seccomp tag and no libseccomp-golang linked, govulncheck of the shipped package (reachable, unwaived = fail), CycloneDX SBOM, no-egress (including a container run)."
