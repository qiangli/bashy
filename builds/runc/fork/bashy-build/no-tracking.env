# NO-TRACKING environment for the bashy runc verified build.
# Shell-sourceable; shipped as a release asset so a launcher applies exactly
# what this build was gated against. See builds/runc/README.md.
#
# Usage: set -a; . bashy-build/no-tracking.env; set +a
#
# runc has NO update checker and NO usage reporting, and makes no network
# call of its own: it sets up namespaces, cgroups and mounts through syscalls
# and netlink, then execs the container process.
#
# Clearing the proxy environment keeps an operator shell's proxy from leaking
# into what runc execs; only loopback is allowed in NO_PROXY.
HTTP_PROXY=
HTTPS_PROXY=
http_proxy=
https_proxy=
ALL_PROXY=
all_proxy=
NO_PROXY=127.0.0.1,::1,localhost
no_proxy=127.0.0.1,::1,localhost
