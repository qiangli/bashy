RELEASE_ASSETS="runner-linux-amd64 runner-linux-amd64.gz runner-linux-amd64.json runner-linux-amd64.inputs.json runner-linux-amd64.deps.json runner-linux-arm64 runner-linux-arm64.gz runner-linux-arm64.json runner-linux-arm64.inputs.json runner-linux-arm64.deps.json runner-darwin-amd64 runner-darwin-amd64.gz runner-darwin-amd64.json runner-darwin-amd64.inputs.json runner-darwin-amd64.deps.json runner-darwin-arm64 runner-darwin-arm64.gz runner-darwin-arm64.json runner-darwin-arm64.inputs.json runner-darwin-arm64.deps.json runner-windows-amd64.exe runner-windows-amd64.gz runner-windows-amd64.json runner-windows-amd64.inputs.json runner-windows-amd64.deps.json runner-pin.txt runner-NOTICES.txt runner-sbom.cdx.json runner-vulnerabilities.json runner-licenses.json runner-fixture.json runner-fixture-LICENSE.txt runner-linux-amd64-native.json runner-linux-amd64-native.log runner-linux-amd64-egress.txt runner-linux-arm64-native.json runner-linux-arm64-native.log runner-linux-arm64-egress.txt runner-darwin-amd64-native.json runner-darwin-amd64-native.log runner-darwin-amd64-egress.txt runner-darwin-arm64-native.json runner-darwin-arm64-native.log runner-darwin-arm64-egress.txt runner-windows-amd64-native.json runner-windows-amd64-native.log runner-windows-amd64-egress.txt"
RELEASE_NOTE="Official unpatched cmd/runner; CPU baseline and Darwin arm64 built-in Metal. Separate from Yoke server fork. No bundled CUDA/ROCm/Vulkan/MLX shared libraries."
