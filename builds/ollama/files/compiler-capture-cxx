#!/usr/bin/env python3
"""Record cgo compiler invocations and preserve their dependency files."""
import json
import os
from pathlib import Path
import subprocess
import shutil
import sys
import uuid
import importlib.util
spec = importlib.util.spec_from_file_location("evidence", Path(__file__).with_name("compiler-evidence.py"))
evidence = importlib.util.module_from_spec(spec)
spec.loader.exec_module(evidence)

kind = Path(sys.argv[0]).name
compiler = os.environ.get("BASHY_REAL_CXX" if "cxx" in kind else "BASHY_REAL_CC")
root = Path(os.environ["BASHY_COMPILER_CAPTURE_DIR"])
args = sys.argv[1:]
if not compiler:
    sys.exit("compiler-capture: selected compiler is unset")
compiler = shutil.which(compiler)
if not compiler:
    sys.exit("compiler-capture: compiler not found")
root.mkdir(parents=True, exist_ok=True)
source_exts = (".c", ".cc", ".cpp", ".cxx", ".m", ".mm", ".h", ".hh", ".hpp", ".hxx")
is_native = any(Path(arg).suffix.lower() in source_exts for arg in args)
run_args = list(args)
depfile = None
if is_native:
    depdir = root / "depfiles"
    depdir.mkdir(parents=True, exist_ok=True)
    depfile = depdir / (uuid.uuid4().hex + ".d")
    # Last occurrence wins for GCC and Clang. Preserve every original argument
    # and append private depfile options so output/object semantics stay intact.
    run_args += ["-MMD", "-MF", str(depfile)]
record = {"compiler": compiler, "argv": args, "captured": is_native,
          "depfile": str(depfile) if depfile else None, "cwd": str(Path.cwd()), "executed_argv": run_args,
          "roots": {key: str(Path(os.environ[key]).resolve()) for key in ("BASHY_COMPILER_SOURCE", "BASHY_COMPILER_GOROOT", "BASHY_COMPILER_TMP", "BASHY_MINGW_ROOT") if key in os.environ}}
result = subprocess.run([compiler, *run_args])
record["returncode"] = result.returncode
try:
    if result.returncode == 0 and depfile is not None:
        store = root / "content"
        store.mkdir(exist_ok=True)
        record["inputs"] = evidence.snapshot(depfile, store)
except (OSError, ValueError) as exc:
    record["error"] = str(exc)
    result.returncode = 1
finally:
    # One record per invocation: append-to-one-file is not atomic on all hosts.
    records = root / "invocations"
    records.mkdir(exist_ok=True)
    (records / (uuid.uuid4().hex + ".json")).write_text(json.dumps(record, sort_keys=True) + "\n")
if record.get("error"):
    sys.exit("compiler-capture: " + record["error"])
sys.exit(result.returncode)
