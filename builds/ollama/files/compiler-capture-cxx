#!/usr/bin/env python3
"""Record cgo compiler invocations and preserve their dependency files."""
import json
import os
from pathlib import Path
import subprocess
import sys
import uuid

kind = Path(sys.argv[0]).name
compiler = os.environ.get("BASHY_REAL_CXX" if "cxx" in kind else "BASHY_REAL_CC")
root = Path(os.environ["BASHY_COMPILER_CAPTURE_DIR"])
args = sys.argv[1:]
if not compiler:
    sys.exit("compiler-capture: selected compiler is unset")
root.mkdir(parents=True, exist_ok=True)
is_compile = "-c" in args
source_exts = (".c", ".cc", ".cpp", ".cxx", ".m", ".mm")
is_native = is_compile and any(Path(arg).suffix.lower() in source_exts for arg in args)
run_args = list(args)
depfile = None
if is_native:
    depdir = root / "depfiles"
    depdir.mkdir(parents=True, exist_ok=True)
    depfile = depdir / (uuid.uuid4().hex + ".d")
    # Last occurrence wins for GCC and Clang. Preserve every original argument
    # and append private depfile options so output/object semantics stay intact.
    run_args += ["-MMD", "-MF", str(depfile)]
record = {"compiler": compiler, "argv": args, "captured": is_native,
          "depfile": str(depfile) if depfile else None}
fd = os.open(root / "invocations.jsonl", os.O_WRONLY | os.O_CREAT | os.O_APPEND, 0o600)
try:
    os.write(fd, (json.dumps(record, sort_keys=True) + "\n").encode())
finally:
    os.close(fd)
result = subprocess.run([compiler, *run_args])
if result.returncode == 0 and depfile is not None and not depfile.is_file():
    sys.exit("compiler-capture: compiler succeeded without producing its unique dependency file")
sys.exit(result.returncode)
