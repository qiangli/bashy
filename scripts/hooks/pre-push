#!/bin/sh
# pre-push — two gates: gofmt, then the standalone module graph.
#
# fmtcheck runs first and costs ~0.04s, so the cheap gate reports before the
# module walk starts. It is not inlined: scripts/fmtcheck.sh is the SAME script
# CI and `bashy dag fmtcheck` run, so the three can never check different
# things. It REPORTS and never rewrites — gofmt changes doc-comment text as
# well as whitespace, so the fix is a decision, not an automation. Read that
# script's header before making it auto-fix.
#
# Siblings are pinned in go.mod (requires at pseudo-versions, versioned fork
# replaces). Inside the dhnt umbrella the go.work builds the live sibling
# trees, so a LOCAL BUILD CANNOT CATCH code that needs a newer sibling than
# go.mod pins; CI (no workspace) would fail ~10 minutes later. Resolving the
# graph with GOWORK=off is the honest push-time check: it builds what CI
# builds. `bashy mod drift` shows which pins trail their sibling HEADs and
# `bashy mod sync` moves them.
#
# Install once per clone (`make hooks`):
#   git config core.hooksPath scripts/hooks
# Bypass in an emergency with: git push --no-verify
set -eu

cd "$(git rev-parse --show-toplevel)"

./scripts/fmtcheck.sh

# go.sum must cover every tag the build matrix uses: a hash needed only under
# bashy_engines once went missing and failed `make test` minutes in. `go list
# -deps` reports a missing hash in ~0.4 s without compiling. GOWORK=off makes
# it resolve the pinned module graph CI builds, not the live workspace.
for tags in '' 'bashy_engines bashy_obs'; do
	GOWORK=off go list -deps -tags "$tags" ./cmd/bashy >/dev/null
done
